{
  "configVersion": "v3",
  "app": {
    "appType": "app",
    "appId": 20001,
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "appName": "DayOne Orbit",
    "description": "DayOne Orbit Sync App",
    "icon": "icon.png",
    "vender": "DayOne"
  },
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
      "target": "3.0.0",
      "minVersion": "3.0"
    }
  },
  "defaultLanguage": "en-US",
  "i18n": {
    "en-US": {
      "name": "DayOne Orbit"
    }
  },
  "targets": {
    "common": {
      "module": {
        "page": {
          "pages": [
            "page/index"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        },
        {
          "st": "s",
          "dw": 390
        },
        {
          "st": "b",
          "dw": 194
        }
      ]
    }
  },
  "permissions": [
    "device:os.network",
    "device:os.bg_service",
    "device:os.alarm",
    "data:user.hd.step",
    "data:user.hd.sleep",
    "data:user.hd.heart_rate",
    "data:user.hd.spo2",
    "data:user.hd.stress",
    "data:user.hd.pai"
  ]
}
