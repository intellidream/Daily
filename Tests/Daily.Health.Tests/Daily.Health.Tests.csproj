<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="sqlite-net-base" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Supabase" Version="1.1.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Models\Health\*.cs" Link="Models\%(Filename)%(Extension)" />
    <Compile Include="..\..\Models\UserPreferences.cs" Link="Models\%(Filename)%(Extension)" />
    <Compile Include="..\..\Services\Health\IHealthService.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\Services\IDatabaseService.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\Services\ISettingsService.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\WinUI\Daily.WinUI\Services\IHealthHubService.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\WinUI\Daily.WinUI\Services\HealthHubService.cs" Link="Services\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
