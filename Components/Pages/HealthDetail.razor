    private string FormatSeconds(double s)
    {
        if (s <= 0) return "--";
        var ts = TimeSpan.FromSeconds(s);
        return $"{(int)ts.TotalHours}h {ts.Minutes}m";
    }

    private string FormatMinutes(double m)
    {
        if (m <= 0) return "--";
