@code {
    private List<VitalMetric> _metrics = new();
    private List<HealthTelemetry> _telemetry = new();
    private List<HealthTelemetry> _sleepTimelineEntries = new();

    private string _dominantSource = "Mixed";
    private string _sourceTooltip = "Source: Multiple";
    private string _syncedAgoText = "";
    private bool _isSyncing = false;
    private string _debugLog = "";

    // 7-Day Trend Chart State
    private string _selectedTrend = "Steps";
    private List<double> _stepsHistory = new();
    private List<double> _calHistory = new();
    private List<double> _sleepHistory = new();
    private List<double> _hrHistory = new();
    private List<double> _spo2History = new();
    private List<double> _hrvHistory = new();
    private List<double> _bpHistory = new();

    // Sleep Architecture State
    private int _sleepScore = 0;
    private int _sleepEfficiency = 0;
    private int _restorativePercent = 0;
    private string _timeAsleepFormatted = "--";
    private string _timeInBedFormatted = "--";
    private string _deepDurationFormatted = "--";
    private string _remDurationFormatted = "--";
    private string _lightDurationFormatted = "--";
    private string _awakeDurationFormatted = "--";
    private int _deepPercent = 0;
    private int _remPercent = 0;
    private int _lightPercent = 0;
    private int _awakePercent = 0;
    private int _awakeCount = 0;
    private DateTime _sleepMinTime = DateTime.MinValue;
    private DateTime _sleepMaxTime = DateTime.MinValue;
    private List<(double LeftPct, string Label)> _hourlyTicks = new();

    // Intraday Sensors State
    private double _avgIntradayHr = 0;
    private List<ChartSeries<double>> _hrChartSeries = new();
    private string[] _hrChartLabels = Array.Empty<string>();
    private ChartOptions _chartOptionsHr = new() { ChartPalette = new[] { "#F44336" } };

    private int _hrRestingPct = 70;
    private int _hrFatBurnPct = 20;
    private int _hrCardioPct = 8;
    private int _hrPeakPct = 2;
    private int _stressScore = 28;
    private int _paiScore = 82;
    private int _activeHoursCount = 0;

    private List<ChartSeries<double>> _stepsChartSeries = new();
    private string[] _stepsChartLabels = Array.Empty<string>();
    private ChartOptions _chartOptionsSteps = new() { ChartPalette = new[] { "var(--mud-palette-primary)" } };

    protected override async Task OnInitializedAsync()
    {
        HealthService.OnViewTypeChanged += OnViewTypeChangedHandler;
        RefreshService.RefreshRequested += LoadDataInternal;
        RefreshService.HealthRefreshRequested += LoadDataInternal;

        _debugLog = SyncService.DebugLog;
        SyncService.OnDebugLogUpdated += UpdateLog;

        await LoadDataInternal();
    }

    private void OnViewTypeChangedHandler()
    {
        InvokeAsync(StateHasChanged);
    }

    private void SetTab(string tabName)
    {
        HealthService.CurrentViewType = tabName;
        StateHasChanged();
    }

    private void UpdateLog()
    {
        InvokeAsync(() =>
        {
            _debugLog = SyncService.DebugLog;
            StateHasChanged();
        });
    }

    private void ClearDebugLog()
    {
        _debugLog = "";
        StateHasChanged();
    }

    private async Task ManualSync()
    {
        if (_isSyncing) return;
        _isSyncing = true;
        StateHasChanged();

        try
        {
            await HealthService.SyncNativeHealthDataAsync();
            await LoadDataInternal();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Manual Sync Failed: {ex}");
        }
        finally
        {
            _isSyncing = false;
            StateHasChanged();
        }
    }

    private async Task LoadDataInternal() => await LoadData();

    private async Task LoadData()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                _metrics = await HealthService.FetchMetricsAsync(DateTime.Now);

                CalculateDominantSource(_metrics);
                CalculateSyncedAgo(_metrics);

                // Fetch high-frequency wearable telemetry for sleep and intraday sensors
                var yesterdayEvening = DateTime.Today.AddDays(-1).AddHours(18);
                var endOfToday = DateTime.Today.AddDays(1).AddTicks(-1);
                _telemetry = await HealthService.GetHealthTelemetryAsync(yesterdayEvening, endOfToday);

                ProcessSleepTelemetry();
                ProcessSensorTelemetry();

                StateHasChanged();
            });

            _ = Task.Run(async () =>
            {
                try { await LoadTrendHistory(); }
                catch (Exception tex) { Console.WriteLine($"Trend history error: {tex.Message}"); }
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading health detail: {ex}");
        }
    }

    private void ProcessSleepTelemetry()
    {
        _sleepTimelineEntries = _telemetry
            .Where(x => x.IsSleep)
            .OrderBy(x => x.LocalStartTime)
            .ToList();

        if (_sleepTimelineEntries.Any())
        {
            _sleepMinTime = _sleepTimelineEntries.Min(x => x.LocalStartTime);
            _sleepMaxTime = _sleepTimelineEntries.Max(x => x.LocalEndTime);

            // Compute Hourly Ticks
            _hourlyTicks.Clear();
            var startHour = new DateTime(_sleepMinTime.Year, _sleepMinTime.Month, _sleepMinTime.Day, _sleepMinTime.Hour, 0, 0);
            var endHour = _sleepMaxTime.AddHours(1);
            var totalDuration = (_sleepMaxTime - _sleepMinTime).TotalSeconds;

            if (totalDuration > 0)
            {
                var cur = startHour;
                while (cur <= endHour)
                {
                    if (cur >= _sleepMinTime && cur <= _sleepMaxTime)
                    {
                        var left = ((cur - _sleepMinTime).TotalSeconds / totalDuration) * 100.0;
                        _hourlyTicks.Add((left, cur.ToString("HH:mm")));
                    }
                    cur = cur.AddHours(1);
                }
            }

            var deepSeconds = _sleepTimelineEntries.Where(x => x.SleepCategory == "Deep").Sum(x => x.DurationSeconds);
            var remSeconds = _sleepTimelineEntries.Where(x => x.SleepCategory == "REM").Sum(x => x.DurationSeconds);
            var lightSeconds = _sleepTimelineEntries.Where(x => x.SleepCategory == "Core").Sum(x => x.DurationSeconds);
            var awakeSeconds = _sleepTimelineEntries.Where(x => x.SleepCategory == "Awake").Sum(x => x.DurationSeconds);
            var asleepSeconds = deepSeconds + remSeconds + lightSeconds;
            var inBedSeconds = Math.Max(asleepSeconds + awakeSeconds, (totalDuration > 0 ? totalDuration : asleepSeconds));

            _timeAsleepFormatted = FormatSeconds(asleepSeconds);
            _timeInBedFormatted = FormatSeconds(inBedSeconds);
            _deepDurationFormatted = FormatSeconds(deepSeconds);
            _remDurationFormatted = FormatSeconds(remSeconds);
            _lightDurationFormatted = FormatSeconds(lightSeconds);
            _awakeDurationFormatted = FormatSeconds(awakeSeconds);

            _awakeCount = _sleepTimelineEntries.Count(x => x.SleepCategory == "Awake");

            if (asleepSeconds > 0)
            {
                _deepPercent = (int)((deepSeconds / asleepSeconds) * 100);
                _remPercent = (int)((remSeconds / asleepSeconds) * 100);
                _lightPercent = (int)((lightSeconds / asleepSeconds) * 100);
                _restorativePercent = _deepPercent + _remPercent;
            }

            if (inBedSeconds > 0)
            {
                _awakePercent = (int)((awakeSeconds / inBedSeconds) * 100);
                _sleepEfficiency = Math.Min((int)((asleepSeconds / inBedSeconds) * 100), 100);
            }
            else
            {
                _sleepEfficiency = 90;
            }

            // Sleep Score Model: Target 8 hours + Efficiency + Deep/REM balance
            double durationScore = Math.Min((asleepSeconds / (8.0 * 3600.0)) * 50.0, 50.0);
            double efficiencyScore = (_sleepEfficiency / 100.0) * 30.0;
            double qualityScore = Math.Min((_restorativePercent / 40.0) * 20.0, 20.0);
            _sleepScore = Math.Clamp((int)(durationScore + efficiencyScore + qualityScore), 0, 100);
        }
        else
        {
            // Fallback from aggregated Vitals
            var dM = GetMetric(VitalType.SleepDeep)?.Value ?? 0;
            var rM = GetMetric(VitalType.SleepREM)?.Value ?? 0;
            var lM = GetMetric(VitalType.SleepLight)?.Value ?? 0;
            var aM = GetMetric(VitalType.SleepAwake)?.Value ?? 0;
            var totalM = dM + rM + lM;
            var inBedM = totalM + aM;

            _timeAsleepFormatted = totalM > 0 ? FormatMinutes(totalM) : "--";
            _timeInBedFormatted = inBedM > 0 ? FormatMinutes(inBedM) : "--";
            _deepDurationFormatted = FormatMinutes(dM);
            _remDurationFormatted = FormatMinutes(rM);
            _lightDurationFormatted = FormatMinutes(lM);
            _awakeDurationFormatted = FormatMinutes(aM);

            if (totalM > 0)
            {
                _deepPercent = (int)((dM / totalM) * 100);
                _remPercent = (int)((rM / totalM) * 100);
                _lightPercent = (int)((lM / totalM) * 100);
                _restorativePercent = _deepPercent + _remPercent;
            }
            if (inBedM > 0)
            {
                _awakePercent = (int)((aM / inBedM) * 100);
                _sleepEfficiency = (int)((totalM / inBedM) * 100);
            }
            _sleepScore = totalM > 0 ? Math.Clamp((int)((totalM / 480.0) * 85.0 + 10), 40, 95) : 0;
        }
    }

    private void ProcessSensorTelemetry()
    {
        var today = DateTime.Today;

        // Process HR
        var hrData = _telemetry
            .Where(x => x.IsHeartRate && x.LocalStartTime >= today && x.Value.HasValue)
            .OrderBy(x => x.LocalStartTime)
            .ToList();

        if (hrData.Any())
        {
            _avgIntradayHr = Math.Round(hrData.Average(x => x.Value!.Value), 0);
            var hourlyHr = hrData.GroupBy(x => x.LocalStartTime.Hour)
                                 .Select(g => new { Hour = g.Key, Avg = g.Average(x => x.Value!.Value) })
                                 .OrderBy(x => x.Hour)
                                 .ToList();

            _hrChartSeries = new List<ChartSeries<double>>
            {
                new ChartSeries<double> { Name = "Heart Rate", Data = hourlyHr.Select(x => Math.Round(x.Avg, 0)).ToArray() }
            };
            _hrChartLabels = hourlyHr.Select(x => $"{x.Hour}:00").ToArray();

            // Zones
            var totalSamples = hrData.Count;
            _hrRestingPct = (int)((hrData.Count(x => x.Value < 100) / (double)totalSamples) * 100);
            _hrFatBurnPct = (int)((hrData.Count(x => x.Value >= 100 && x.Value < 120) / (double)totalSamples) * 100);
            _hrCardioPct = (int)((hrData.Count(x => x.Value >= 120 && x.Value < 150) / (double)totalSamples) * 100);
            _hrPeakPct = Math.Max(0, 100 - (_hrRestingPct + _hrFatBurnPct + _hrCardioPct));
        }

        // Process Hourly Steps
        var stepsData = _telemetry
            .Where(x => x.IsSteps && x.LocalStartTime >= today && x.Value.HasValue)
            .OrderBy(x => x.LocalStartTime)
            .ToList();

        if (stepsData.Any())
        {
            var hourlySteps = stepsData.GroupBy(x => x.LocalStartTime.Hour)
                                       .Select(g => new { Hour = g.Key, Total = g.Sum(x => x.Value!.Value) })
                                       .OrderBy(x => x.Hour)
                                       .ToList();

            _activeHoursCount = hourlySteps.Count(x => x.Total >= 250);
            _stepsChartSeries = new List<ChartSeries<double>>
            {
                new ChartSeries<double> { Name = "Steps", Data = hourlySteps.Select(x => x.Total).ToArray() }
            };
            _stepsChartLabels = hourlySteps.Select(x => $"{x.Hour}:00").ToArray();
        }
    }

