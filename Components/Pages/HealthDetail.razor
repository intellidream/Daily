    private double GetStageLeft(HealthTelemetry stage)
    {
        if (!_sleepTimelineEntries.Any()) return 0;
        var total = (_sleepMaxTime - _sleepMinTime).TotalSeconds;
        if (total <= 0) return 0;
        var offset = (stage.LocalStartTime - _sleepMinTime).TotalSeconds;
        return Math.Max(0, Math.Min((offset / total) * 100.0, 100.0));
    }

    private double GetStageWidth(HealthTelemetry stage)
    {
        if (!_sleepTimelineEntries.Any()) return 0;
        var total = (_sleepMaxTime - _sleepMinTime).TotalSeconds;
        if (total <= 0) return 0;
        var duration = Math.Max((stage.LocalEndTime - stage.LocalStartTime).TotalSeconds, stage.DurationSeconds);
        return Math.Max((duration / total) * 100.0, 0.8);
    }

    private Color GetSleepScoreColor(int score)
    {
        if (score >= 85) return Color.Success;
        if (score >= 70) return Color.Info;
        if (score >= 50) return Color.Warning;
        return Color.Error;
    }

    private string GetSleepQualityLabel(int score)
    {
        if (score >= 90) return "Excellent Sleep";
        if (score >= 80) return "Good Sleep";
        if (score >= 70) return "Fair Sleep";
