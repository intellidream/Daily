        return $"{(int)ts.TotalHours}h {ts.Minutes}m";
    }

    private VitalMetric? GetMetric(VitalType type)
    {
        var m = _metrics.FirstOrDefault(x => x.TypeString == type.ToString());
        return m?.Value > 0 ? m : null;
    }

    private void CalculateDominantSource(List<VitalMetric> metrics)
    {
        var sourced = metrics.Where(m => !string.IsNullOrEmpty(m.SourceDevice)).ToList();
        if (!sourced.Any())
        {
            _dominantSource = "Mixed";
            _sourceTooltip = "Source: None";
            return;
        }

        int iosCount = sourced.Count(m => m.SourceDevice == "iOS");
        int androidCount = sourced.Count(m => m.SourceDevice == "Health Connect" || m.SourceDevice == "Android");
        int total = sourced.Count;

        if (total > 0 && (double)iosCount / total >= 0.70) _dominantSource = "iOS";
        else if (total > 0 && (double)androidCount / total >= 0.70) _dominantSource = "Health Connect";
        else _dominantSource = "Mixed";

        _sourceTooltip = $"iOS: {iosCount}, Android: {androidCount}";
    }

    private void CalculateSyncedAgo(List<VitalMetric> metrics)
    {
        var latestSync = metrics
            .Select(m => m.SyncedAt ?? (DateTime?)m.UpdatedAt)
            .Where(t => t.HasValue)
            .OrderByDescending(t => t!.Value)
            .FirstOrDefault();

        if (latestSync.HasValue)
        {
            var ago = DateTime.UtcNow - latestSync.Value;
            if (ago.TotalMinutes < 1) _syncedAgoText = "Synced just now";
            else if (ago.TotalMinutes < 60) _syncedAgoText = $"Synced {(int)ago.TotalMinutes}m ago";
            else if (ago.TotalHours < 24) _syncedAgoText = $"Synced {(int)ago.TotalHours}h ago";
            else _syncedAgoText = $"Synced {(int)ago.TotalDays}d ago";
        }
        else
        {
            _syncedAgoText = "";
        }
    }

    private async Task LoadTrendHistory()
    {
        try
        {
            var end = DateTime.Today;
            var start = end.AddDays(-6);
            var history = await HealthService.GetVitalsAsync(start, end);

            var sHist = new List<double>();
            var cHist = new List<double>();
            var slHist = new List<double>();
            var hrHist = new List<double>();
            var spo2Hist = new List<double>();
            var hrvHist = new List<double>();
            var bpHist = new List<double>();

            for (var day = start; day <= end; day = day.AddDays(1))
            {
                var dayMetrics = history.Where(m => m.Date.Date == day.Date).ToList();

                sHist.Add(dayMetrics.FirstOrDefault(m => m.TypeString == VitalType.Steps.ToString())?.Value ?? 0);
                cHist.Add(dayMetrics.FirstOrDefault(m => m.TypeString == VitalType.ActiveEnergy.ToString())?.Value ?? 0);
                slHist.Add(dayMetrics.FirstOrDefault(m => m.TypeString == VitalType.SleepDuration.ToString())?.Value ?? 0);
                hrHist.Add(dayMetrics.FirstOrDefault(m => m.TypeString == VitalType.HeartRate.ToString())?.Value ?? 0);
                spo2Hist.Add(dayMetrics.FirstOrDefault(m => m.TypeString == VitalType.OxygenSaturation.ToString())?.Value ?? 0);
                hrvHist.Add(dayMetrics.FirstOrDefault(m => m.TypeString == VitalType.HeartRateVariabilitySDNN.ToString())?.Value ?? 0);
                bpHist.Add(dayMetrics.FirstOrDefault(m => m.TypeString == VitalType.BloodPressureSystolic.ToString())?.Value ?? 0);
            }

            await InvokeAsync(() =>
            {
                _stepsHistory = sHist;
                _calHistory = cHist;
                _sleepHistory = slHist;
                _hrHistory = hrHist;
                _spo2History = spo2Hist;
                _hrvHistory = hrvHist;
                _bpHistory = bpHist;
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading trend history: {ex}");
        }
    }

