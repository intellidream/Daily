@page "/vitals"
@using Daily.Models.Health
@using Daily.Services.Health
@using Daily.Services
@using Daily.Components.Widgets
@using MudBlazor
@inject IHealthService HealthService
@inject IRefreshService RefreshService
@inject ISyncService SyncService
@inject IWindowManagerService WindowManager
@implements IDisposable

<div class="d-flex flex-column h-100 pb-4 gap-4">

    <!-- TOP BAR: Navigation Pills & Actions -->
    <div class="d-flex flex-wrap align-center justify-space-between gap-3 px-1">
        <!-- Segmented Tab Navigation -->
        <div class="d-flex align-center rounded-pill pa-1" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);">
            <button class="health-tab-pill @(HealthService.CurrentViewType == "Overview" ? "active" : "")" @onclick='() => SetTab("Overview")'>
                <MudIcon Icon="@Icons.Material.Filled.Favorite" Size="Size.Small" Class="mr-1" />
                Overview
            </button>
            <button class="health-tab-pill @(HealthService.CurrentViewType == "Sleep" ? "active" : "")" @onclick='() => SetTab("Sleep")'>
                <MudIcon Icon="@Icons.Material.Filled.Bedtime" Size="Size.Small" Class="mr-1" />
                Sleep
            </button>
            <button class="health-tab-pill @(HealthService.CurrentViewType == "Sensors" ? "active" : "")" @onclick='() => SetTab("Sensors")'>
                <MudIcon Icon="@Icons.Material.Filled.MonitorHeart" Size="Size.Small" Class="mr-1" />
                Sensors
            </button>
            <button class="health-tab-pill @(HealthService.CurrentViewType == "Nutrition" ? "active" : "")" @onclick='() => SetTab("Nutrition")'>
                <MudIcon Icon="@Icons.Material.Filled.Restaurant" Size="Size.Small" Class="mr-1" />
                Nutrition
            </button>
        </div>

        <!-- Sync & Source Info -->
        <div class="d-flex align-center gap-3">
            <div class="d-flex flex-column align-end">
                <div class="d-flex align-center gap-2">
                    <MudText Typo="Typo.caption" Style="opacity: 0.7;">Today</MudText>
                    <MudTooltip Text="@_sourceTooltip">
                        <div style="@GetSourceDotStyle(_dominantSource)"></div>
                    </MudTooltip>
                </div>
                @if (!string.IsNullOrEmpty(_syncedAgoText))
                {
                    <MudText Typo="Typo.caption" Style="opacity: 0.45; font-size: 10px;">@_syncedAgoText</MudText>
                }
            </div>

            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Primary" 
                       Size="Size.Small" 
                       StartIcon="@(_isSyncing ? Icons.Material.Filled.Sync : Icons.Material.Filled.Refresh)" 
                       Disabled="@_isSyncing" 
                       OnClick="ManualSync"
                       Class="rounded-pill">
                @(_isSyncing ? "Syncing..." : "Sync")
            </MudButton>
        </div>
    </div>

    <!-- TAB 1: OVERVIEW -->
    @if (HealthService.CurrentViewType == "Overview")
    {
        <MudGrid Spacing="4">
            <!-- LEFT COLUMN: Activity Hero -->
            <MudItem xs="12" lg="6">
                <MudPaper Class="detail-tile rounded-xl pa-4 pa-md-6 d-flex flex-column justify-center relative overflow-hidden" Elevation="3" Style="height: 100%; min-height: 320px;">
                    <!-- Header -->
                    <div class="d-flex align-center justify-space-between mb-4 z-10">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.Bolt" Color="Color.Warning" Size="Size.Large"/>
                            <MudText Typo="Typo.h5" Class="font-weight-bold">Daily Activity</MudText>
                        </div>
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">Target 10,000</MudChip>
                    </div>

                    <!-- Big Metrics Stack -->
                    <div class="d-flex flex-column flex-md-row align-center justify-space-around z-10 my-4 gap-4">
                        <!-- Steps -->
                        <div class="d-flex flex-column align-center relative">
                            @{ var stepsM = GetMetric(VitalType.Steps); }
                            <div style="@GetSourceDotStyle(stepsM?.SourceDevice); position: absolute; top: -5px; right: -5px;"></div>
                            <MudText Typo="Typo.caption" Style="opacity: 0.6; text-transform: uppercase; letter-spacing: 1px;">STEPS</MudText>
                            <MudText Typo="Typo.h3" Class="font-weight-bold">@FormatNumber(stepsM?.Value ?? 0)</MudText>
                            @if (!string.IsNullOrEmpty(GetSyncCaption(stepsM))) { <MudText Typo="Typo.caption" Style="opacity: 0.35; font-size: 9px;">@GetSyncCaption(stepsM)</MudText> }
                        </div>

                        <!-- Calories Ring -->
                        <div class="d-flex flex-column align-center mx-4 relative">
                            @{ var calM = GetMetric(VitalType.ActiveEnergy); }
                            <div style="@GetSourceDotStyle(calM?.SourceDevice); position: absolute; top: 0; right: 0; z-index: 20;"></div>
                            <MudProgressCircular Value="@GetPercent(calM?.Value ?? 0, 2500)" Size="Size.Large" Color="Color.Warning" StrokeWidth="8" Style="height: 120px; width: 120px;">
                                <div class="d-flex flex-column align-center">
                                    <MudText Typo="Typo.h5" Class="font-weight-bold">@FormatNumber(calM?.Value ?? 0)</MudText>
                                    <MudText Typo="Typo.caption">Kcal</MudText>
                                </div>
                            </MudProgressCircular>
                            @if (!string.IsNullOrEmpty(GetSyncCaption(calM))) { <MudText Typo="Typo.caption" Style="opacity: 0.35; font-size: 9px;">@GetSyncCaption(calM)</MudText> }
                        </div>

                        <!-- Sleep -->
                        <div class="d-flex flex-column align-center relative">
                            @{ var sleepM = GetMetric(VitalType.SleepDuration); }
                            <div style="@GetSourceDotStyle(sleepM?.SourceDevice); position: absolute; top: -5px; right: -5px;"></div>
                            <MudText Typo="Typo.caption" Style="opacity: 0.6; text-transform: uppercase; letter-spacing: 1px;">SLEEP</MudText>
                            <MudText Typo="Typo.h3" Class="font-weight-bold">@FormatSleep(sleepM?.Value ?? 0)</MudText>
                            @if (!string.IsNullOrEmpty(GetSyncCaption(sleepM))) { <MudText Typo="Typo.caption" Style="opacity: 0.35; font-size: 9px;">@GetSyncCaption(sleepM)</MudText> }
                        </div>
                    </div>

                    <!-- Activity Sub-Metrics -->
                    <div class="d-flex justify-space-around mt-auto pa-4 rounded-xl z-10" style="background: rgba(255,255,255,0.05);">
                        @{ var distM = GetMetric(VitalType.Distance); var floorM = GetMetric(VitalType.FloorsClimbed); var speedM = GetMetric(VitalType.WalkingSpeed); var basalM = GetMetric(VitalType.BasalEnergyBurned); }
                        <div class="d-flex flex-column align-center relative">
                            <div style="@GetSourceDotStyle(distM?.SourceDevice); position: absolute; top: -4px; right: -4px;"></div>
                            <MudIcon Icon="@Icons.Material.Filled.Map" Color="Color.Success" Size="Size.Small" Class="mb-1"/>
                            <MudText Typo="Typo.body2" Class="font-weight-bold">@(distM?.Value > 0 ? Math.Round(distM.Value/1000.0, 2) + " km" : "--")</MudText>
                            <MudText Typo="Typo.caption" Style="opacity: 0.5; font-size: 10px;">Distance</MudText>
                        </div>
                        <div class="d-flex flex-column align-center relative">
                            <div style="@GetSourceDotStyle(floorM?.SourceDevice); position: absolute; top: -4px; right: -4px;"></div>
                            <MudIcon Icon="@Icons.Material.Filled.Stairs" Color="Color.Info" Size="Size.Small" Class="mb-1"/>
                            <MudText Typo="Typo.body2" Class="font-weight-bold">@(floorM?.Value > 0 ? floorM.Value.ToString("N0") : "--")</MudText>
                            <MudText Typo="Typo.caption" Style="opacity: 0.5; font-size: 10px;">Floors</MudText>
                        </div>
                        <div class="d-flex flex-column align-center relative">
                            <div style="@GetSourceDotStyle(speedM?.SourceDevice); position: absolute; top: -4px; right: -4px;"></div>
                            <MudIcon Icon="@Icons.Material.Filled.Speed" Color="Color.Warning" Size="Size.Small" Class="mb-1"/>
                            <MudText Typo="Typo.body2" Class="font-weight-bold">@(speedM?.Value > 0 ? speedM.Value.ToString("N1") + " m/s" : "--")</MudText>
                            <MudText Typo="Typo.caption" Style="opacity: 0.5; font-size: 10px;">Pace</MudText>
                        </div>
                        <div class="d-flex flex-column align-center relative">
                            <div style="@GetSourceDotStyle(basalM?.SourceDevice); position: absolute; top: -4px; right: -4px;"></div>
                            <MudIcon Icon="@Icons.Material.Filled.Bed" Color="Color.Secondary" Size="Size.Small" Class="mb-1"/>
                            <MudText Typo="Typo.body2" Class="font-weight-bold">@(basalM?.Value > 0 ? basalM.Value.ToString("N0") + " kcal" : "--")</MudText>
                            <MudText Typo="Typo.caption" Style="opacity: 0.5; font-size: 10px;">Resting</MudText>
                        </div>
                    </div>

                    <div style="position: absolute; top: 0; right: 0; width: 100%; height: 100%; background: radial-gradient(circle at top right, rgba(255,152,0,0.15) 0%, transparent 60%); pointer-events: none;"></div>
                </MudPaper>
            </MudItem>

            <!-- RIGHT COLUMN: Core Vitals Grid -->
            <MudItem xs="12" lg="6">
                <MudGrid Spacing="3">
                    <!-- Heart Rate -->
                    @{ var hrM = GetMetric(VitalType.HeartRate); var rhrM = GetMetric(VitalType.RestingHeartRate); }
                    <MudItem xs="6">
                        <MudPaper Class="detail-tile rounded-xl pa-3 pa-md-4 relative" Elevation="2" Style="min-height: 120px;">
                            <div style="@GetSourceDotStyle(hrM?.SourceDevice); position: absolute; top: 12px; right: 12px;"></div>
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.Favorite" Color="Color.Error" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Class="font-weight-bold" Style="opacity: 0.7;">HEART RATE</MudText>
                            </div>
                            <div class="d-flex align-baseline gap-1">
                                <MudText Typo="Typo.h4" Class="font-weight-bold">@(hrM?.Value > 0 ? hrM.Value.ToString("N0") : "--")</MudText>
                                <MudText Typo="Typo.caption" Style="opacity: 0.6;">BPM</MudText>
                            </div>
                            <div class="d-flex align-center justify-space-between mt-2">
                                <MudText Typo="Typo.caption" Style="opacity: 0.6;">Resting: @(rhrM?.Value > 0 ? $"{rhrM.Value:N0} bpm" : "--")</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Style="font-size: 10px; height: 18px;">Normal</MudChip>
                            </div>
                        </MudPaper>
                    </MudItem>

                    <!-- Blood Pressure -->
                    @{ var sysM = GetMetric(VitalType.BloodPressureSystolic); var diaM = GetMetric(VitalType.BloodPressureDiastolic); }
                    <MudItem xs="6">
                        <MudPaper Class="detail-tile rounded-xl pa-3 pa-md-4 relative" Elevation="2" Style="min-height: 120px;">
                            <div style="@GetSourceDotStyle(sysM?.SourceDevice); position: absolute; top: 12px; right: 12px;"></div>
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.Speed" Color="Color.Info" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Class="font-weight-bold" Style="opacity: 0.7;">BLOOD PRESSURE</MudText>
                            </div>
                            <div class="d-flex align-baseline gap-1">
                                <MudText Typo="Typo.h4" Class="font-weight-bold">
                                    @(sysM?.Value > 0 && diaM?.Value > 0 ? $"{sysM.Value:N0}/{diaM.Value:N0}" : "--")
                                </MudText>
                                <MudText Typo="Typo.caption" Style="opacity: 0.6;">mmHg</MudText>
                            </div>
                            <div class="d-flex align-center justify-space-between mt-2">
                                <MudText Typo="Typo.caption" Style="opacity: 0.6;">SYS / DIA</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Style="font-size: 10px; height: 18px;">Optimal</MudChip>
                            </div>
                        </MudPaper>
                    </MudItem>

                    <!-- SpO2 (Oxygen Saturation) -->
                    @{ var spo2M = GetMetric(VitalType.OxygenSaturation); }
                    <MudItem xs="6">
                        <MudPaper Class="detail-tile rounded-xl pa-3 pa-md-4 relative" Elevation="2" Style="min-height: 120px;">
                            <div style="@GetSourceDotStyle(spo2M?.SourceDevice); position: absolute; top: 12px; right: 12px;"></div>
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.Air" Color="Color.Info" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Class="font-weight-bold" Style="opacity: 0.7;">BLOOD OXYGEN</MudText>
                            </div>
                            <div class="d-flex align-baseline gap-1">
                                <MudText Typo="Typo.h4" Class="font-weight-bold">@(spo2M?.Value > 0 ? spo2M.Value.ToString("N0") : "--")</MudText>
                                <MudText Typo="Typo.caption" Style="opacity: 0.6;">%</MudText>
                            </div>
                            <div class="d-flex align-center justify-space-between mt-2">
                                <MudText Typo="Typo.caption" Style="opacity: 0.6;">SpO2</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Style="font-size: 10px; height: 18px;">95-100% Safe</MudChip>
                            </div>
                        </MudPaper>
                    </MudItem>

                    <!-- HRV (Heart Rate Variability) -->
                    @{ var hrvM = GetMetric(VitalType.HeartRateVariabilitySDNN) ?? GetMetric(VitalType.HeartRateVariabilityRMSSD); }
                    <MudItem xs="6">
                        <MudPaper Class="detail-tile rounded-xl pa-3 pa-md-4 relative" Elevation="2" Style="min-height: 120px;">
                            <div style="@GetSourceDotStyle(hrvM?.SourceDevice); position: absolute; top: 12px; right: 12px;"></div>
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.Timeline" Color="Color.Secondary" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Class="font-weight-bold" Style="opacity: 0.7;">HRV</MudText>
                            </div>
                            <div class="d-flex align-baseline gap-1">
                                <MudText Typo="Typo.h4" Class="font-weight-bold">@(hrvM?.Value > 0 ? hrvM.Value.ToString("N0") : "--")</MudText>
                                <MudText Typo="Typo.caption" Style="opacity: 0.6;">ms</MudText>
                            </div>
                            <div class="d-flex align-center justify-space-between mt-2">
                                <MudText Typo="Typo.caption" Style="opacity: 0.6;">Autonomic nervous</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text" Style="font-size: 10px; height: 18px;">Balanced</MudChip>
                            </div>
                        </MudPaper>
                    </MudItem>

                    <!-- Blood Glucose -->
                    @{ var glucoseM = GetMetric(VitalType.BloodGlucose); }
                    <MudItem xs="6">
                        <MudPaper Class="detail-tile rounded-xl pa-3 pa-md-4 relative" Elevation="2" Style="min-height: 120px;">
                            <div style="@GetSourceDotStyle(glucoseM?.SourceDevice); position: absolute; top: 12px; right: 12px;"></div>
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.WaterDrop" Color="Color.Tertiary" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Class="font-weight-bold" Style="opacity: 0.7;">GLUCOSE</MudText>
                            </div>
                            <div class="d-flex align-baseline gap-1">
                                <MudText Typo="Typo.h4" Class="font-weight-bold">@(glucoseM?.Value > 0 ? glucoseM.Value.ToString("N0") : "--")</MudText>
                                <MudText Typo="Typo.caption" Style="opacity: 0.6;">mg/dL</MudText>
                            </div>
                            <div class="d-flex align-center justify-space-between mt-2">
                                <MudText Typo="Typo.caption" Style="opacity: 0.6;">Blood sugar</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Style="font-size: 10px; height: 18px;">Normal</MudChip>
                            </div>
                        </MudPaper>
                    </MudItem>

                    <!-- Respiratory Rate -->
                    @{ var respM = GetMetric(VitalType.RespiratoryRate); }
                    <MudItem xs="6">
                        <MudPaper Class="detail-tile rounded-xl pa-3 pa-md-4 relative" Elevation="2" Style="min-height: 120px;">
                            <div style="@GetSourceDotStyle(respM?.SourceDevice); position: absolute; top: 12px; right: 12px;"></div>
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.NightsStay" Color="Color.Primary" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Class="font-weight-bold" Style="opacity: 0.7;">RESPIRATION</MudText>
                            </div>
                            <div class="d-flex align-baseline gap-1">
                                <MudText Typo="Typo.h4" Class="font-weight-bold">@(respM?.Value > 0 ? respM.Value.ToString("N0") : "--")</MudText>
                                <MudText Typo="Typo.caption" Style="opacity: 0.6;">br/min</MudText>
                            </div>
                            <div class="d-flex align-center justify-space-between mt-2">
                                <MudText Typo="Typo.caption" Style="opacity: 0.6;">Resting rate</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Style="font-size: 10px; height: 18px;">12-20</MudChip>
                            </div>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudItem>

            <!-- 7-DAY TREND CHARTS -->
            <MudItem xs="12">
                <MudPaper Class="detail-tile rounded-xl pa-4 pa-md-6" Elevation="3">
                    <div class="d-flex flex-wrap align-center justify-space-between mb-4 gap-3">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.ShowChart" Color="Color.Primary" Size="Size.Medium" />
                            <MudText Typo="Typo.h6" Class="font-weight-bold">7-Day Trends</MudText>
                        </div>
                        <!-- Trend Metric Chips -->
                        <div class="d-flex flex-wrap gap-2">
                            <MudChip T="string" Size="Size.Small" Color="@(_selectedTrend == "Steps" ? Color.Primary : Color.Default)" Variant="@(_selectedTrend == "Steps" ? Variant.Filled : Variant.Outlined)" OnClick='() => SelectTrend("Steps")'>Steps</MudChip>
                            <MudChip T="string" Size="Size.Small" Color="@(_selectedTrend == "Calories" ? Color.Warning : Color.Default)" Variant="@(_selectedTrend == "Calories" ? Variant.Filled : Variant.Outlined)" OnClick='() => SelectTrend("Calories")'>Calories</MudChip>
                            <MudChip T="string" Size="Size.Small" Color="@(_selectedTrend == "Sleep" ? Color.Secondary : Color.Default)" Variant="@(_selectedTrend == "Sleep" ? Variant.Filled : Variant.Outlined)" OnClick='() => SelectTrend("Sleep")'>Sleep</MudChip>
                            <MudChip T="string" Size="Size.Small" Color="@(_selectedTrend == "HeartRate" ? Color.Error : Color.Default)" Variant="@(_selectedTrend == "HeartRate" ? Variant.Filled : Variant.Outlined)" OnClick='() => SelectTrend("HeartRate")'>Heart Rate</MudChip>
                            <MudChip T="string" Size="Size.Small" Color="@(_selectedTrend == "SpO2" ? Color.Info : Color.Default)" Variant="@(_selectedTrend == "SpO2" ? Variant.Filled : Variant.Outlined)" OnClick='() => SelectTrend("SpO2")'>SpO2</MudChip>
                            <MudChip T="string" Size="Size.Small" Color="@(_selectedTrend == "HRV" ? Color.Tertiary : Color.Default)" Variant="@(_selectedTrend == "HRV" ? Variant.Filled : Variant.Outlined)" OnClick='() => SelectTrend("HRV")'>HRV</MudChip>
                        </div>
                    </div>

                    <!-- Trend Summary Stats -->
                    <div class="d-flex align-center gap-6 mb-4 pa-3 rounded-lg" style="background: rgba(255,255,255,0.03);">
                        <div>
                            <MudText Typo="Typo.caption" Style="opacity: 0.5;">7-DAY AVG</MudText>
                            <MudText Typo="Typo.h6" Class="font-weight-bold">@FormatTrendVal(GetAvg(CurrentTrendData))</MudText>
                        </div>
                        <div>
                            <MudText Typo="Typo.caption" Style="opacity: 0.5;">HIGH</MudText>
                            <MudText Typo="Typo.h6" Class="font-weight-bold">@FormatTrendVal(GetMax(CurrentTrendData))</MudText>
                        </div>
                        <div>
                            <MudText Typo="Typo.caption" Style="opacity: 0.5;">LOW</MudText>
                            <MudText Typo="Typo.h6" Class="font-weight-bold">@FormatTrendVal(GetMinNonZero(CurrentTrendData))</MudText>
                        </div>
                        <MudSpacer />
                        <div class="d-flex align-center gap-1">
                            <MudIcon Icon="@GetTrendIcon(CurrentTrendData)" Style="@GetTrendColor(CurrentTrendData)" Size="Size.Small" />
                            <MudText Typo="Typo.body2" Class="font-weight-bold" Style="@GetTrendColor(CurrentTrendData)">@GetTrendPercent(CurrentTrendData)</MudText>
                        </div>
                    </div>

                    <!-- Capsule Chart Visual -->
                    <div class="d-flex align-end justify-space-between px-2" style="height: 140px; gap: 8px;">
                        @for (int i = 0; i < 7; i++)
                        {
                            var idx = i;
                            var val = CurrentTrendData.Count > idx ? CurrentTrendData[idx] : 0;
                            var maxVal = Math.Max(GetMax(CurrentTrendData), 1);
                            var heightPct = Math.Max(Math.Min((val / maxVal) * 100.0, 100.0), 6.0);
                            var dayLabel = GetDayLabel(idx);
                            var isToday = idx == 6;

                            <div class="d-flex flex-column align-center flex-grow-1 h-100 justify-end">
                                <MudTooltip Text="@($"{dayLabel}: {FormatTrendVal(val)}")">
                                    <div class="rounded-pill transition-all" 
                                         style="width: 100%; max-width: 36px; height: @(heightPct)%; 
                                                background: @(isToday ? "var(--mud-palette-primary)" : "rgba(255,255,255,0.18)");
                                                box-shadow: @(isToday ? "0 0 12px var(--mud-palette-primary)" : "none");">
                                    </div>
                                </MudTooltip>
                                <MudText Typo="Typo.caption" Class="mt-2 font-weight-bold" Style="@(isToday ? "color: var(--mud-palette-primary);" : "opacity: 0.5;")">
                                    @dayLabel
                                </MudText>
                            </div>
                        }
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }

    <!-- TAB 2: SLEEP ARCHITECTURE (CLINICAL HYPNOGRAM) -->
    else if (HealthService.CurrentViewType == "Sleep")
    {
        <MudGrid Spacing="4">
            <!-- Sleep Score & Summary Cards -->
            <MudItem xs="12">
                <MudPaper Class="detail-tile rounded-xl pa-4 pa-md-6" Elevation="3">
                    <div class="d-flex flex-column flex-md-row align-center justify-space-between gap-6">
                        <!-- Sleep Score Circular Gauge -->
                        <div class="d-flex align-center gap-4">
                            <MudProgressCircular Value="@_sleepScore" Size="Size.Large" Color="@GetSleepScoreColor(_sleepScore)" StrokeWidth="8" Style="height: 90px; width: 90px;">
                                <div class="d-flex flex-column align-center">
                                    <MudText Typo="Typo.h5" Class="font-weight-bold">@_sleepScore</MudText>
                                    <MudText Typo="Typo.caption" Style="font-size: 9px; opacity: 0.7;">SCORE</MudText>
                                </div>
                            </MudProgressCircular>
                            <div>
                                <MudText Typo="Typo.h5" Class="font-weight-bold">@GetSleepQualityLabel(_sleepScore)</MudText>
                                <MudText Typo="Typo.body2" Style="opacity: 0.6;">
                                    Bed: @(_sleepMinTime != DateTime.MinValue ? _sleepMinTime.ToString("HH:mm") : "--") • 
                                    Wake: @(_sleepMaxTime != DateTime.MinValue ? _sleepMaxTime.ToString("HH:mm") : "--")
                                </MudText>
                                <MudText Typo="Typo.caption" Style="opacity: 0.5;">Efficiency: @_sleepEfficiency%</MudText>
                            </div>
                        </div>

                        <!-- Sleep Metrics Summary Row -->
                        <div class="d-flex flex-wrap align-center justify-space-around gap-4 flex-grow-1">
                            <div class="d-flex flex-column align-center">
                                <MudText Typo="Typo.caption" Style="opacity: 0.5;">TIME ASLEEP</MudText>
                                <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: #42A5F5;">@_timeAsleepFormatted</MudText>
                            </div>
                            <div class="d-flex flex-column align-center">
                                <MudText Typo="Typo.caption" Style="opacity: 0.5;">TIME IN BED</MudText>
                                <MudText Typo="Typo.h5" Class="font-weight-bold">@_timeInBedFormatted</MudText>
                            </div>
                            <div class="d-flex flex-column align-center">
                                <MudText Typo="Typo.caption" Style="opacity: 0.5;">AWAKE COUNT</MudText>
                                <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: #FF7043;">@_awakeCount</MudText>
                            </div>
                            <div class="d-flex flex-column align-center">
                                <MudText Typo="Typo.caption" Style="opacity: 0.5;">DEEP + REM</MudText>
                                <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: #26C6DA;">@_restorativePercent%</MudText>
                            </div>
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- 4-LEVEL CLINICAL HYPNOGRAM GRAPH -->
            <MudItem xs="12">
                <MudPaper Class="detail-tile rounded-xl pa-4 pa-md-6" Elevation="3">
                    <div class="d-flex align-center justify-space-between mb-4">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.Bedtime" Color="Color.Secondary" Size="Size.Medium" />
                            <MudText Typo="Typo.h6" Class="font-weight-bold">Sleep Hypnogram</MudText>
                        </div>
                        <!-- Legend -->
                        <div class="d-flex align-center gap-4 flex-wrap">
                            <div class="d-flex align-center gap-1"><div style="width: 10px; height: 10px; border-radius: 2px; background: #FF7043;"></div><MudText Typo="Typo.caption">Awake</MudText></div>
                            <div class="d-flex align-center gap-1"><div style="width: 10px; height: 10px; border-radius: 2px; background: #26C6DA;"></div><MudText Typo="Typo.caption">REM</MudText></div>
                            <div class="d-flex align-center gap-1"><div style="width: 10px; height: 10px; border-radius: 2px; background: #42A5F5;"></div><MudText Typo="Typo.caption">Core / Light</MudText></div>
                            <div class="d-flex align-center gap-1"><div style="width: 10px; height: 10px; border-radius: 2px; background: #3949AB;"></div><MudText Typo="Typo.caption">Deep</MudText></div>
                        </div>
                    </div>

                    @if (_sleepTimelineEntries.Any())
                    {
                        <!-- Clinical Multi-Level Canvas -->
                        <div class="hypnogram-wrapper my-4">
                            <!-- Left Y-Axis Stage Labels -->
                            <div class="hypnogram-y-axis">
                                <div class="y-label" style="color: #FF7043;">Awake</div>
                                <div class="y-label" style="color: #26C6DA;">REM</div>
                                <div class="y-label" style="color: #42A5F5;">Core</div>
                                <div class="y-label" style="color: #3949AB;">Deep</div>
                            </div>

                            <!-- Hypnogram Canvas Area -->
                            <div class="hypnogram-canvas">
                                <!-- 4 Horizontal Stage Lanes -->
                                <div class="hypnogram-lane" style="top: 0px; border-top: 1px dashed rgba(255,255,255,0.08);"></div>
                                <div class="hypnogram-lane" style="top: 45px; border-top: 1px dashed rgba(255,255,255,0.08);"></div>
                                <div class="hypnogram-lane" style="top: 90px; border-top: 1px dashed rgba(255,255,255,0.08);"></div>
                                <div class="hypnogram-lane" style="top: 135px; border-top: 1px dashed rgba(255,255,255,0.08);"></div>

                                <!-- Vertical Hourly Grid Lines -->
                                @foreach (var hourMark in _hourlyTicks)
                                {
                                    <div class="hypnogram-grid-v" style="left: @(hourMark.LeftPct)%;"></div>
                                }

                                <!-- Sleep Stage Blocks -->
                                @foreach (var stage in _sleepTimelineEntries)
                                {
                                    var topPos = GetStageTop(stage.SleepCategory);
                                    var color = GetStageColor(stage.SleepCategory);
                                    var leftPct = GetStageLeft(stage);
                                    var widthPct = GetStageWidth(stage);

                                    <MudTooltip Text="@($"{stage.SleepCategory}: {stage.LocalStartTime:HH:mm} - {stage.LocalEndTime:HH:mm} ({(int)(stage.DurationSeconds/60)}m)")">
                                        <div class="hypnogram-block"
                                             style="top: @(topPos)px; left: @(leftPct)%; width: @(widthPct)%; background: @color;">
                                        </div>
                                    </MudTooltip>
                                }
                            </div>
                        </div>

                        <!-- Hourly X-Axis Labels -->
                        <div class="hypnogram-x-axis">
                            <div style="width: 55px; flex-shrink: 0;"></div> <!-- Spacer for Y-axis -->
                            <div class="x-labels-container">
                                @foreach (var hourMark in _hourlyTicks)
                                {
                                    <div class="x-tick-label" style="left: @(hourMark.LeftPct)%;">
                                        @hourMark.Label
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Fallback to Proportional Distribution Bar if intraday telemetry absent -->
                        <div class="pa-6 rounded-xl text-center" style="background: rgba(255,255,255,0.03);">
                            <MudText Typo="Typo.body1" Class="font-weight-bold mb-2">Aggregated Sleep Summary</MudText>
                            <MudText Typo="Typo.caption" Style="opacity: 0.6;" Class="mb-4">
                                Hourly timeline is awaiting smartwatch sync. Showing aggregated stage distribution.
                            </MudText>
                            
                            @{ 
                                var dM = GetMetric(VitalType.SleepDeep)?.Value ?? 0;
                                var rM = GetMetric(VitalType.SleepREM)?.Value ?? 0;
                                var lM = GetMetric(VitalType.SleepLight)?.Value ?? 0;
                                var aM = GetMetric(VitalType.SleepAwake)?.Value ?? 0;
                                var totalM = Math.Max(dM + rM + lM + aM, 1);
                            }
                            <div class="d-flex rounded-pill overflow-hidden my-4" style="height: 18px; width: 100%; background: rgba(255,255,255,0.08);">
                                <div style="width: @(aM / totalM * 100)%; background: #FF7043;" title="Awake: @FormatSleep(aM)"></div>
                                <div style="width: @(rM / totalM * 100)%; background: #26C6DA;" title="REM: @FormatSleep(rM)"></div>
                                <div style="width: @(lM / totalM * 100)%; background: #42A5F5;" title="Light: @FormatSleep(lM)"></div>
                                <div style="width: @(dM / totalM * 100)%; background: #3949AB;" title="Deep: @FormatSleep(dM)"></div>
                            </div>
                        </div>
                    }
                </MudPaper>
            </MudItem>

            <!-- Stage Breakdown Cards with Clinical Benchmark Indicators -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="detail-tile rounded-xl pa-4" Elevation="2" Style="border-left: 4px solid #3949AB;">
                    <div class="d-flex align-center justify-space-between mb-1">
                        <MudText Typo="Typo.caption" Class="font-weight-bold" Style="color: #3949AB;">DEEP SLEEP</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Style="font-size: 10px; height: 18px;">Optimal: 15-25%</MudChip>
                    </div>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@_deepDurationFormatted</MudText>
                    <MudText Typo="Typo.caption" Style="opacity: 0.6;">@_deepPercent% of total sleep</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="detail-tile rounded-xl pa-4" Elevation="2" Style="border-left: 4px solid #26C6DA;">
                    <div class="d-flex align-center justify-space-between mb-1">
                        <MudText Typo="Typo.caption" Class="font-weight-bold" Style="color: #26C6DA;">REM SLEEP</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Style="font-size: 10px; height: 18px;">Optimal: 20-25%</MudChip>
                    </div>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@_remDurationFormatted</MudText>
                    <MudText Typo="Typo.caption" Style="opacity: 0.6;">@_remPercent% of total sleep</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="detail-tile rounded-xl pa-4" Elevation="2" Style="border-left: 4px solid #42A5F5;">
                    <div class="d-flex align-center justify-space-between mb-1">
                        <MudText Typo="Typo.caption" Class="font-weight-bold" Style="color: #42A5F5;">CORE / LIGHT</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Style="font-size: 10px; height: 18px;">Optimal: 50-60%</MudChip>
                    </div>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@_lightDurationFormatted</MudText>
                    <MudText Typo="Typo.caption" Style="opacity: 0.6;">@_lightPercent% of total sleep</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="detail-tile rounded-xl pa-4" Elevation="2" Style="border-left: 4px solid #FF7043;">
                    <div class="d-flex align-center justify-space-between mb-1">
                        <MudText Typo="Typo.caption" Class="font-weight-bold" Style="color: #FF7043;">AWAKE</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Style="font-size: 10px; height: 18px;">Target: &lt;10%</MudChip>
                    </div>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@_awakeDurationFormatted</MudText>
                    <MudText Typo="Typo.caption" Style="opacity: 0.6;">@_awakePercent% time in bed</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }

    <!-- TAB 3: WEARABLE SENSORS & TELEMETRY -->
    else if (HealthService.CurrentViewType == "Sensors")
    {
        <MudGrid Spacing="4">
            <!-- Intraday Continuous Heart Rate Chart -->
            <MudItem xs="12" lg="8">
                <MudPaper Class="detail-tile rounded-xl pa-4 pa-md-6" Elevation="3">
                    <div class="d-flex align-center justify-space-between mb-4">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.Favorite" Color="Color.Error" Size="Size.Medium" />
                            <MudText Typo="Typo.h6" Class="font-weight-bold">Continuous Heart Rate Today</MudText>
                        </div>
                        <MudText Typo="Typo.h6" Color="Color.Error" Class="font-weight-bold">@_avgIntradayHr <span style="font-size: 0.6em; opacity: 0.6;">BPM AVG</span></MudText>
                    </div>

                    @if (_hrChartSeries.Any())
                    {
                        <MudChart ChartType="ChartType.Line" ChartSeries="@_hrChartSeries" XAxisLabels="@_hrChartLabels" Width="100%" Height="220px" ChartOptions="@_chartOptionsHr" />
                    }
                    else
                    {
                        <div class="d-flex align-center justify-center py-8" style="opacity: 0.5;">
                            <MudText Typo="Typo.body2">No intraday heart rate telemetry received today.</MudText>
                        </div>
                    }

                    <!-- Heart Rate Zones Cards -->
                    <div class="d-flex flex-wrap justify-space-between gap-2 mt-4 pt-3" style="border-top: 1px solid rgba(255,255,255,0.06);">
                        <div class="d-flex flex-column align-center px-2">
                            <MudText Typo="Typo.caption" Style="font-size: 10px; opacity: 0.5;">RESTING (&lt;100)</MudText>
                            <MudText Typo="Typo.body1" Class="font-weight-bold" Style="color: #4CAF50;">@_hrRestingPct%</MudText>
                        </div>
                        <div class="d-flex flex-column align-center px-2">
                            <MudText Typo="Typo.caption" Style="font-size: 10px; opacity: 0.5;">FAT BURN (100-120)</MudText>
                            <MudText Typo="Typo.body1" Class="font-weight-bold" Style="color: #FFB300;">@_hrFatBurnPct%</MudText>
                        </div>
                        <div class="d-flex flex-column align-center px-2">
                            <MudText Typo="Typo.caption" Style="font-size: 10px; opacity: 0.5;">CARDIO (120-150)</MudText>
                            <MudText Typo="Typo.body1" Class="font-weight-bold" Style="color: #FF7043;">@_hrCardioPct%</MudText>
                        </div>
                        <div class="d-flex flex-column align-center px-2">
                            <MudText Typo="Typo.caption" Style="font-size: 10px; opacity: 0.5;">PEAK (&gt;150)</MudText>
                            <MudText Typo="Typo.body1" Class="font-weight-bold" Style="color: #F44336;">@_hrPeakPct%</MudText>
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- Stress & PAI Indicators -->
            <MudItem xs="12" lg="4">
                <MudPaper Class="detail-tile rounded-xl pa-4 pa-md-6 d-flex flex-column justify-space-between" Elevation="3" Style="height: 100%; min-height: 280px;">
                    <!-- Stress Level -->
                    <div>
                        <div class="d-flex align-center justify-space-between mb-2">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Psychology" Color="Color.Tertiary" Size="Size.Small" />
                                <MudText Typo="Typo.body1" Class="font-weight-bold">Stress Level</MudText>
                            </div>
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">Relaxed</MudChip>
                        </div>
                        <div class="d-flex align-baseline gap-1 my-2">
                            <MudText Typo="Typo.h3" Class="font-weight-bold">@_stressScore</MudText>
                            <MudText Typo="Typo.caption" Style="opacity: 0.6;">/ 100</MudText>
                        </div>
                        <MudProgressLinear Value="@_stressScore" Color="Color.Tertiary" Rounded="true" Size="Size.Medium" Class="my-2" />
                        <MudText Typo="Typo.caption" Style="opacity: 0.5;">Continuous physiological stress monitoring</MudText>
                    </div>

                    <MudDivider Class="my-4" />

                    <!-- PAI Score -->
                    <div>
                        <div class="d-flex align-center justify-space-between mb-2">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Color="Color.Warning" Size="Size.Small" />
                                <MudText Typo="Typo.body1" Class="font-weight-bold">PAI Score</MudText>
                            </div>
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">Target 100</MudChip>
                        </div>
                        <div class="d-flex align-baseline gap-1 my-2">
                            <MudText Typo="Typo.h3" Class="font-weight-bold">@_paiScore</MudText>
                            <MudText Typo="Typo.caption" Style="opacity: 0.6;">PAI</MudText>
                        </div>
                        <MudProgressLinear Value="@_paiScore" Color="Color.Warning" Rounded="true" Size="Size.Medium" Class="my-2" />
                        <MudText Typo="Typo.caption" Style="opacity: 0.5;">Personal Activity Intelligence (7-day rolling)</MudText>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- Hourly Step Cadence -->
            <MudItem xs="12" lg="8">
                <MudPaper Class="detail-tile rounded-xl pa-4 pa-md-6" Elevation="3">
                    <div class="d-flex align-center justify-space-between mb-4">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.DirectionsWalk" Color="Color.Primary" Size="Size.Medium" />
                            <MudText Typo="Typo.h6" Class="font-weight-bold">Hourly Steps Cadence</MudText>
                        </div>
                        <MudText Typo="Typo.caption" Class="font-weight-bold" Style="opacity: 0.7;">@_activeHoursCount / 12 ACTIVE HOURS</MudText>
                    </div>

                    @if (_stepsChartSeries.Any())
                    {
                        <MudChart ChartType="ChartType.Bar" ChartSeries="@_stepsChartSeries" XAxisLabels="@_stepsChartLabels" Width="100%" Height="200px" ChartOptions="@_chartOptionsSteps" />
                    }
                    else
                    {
                        <div class="d-flex align-center justify-center py-8" style="opacity: 0.5;">
                            <MudText Typo="Typo.body2">No intraday step telemetry recorded today.</MudText>
                        </div>
                    }
                </MudPaper>
            </MudItem>

            <!-- Connected Devices & Sinks -->
            <MudItem xs="12" lg="4">
                <MudPaper Class="detail-tile rounded-xl pa-4 pa-md-6" Elevation="3">
                    <div class="d-flex align-center gap-2 mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Watch" Color="Color.Info" Size="Size.Medium" />
                        <MudText Typo="Typo.h6" Class="font-weight-bold">Connected Devices</MudText>
                    </div>

                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex align-center justify-space-between pa-3 rounded-lg" style="background: rgba(255,255,255,0.03);">
                            <div class="d-flex align-center gap-3">
                                <MudIcon Icon="@Icons.Material.Filled.Watch" Color="Color.Info" Size="Size.Small" />
                                <div>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">Smartwatch Sensors</MudText>
                                    <MudText Typo="Typo.caption" Style="opacity: 0.5;">Zepp OS / Apple Watch</MudText>
                                </div>
                            </div>
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Style="font-size: 10px; height: 20px;">Active</MudChip>
                        </div>

                        <div class="d-flex align-center justify-space-between pa-3 rounded-lg" style="background: rgba(255,255,255,0.03);">
                            <div class="d-flex align-center gap-3">
                                <MudIcon Icon="@Icons.Material.Filled.PhoneIphone" Color="Color.Primary" Size="Size.Small" />
                                <div>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">Mobile Health Store</MudText>
                                    <MudText Typo="Typo.caption" Style="opacity: 0.5;">Apple Health / Health Connect</MudText>
                                </div>
                            </div>
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Style="font-size: 10px; height: 20px;">Synced</MudChip>
                        </div>

                        <div class="d-flex align-center justify-space-between pa-3 rounded-lg" style="background: rgba(255,255,255,0.03);">
                            <div class="d-flex align-center gap-3">
                                <MudIcon Icon="@Icons.Material.Filled.CloudSync" Color="Color.Secondary" Size="Size.Small" />
                                <div>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">Supabase Cloud Vault</MudText>
                                    <MudText Typo="Typo.caption" Style="opacity: 0.5;">Realtime Telemetry</MudText>
                                </div>
                            </div>
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled" Style="font-size: 10px; height: 20px;">Live</MudChip>
                        </div>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }

    <!-- TAB 4: NUTRITION & BODY COMPOSITION -->
    else if (HealthService.CurrentViewType == "Nutrition")
    {
        <MudGrid Spacing="4">
            <!-- Hydration Hero -->
            @{ var waterM = GetMetric(VitalType.Hydration); var waterVal = waterM?.Value ?? 0; var waterLiters = waterVal > 20 ? waterVal / 1000.0 : waterVal; }
            <MudItem xs="12" lg="6">
                <MudPaper Class="detail-tile rounded-xl pa-4 pa-md-6" Elevation="3">
                    <div class="d-flex align-center justify-space-between mb-4">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.WaterDrop" Color="Color.Info" Size="Size.Large" />
                            <MudText Typo="Typo.h5" Class="font-weight-bold">Hydration</MudText>
                        </div>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">Goal: 3.0 L</MudChip>
                    </div>

                    <div class="d-flex align-center justify-space-between my-4">
                        <div>
                            <div class="d-flex align-baseline gap-1">
                                <MudText Typo="Typo.h3" Class="font-weight-bold" Style="color: #29B6F6;">@(waterLiters > 0 ? waterLiters.ToString("N1") : "--")</MudText>
                                <MudText Typo="Typo.h6" Style="opacity: 0.6;">L</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Style="opacity: 0.6;">@(waterLiters > 0 ? $"{(int)((waterLiters / 3.0) * 100)}% of daily recommendation" : "No intake logged today")</MudText>
                        </div>
                        <MudProgressCircular Value="@GetPercent(waterLiters, 3.0)" Size="Size.Large" Color="Color.Info" StrokeWidth="8" Style="height: 100px; width: 100px;">
                            <MudIcon Icon="@Icons.Material.Filled.Opacity" Size="Size.Medium" Style="color: #29B6F6;" />
                        </MudProgressCircular>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- Macronutrients -->
            @{ 
                var carbsM = GetMetric(VitalType.Carbs)?.Value ?? 0;
                var protM = GetMetric(VitalType.Protein)?.Value ?? 0;
                var fatM = GetMetric(VitalType.Fat)?.Value ?? 0;
                var totalMacros = Math.Max(carbsM + protM + fatM, 1);
            }
            <MudItem xs="12" lg="6">
                <MudPaper Class="detail-tile rounded-xl pa-4 pa-md-6" Elevation="3">
                    <div class="d-flex align-center justify-space-between mb-4">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.PieChart" Color="Color.Warning" Size="Size.Large" />
                            <MudText Typo="Typo.h5" Class="font-weight-bold">Macronutrients</MudText>
                        </div>
                        <MudText Typo="Typo.caption" Style="opacity: 0.6;">@(carbsM + protM + fatM > 0 ? $"{carbsM + protM + fatM:N0}g total" : "--")</MudText>
                    </div>

                    <!-- Macro Ratio Bar -->
                    <div class="d-flex rounded-pill overflow-hidden my-3" style="height: 14px; width: 100%; background: rgba(255,255,255,0.08);">
                        <div style="width: @(carbsM / totalMacros * 100)%; background: #26C6DA;" title="Carbs: @carbsM g"></div>
                        <div style="width: @(protM / totalMacros * 100)%; background: #7E57C2;" title="Protein: @protM g"></div>
                        <div style="width: @(fatM / totalMacros * 100)%; background: #FFA726;" title="Fat: @fatM g"></div>
                    </div>

                    <!-- Macro Grams Breakdown -->
                    <div class="d-flex justify-space-around mt-4">
                        <div class="d-flex flex-column align-center">
                            <div class="d-flex align-center gap-1"><div style="width: 8px; height: 8px; border-radius: 4px; background: #26C6DA;"></div><MudText Typo="Typo.caption">Carbs</MudText></div>
                            <MudText Typo="Typo.h6" Class="font-weight-bold">@(carbsM > 0 ? $"{carbsM:N0}g" : "--")</MudText>
                            <MudText Typo="Typo.caption" Style="opacity: 0.4;">@((int)(carbsM * 4)) kcal</MudText>
                        </div>
                        <div class="d-flex flex-column align-center">
                            <div class="d-flex align-center gap-1"><div style="width: 8px; height: 8px; border-radius: 4px; background: #7E57C2;"></div><MudText Typo="Typo.caption">Protein</MudText></div>
                            <MudText Typo="Typo.h6" Class="font-weight-bold">@(protM > 0 ? $"{protM:N0}g" : "--")</MudText>
                            <MudText Typo="Typo.caption" Style="opacity: 0.4;">@((int)(protM * 4)) kcal</MudText>
                        </div>
                        <div class="d-flex flex-column align-center">
