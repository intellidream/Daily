    <!-- DIAGNOSTICS & SYNC LOG (Collapsible Accordion) -->
    <MudExpansionPanels Class="rounded-xl mt-2" Style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06);">
        <MudExpansionPanel Text="Diagnostics & Sync Telemetry Log" Icon="@Icons.Material.Filled.Terminal">
            <div class="d-flex justify-space-between align-center mb-2">
