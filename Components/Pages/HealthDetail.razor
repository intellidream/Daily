    private Color GetBmiColor(double bmi)
    {
        if (bmi <= 0) return Color.Default;
        if (bmi < 18.5) return Color.Info;
        if (bmi <= 24.9) return Color.Success;
        if (bmi <= 29.9) return Color.Warning;
