@page "/health-telemetry"
@using Daily.Models.Health
@using Daily.Services.Health
@using Daily.Services
@using MudBlazor
@inject IHealthService HealthService
@inject IRefreshService RefreshService
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
    <div class="d-flex align-center mb-6">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" Edge="Edge.Start" OnClick="GoBack" />
        <MudText Typo="Typo.h5" Class="ml-3 font-weight-bold">Health Telemetry Data</MudText>
    </div>

    @if (isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" Class="rounded-lg mb-4" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" Class="rounded-lg mb-4" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" Class="rounded-lg mb-4" />
    }
    else
    {
        <MudGrid>
            <!-- Steps Section -->
            <MudItem xs="12">
                <MudPaper Class="pa-4 rounded-lg" Elevation="0" Style="background-color: var(--mud-palette-background-grey);">
                    <div class="d-flex align-center mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.DirectionsWalk" Color="Color.Primary" Class="mr-2" />
                        <MudText Typo="Typo.h6" Class="font-weight-bold">Steps</MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.h5" Color="Color.Primary" Class="font-weight-bold">@totalSteps.ToString("N0")</MudText>
                    </div>

                    @if (stepsSeries.Count > 0)
                    {
                        <MudChart ChartType="ChartType.Bar" ChartSeries="@stepsSeries" XAxisLabels="@stepsLabels" Width="100%" Height="250px" ChartOptions="chartOptions" />
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Style="opacity: 0.6;">No steps data available.</MudText>
                    }
                </MudPaper>
            </MudItem>

            <!-- Sleep Section -->
            <MudItem xs="12">
                <MudPaper Class="pa-4 rounded-lg" Elevation="0" Style="background-color: var(--mud-palette-background-grey);">
                    <div class="d-flex align-center mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Bedtime" Color="Color.Secondary" Class="mr-2" />
                        <MudText Typo="Typo.h6" Class="font-weight-bold">Sleep Timeline</MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.h5" Color="Color.Secondary" Class="font-weight-bold">@totalSleepText</MudText>
                    </div>

                    @if (sleepEntries.Any())
                    {
                        <div class="sleep-timeline-container" style="position: relative; height: 120px; width: 100%; border-radius: 8px; background-color: var(--mud-palette-background); overflow: hidden;">
                            @foreach (var stage in sleepEntries)
                            {
                                <div class="sleep-stage-block"
                                     style="position: absolute; 
                                            left: @(GetSleepStageLeft(stage))%; 
                                            width: @(GetSleepStageWidth(stage))%; 
                                            height: 100%; 
                                            background-color: @GetSleepStageColor(stage.SleepCategory);"
                                     title="@($"{stage.SleepCategory}: {stage.LocalStartTime:HH:mm} - {stage.LocalEndTime:HH:mm}")">
                                </div>
                            }
                            
                            <!-- Current time indicator line if within bounds -->
                            @if (IsTimeInSleepBounds(DateTime.UtcNow))
                            {
                                <div class="current-time-indicator"
                                     style="position: absolute;
                                            left: @(GetSleepStageLeft(new HealthTelemetry { StartTime = DateTime.UtcNow }))%;
                                            width: 2px;
                                            height: 100%;
                                            background-color: red;
                                            z-index: 10;">
                                </div>
                            }
                        </div>
                        
                        <div class="d-flex justify-space-between mt-2 px-2" style="opacity: 0.6;">
                            <MudText Typo="Typo.caption">@sleepMinTime.ToString("HH:mm")</MudText>
                            <MudText Typo="Typo.caption">@sleepMaxTime.ToString("HH:mm")</MudText>
                        </div>
                        
                        <div class="d-flex justify-center flex-wrap gap-4 mt-4">
                            <div class="d-flex align-center"><div style="width: 12px; height: 12px; border-radius: 6px; background-color: #2b5c8f; margin-right: 6px;"></div><MudText Typo="Typo.caption">Deep</MudText></div>
                            <div class="d-flex align-center"><div style="width: 12px; height: 12px; border-radius: 6px; background-color: #4a90e2; margin-right: 6px;"></div><MudText Typo="Typo.caption">Core / Light</MudText></div>
                            <div class="d-flex align-center"><div style="width: 12px; height: 12px; border-radius: 6px; background-color: #a29bfe; margin-right: 6px;"></div><MudText Typo="Typo.caption">REM</MudText></div>
                            <div class="d-flex align-center"><div style="width: 12px; height: 12px; border-radius: 6px; background-color: #fdcb6e; margin-right: 6px;"></div><MudText Typo="Typo.caption">Awake</MudText></div>
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Style="opacity: 0.6;">No sleep data available for this period.</MudText>
                    }
                </MudPaper>
            </MudItem>

            <!-- Heart Rate Section -->
            <MudItem xs="12">
                <MudPaper Class="pa-4 rounded-lg" Elevation="0" Style="background-color: var(--mud-palette-background-grey);">
                    <div class="d-flex align-center mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.MonitorHeart" Color="Color.Error" Class="mr-2" />
                        <MudText Typo="Typo.h6" Class="font-weight-bold">Heart Rate</MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.h5" Color="Color.Error" Class="font-weight-bold">@avgHeartRate <span style="font-size: 0.5em; opacity: 0.6;">BPM</span></MudText>
                    </div>

                    @if (hrSeries.Count > 0)
                    {
                        <MudChart ChartType="ChartType.Line" ChartSeries="@hrSeries" XAxisLabels="@hrLabels" Width="100%" Height="250px" ChartOptions="chartOptions" />
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Style="opacity: 0.6;">No heart rate data available.</MudText>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private bool isLoading = true;
    
    // Steps
    private double totalSteps = 0;
    private List<ChartSeries<double>> stepsSeries = new();
    private string[] stepsLabels = Array.Empty<string>();
    
    // Sleep
    private string totalSleepText = "--";
    private List<HealthTelemetry> sleepEntries = new();
    private DateTime sleepMinTime;
    private DateTime sleepMaxTime;
    
    // HR
    private double avgHeartRate = 0;
    private List<ChartSeries<double>> hrSeries = new();
    private string[] hrLabels = Array.Empty<string>();

    private ChartOptions chartOptions = new ChartOptions
    {
        ChartPalette = new[] { "var(--mud-palette-primary)" }
    };

    [Inject] private NavigationManager Navigation { get; set; } = null!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        RefreshService.HealthRefreshRequested += OnHealthRefreshRequested;
        RefreshService.RefreshRequested += OnHealthRefreshRequested;
        await LoadDataAsync();
    }

    private async Task OnHealthRefreshRequested()
    {
        await InvokeAsync(async () =>
        {
            await LoadDataAsync();
        });
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var yesterdayEvening = DateTime.Today.AddDays(-1).AddHours(18);
            var endOfToday = DateTime.Today.AddDays(1).AddTicks(-1);

            var telemetryData = await HealthService.GetHealthTelemetryAsync(yesterdayEvening, endOfToday);
            var today = DateTime.Today;

            // Process Steps
            var stepsData = telemetryData
                .Where(x => x.IsSteps && x.LocalStartTime >= today)
                .OrderBy(x => x.LocalStartTime)
                .ToList();

            totalSteps = stepsData.Sum(x => x.Value ?? 0);

            if (stepsData.Any())
            {
                var hourlySteps = stepsData.GroupBy(x => x.LocalStartTime.Hour)
                                           .Select(g => new { Hour = g.Key, Total = g.Sum(x => x.Value ?? 0) })
                                           .OrderBy(x => x.Hour)
                                           .ToList();
                                           
                stepsSeries = new List<ChartSeries<double>>
                {
                    new ChartSeries<double> { Name = "Steps", Data = hourlySteps.Select(x => x.Total).ToArray() }
                };
                stepsLabels = hourlySteps.Select(x => $"{x.Hour}:00").ToArray();
            }
            else
            {
                stepsSeries = new List<ChartSeries<double>>();
                stepsLabels = Array.Empty<string>();
            }

            // Process Sleep
            sleepEntries = telemetryData
                .Where(x => x.IsSleep)
                .OrderBy(x => x.LocalStartTime)
                .ToList();

            if (sleepEntries.Any())
            {
                sleepMinTime = sleepEntries.Min(x => x.LocalStartTime);
                sleepMaxTime = sleepEntries.Max(x => x.LocalEndTime);
                
                var totalSleepSeconds = sleepEntries
                    .Where(x => !x.NormalizedType.Contains("awake") && !x.NormalizedType.Contains("wake"))
                    .Sum(x => x.DurationSeconds);
                
                var ts = TimeSpan.FromSeconds(totalSleepSeconds);
                totalSleepText = $"{(int)ts.TotalHours}h {ts.Minutes}m";
            }
            else
            {
                totalSleepText = "--";
            }

            // Process HR
            var hrData = telemetryData
                .Where(x => x.IsHeartRate && x.LocalStartTime >= today && x.Value.HasValue)
                .OrderBy(x => x.LocalStartTime)
                .ToList();

            if (hrData.Any())
            {
                avgHeartRate = Math.Round(hrData.Average(x => x.Value!.Value), 0);
                
                var hourlyHr = hrData.GroupBy(x => x.LocalStartTime.Hour)
                                     .Select(g => new { Hour = g.Key, Avg = g.Average(x => x.Value!.Value) })
                                     .OrderBy(x => x.Hour)
                                     .ToList();
                
                hrSeries = new List<ChartSeries<double>>
                {
                    new ChartSeries<double> { Name = "Heart Rate", Data = hourlyHr.Select(x => x.Avg).ToArray() }
                };
                hrLabels = hourlyHr.Select(x => $"{x.Hour}:00").ToArray();
            }
            else
            {
                avgHeartRate = 0;
                hrSeries = new List<ChartSeries<double>>();
                hrLabels = Array.Empty<string>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading detailed health telemetry: {ex}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string GetSleepStageColor(string stageCategory)
    {
        return stageCategory switch
        {
            "Deep" => "#2b5c8f",
            "REM" => "#a29bfe",
            "Awake" => "#fdcb6e",
            _ => "#4a90e2"
        };
    }

    private double GetSleepStageLeft(HealthTelemetry stage)
    {
        if (!sleepEntries.Any()) return 0;
        
        var totalDuration = (sleepMaxTime - sleepMinTime).TotalSeconds;
        if (totalDuration <= 0) return 0;
        
        var offset = (stage.LocalStartTime - sleepMinTime).TotalSeconds;
        return (offset / totalDuration) * 100.0;
    }

    private double GetSleepStageWidth(HealthTelemetry stage)
    {
        if (!sleepEntries.Any()) return 0;
        
        var totalDuration = (sleepMaxTime - sleepMinTime).TotalSeconds;
        if (totalDuration <= 0) return 0;
        
        var stageDuration = (stage.LocalEndTime - stage.LocalStartTime).TotalSeconds;
        return Math.Max((stageDuration / totalDuration) * 100.0, 1.0);
    }
    
    private bool IsTimeInSleepBounds(DateTime time)
    {
        return sleepEntries.Any() && time >= sleepMinTime && time <= sleepMaxTime;
    }

    private async Task GoBack()
    {
        await JSRuntime.InvokeVoidAsync("history.back");
    }

    public void Dispose()
    {
        RefreshService.HealthRefreshRequested -= OnHealthRefreshRequested;
        RefreshService.RefreshRequested -= OnHealthRefreshRequested;
    }
}
