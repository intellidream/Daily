<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Daily_WinUI.DesktopWidgets.Views.DesktopStressWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="UserControl_Loaded">

    <Grid Padding="14,12,14,12">
        <!-- ── SMALL LAYOUT (170x170) ── -->
        <Grid x:Name="SmallLayout" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xEC0A;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#34D399"/>
                <TextBlock Text="Stress &amp; HRV" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
            </StackPanel>

            <!-- Circular Gauge & Score -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="72" Height="72">
                <ProgressRing x:Name="SmallProgressRing" Width="72" Height="72" Value="24" Maximum="100" IsIndeterminate="False"
                              Foreground="#34D399" Background="#2034D399" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="SmallScoreText" Text="24" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FFFFFFFF"/>
                    <TextBlock Text="Low" FontSize="10" Foreground="#34D399" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Bottom Pill -->
            <Border Grid.Row="2" Background="#1534D399" CornerRadius="8" Padding="6,4,6,4" HorizontalAlignment="Stretch">
                <TextBlock x:Name="SmallHrvText" Text="HRV: 64 ms (Calm)" FontSize="9" Foreground="#34D399" HorizontalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- ── MEDIUM LAYOUT (360x170) ── -->
        <Grid x:Name="MediumLayout" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="13" Background="#2534D399">
                        <FontIcon Glyph="&#xEC0A;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Stress &amp; Autonomic Balance" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                        <TextBlock x:Name="MediumStatusSubtitle" Text="Autonomic State: Relaxed &amp; Focused" FontSize="10" Foreground="#80FFFFFF"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="MediumScoreText" Text="22" FontSize="18" FontWeight="Bold" Foreground="#34D399"/>
                    <TextBlock Text="/100" FontSize="11" Foreground="#80FFFFFF" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </StackPanel>
            </Grid>

            <!-- Center Content: Progress Ring & Vitals -->
            <Grid Grid.Row="1" Margin="0,8,0,8" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Circular Gauge -->
                <Grid Width="64" Height="64" Margin="4,0,14,0" VerticalAlignment="Center">
                    <ProgressRing x:Name="MediumProgressRing" Width="64" Height="64" Value="22" Maximum="100" IsIndeterminate="False"
                                  Foreground="#34D399" Background="#2034D399" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="MediumLevelLabel" Text="Low" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                    </StackPanel>
                </Grid>

                <!-- Metrics & Explanation -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock x:Name="MediumRecommendationText" Text="Optimal autonomic nervous system balance." FontSize="11" Foreground="#D1FAE5"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                        <Border Background="#1534D399" CornerRadius="6" Padding="6,2,6,2">
                            <TextBlock x:Name="MediumHrvBadge" Text="HRV: 64 ms (High)" FontSize="10" Foreground="#34D399"/>
                        </Border>
                        <Border Background="#1538BDF8" CornerRadius="6" Padding="6,2,6,2">
                            <TextBlock x:Name="MediumPulseBadge" Text="Pulse: 62 bpm" FontSize="10" Foreground="#38BDF8"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Breathe / Mindful Action Button -->
            <Button Grid.Row="2" HorizontalAlignment="Stretch" Height="30" Padding="0"
                    Background="#2034D399" BorderBrush="#3534D399" BorderThickness="1" CornerRadius="8"
                    Click="BreatheAction_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE735;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#34D399"/>
                    <TextBlock x:Name="BreatheButtonText" Text="1-Minute Mindful Breathing" FontSize="11" FontWeight="SemiBold" Foreground="#34D399"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ── LARGE LAYOUT (360x360) ── -->
        <Grid x:Name="LargeLayout" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="17" Background="#2534D399">
                        <FontIcon Glyph="&#xEC0A;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Autonomic Balance &amp; Stress" FontSize="14" FontWeight="Bold" Foreground="#FFFFFFFF"/>
                        <TextBlock x:Name="LargeStatusSubtitle" Text="State: Relaxed &amp; Focused · Calm" FontSize="11" Foreground="#80FFFFFF"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="LargeScoreText" Text="22" FontSize="22" FontWeight="Bold" Foreground="#34D399"/>
                    <TextBlock Text="/100" FontSize="12" Foreground="#80FFFFFF" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                </StackPanel>
            </Grid>

            <!-- 2. Circular Gauge & Nervous System Breakdown -->
            <Border Grid.Row="1" Background="#10FFFFFF" CornerRadius="10" Padding="12,10,12,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="64" Height="64" Margin="4,0,14,0" VerticalAlignment="Center">
                        <ProgressRing x:Name="LargeProgressRing" Width="64" Height="64" Value="22" Maximum="100" IsIndeterminate="False"
                                      Foreground="#34D399" Background="#2034D399" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="LargeLevelLabel" Text="Low" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="LargeRecommendationText" Text="Optimal autonomic balance. Parasympathetic tone dominant." FontSize="11" FontWeight="SemiBold" Foreground="#D1FAE5" TextWrapping="Wrap"/>
                        <TextBlock Text="Low physical and cognitive fatigue. High resilience to upcoming tasks." FontSize="10" Foreground="#A0FFFFFF" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. 4-Card Biomarkers Grid (HRV, Pulse, Vagal Tone, Recovery) -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Margin="0,0,4,6" Background="#15FFFFFF" CornerRadius="10" Padding="10,6,10,6">
                    <StackPanel Spacing="2">
                        <TextBlock Text="HRV RMSSD" FontSize="9" FontWeight="SemiBold" Foreground="#80FFFFFF"/>
                        <TextBlock x:Name="LargeHrvText" Text="64 ms (High)" FontSize="13" FontWeight="Bold" Foreground="#34D399"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Margin="4,0,0,6" Background="#15FFFFFF" CornerRadius="10" Padding="10,6,10,6">
                    <StackPanel Spacing="2">
                        <TextBlock Text="HEART RATE" FontSize="9" FontWeight="SemiBold" Foreground="#80FFFFFF"/>
                        <TextBlock x:Name="LargePulseText" Text="58 bpm (RHR)" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Margin="0,0,4,0" Background="#15FFFFFF" CornerRadius="10" Padding="10,6,10,6">
                    <StackPanel Spacing="2">
                        <TextBlock Text="AUTONOMIC TONE" FontSize="9" FontWeight="SemiBold" Foreground="#80FFFFFF"/>
                        <TextBlock x:Name="LargeToneText" Text="Parasympathetic" FontSize="13" FontWeight="Bold" Foreground="#A78BFA"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Margin="4,0,0,0" Background="#15FFFFFF" CornerRadius="10" Padding="10,6,10,6">
                    <StackPanel Spacing="2">
                        <TextBlock Text="RESILIENCE CAPACITY" FontSize="9" FontWeight="SemiBold" Foreground="#80FFFFFF"/>
                        <TextBlock x:Name="LargeResilienceText" Text="94% Optimal" FontSize="13" FontWeight="Bold" Foreground="#34D399"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. Interactive Breathe Action Card -->
            <Button Grid.Row="3" Margin="0,0,0,8" HorizontalAlignment="Stretch" Height="36" Padding="0"
                    Background="#2034D399" BorderBrush="#3534D399" BorderThickness="1" CornerRadius="8"
                    Click="BreatheAction_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE735;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#34D399"/>
                    <TextBlock x:Name="LargeBreatheButtonText" Text="Start 1-Minute Mindful Breathing (4-7-8)" FontSize="11" FontWeight="SemiBold" Foreground="#34D399"/>
                </StackPanel>
            </Button>

            <!-- 5. Bottom Health Pill -->
            <Border Grid.Row="4" Background="#1534D399" CornerRadius="8" Padding="10,5,10,5">
                <Grid>
                    <TextBlock x:Name="LargeBottomSyncText" Text="Continuous Vitals Telemetry" FontSize="10" Foreground="#A7F3D0" HorizontalAlignment="Left"/>
                    <TextBlock Text="Smart Health Hub Sync" FontSize="10" Foreground="#34D399" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
