<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Daily_WinUI.DesktopWidgets.Views.DesktopSmokesWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Daily_WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <Style TargetType="controls:LungsControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:LungsControl">
                        <Canvas x:Name="PART_Canvas">
                            <Path x:Name="PART_LeftFill"       StrokeThickness="0" />
                            <Path x:Name="PART_RightFill"      StrokeThickness="0" />
                            <Path x:Name="PART_LeftOutline"    StrokeThickness="1.5" />
                            <Path x:Name="PART_RightOutline"   StrokeThickness="1.5" />
                            <Path x:Name="PART_Trachea"        StrokeThickness="1.5" Fill="Transparent" />
                            <Path x:Name="PART_LeftDivision"   StrokeThickness="1.0" Fill="Transparent" />
                            <Path x:Name="PART_RightDivision"  StrokeThickness="1.0" Fill="Transparent" />
                        </Canvas>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Padding="14,12,14,12">
        <!-- ── SMALL LAYOUT (170x170) ── -->
        <Grid x:Name="SmallLayout" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xEC2C;" FontFamily="{StaticResource TablerIconsFont}" FontSize="14" Foreground="#FB7185"/>
                <TextBlock Text="Smokes" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
            </StackPanel>

            <!-- Anatomical Lungs Vector & Smoked Count -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <controls:LungsControl x:Name="SmallLungsControl" Width="55" Height="65" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="SmallCountText" Text="0" FontSize="18" FontWeight="Bold" Foreground="#FFFFFFFF"/>
                    <TextBlock x:Name="SmallBaselineText" Text="of 40 smokes" FontSize="10" Foreground="#A0FFFFFF"/>
                    <TextBlock x:Name="SmallCravingText" Text="Free: All Day" FontSize="9" Foreground="#34D399" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Quick Log Buttons -->
            <Grid Grid.Row="2" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Height="26" Padding="0" HorizontalAlignment="Stretch"
                        Background="#20EF4444" BorderBrush="#35EF4444" BorderThickness="1" CornerRadius="6"
                        Click="LogCigarette_Click" ToolTipService.ToolTip="Log 1 Cigarette">
                    <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xECC4;" FontFamily="{StaticResource TablerIconsFont}" FontSize="10" Foreground="#FFEF4444"/>
                        <TextBlock Text="Cig" FontSize="10" FontWeight="Bold" Foreground="#FFEF4444"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Height="26" Padding="0" HorizontalAlignment="Stretch"
                        Background="#203B82F6" BorderBrush="#353B82F6" BorderThickness="1" CornerRadius="6"
                        Click="LogHeated_Click" ToolTipService.ToolTip="Log 1 Heated Tobacco">
                    <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE945;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#FF3B82F6"/>
                        <TextBlock Text="Heat" FontSize="10" FontWeight="Bold" Foreground="#FF3B82F6"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- ── MEDIUM LAYOUT (360x170) ── -->
        <Grid x:Name="MediumLayout" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="13" Background="#25FB7185">
                        <FontIcon Glyph="&#xEC2C;" FontFamily="{StaticResource TablerIconsFont}" FontSize="13" Foreground="#FB7185" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Smoke-Free &amp; Lungs" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                        <TextBlock x:Name="MediumCravingBadge" Text="Smoke-Free Today! 🌟" FontSize="10" Foreground="#34D399"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="MediumTotalCountText" Text="0" FontSize="16" FontWeight="Bold" Foreground="#FB7185"/>
                    <TextBlock x:Name="MediumBaselineText" Text="of 40 smokes" FontSize="11" Foreground="#80FFFFFF" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </StackPanel>
            </Grid>

            <!-- Center Content: Vector Lungs + Breakdown -->
            <Grid Grid.Row="1" Margin="0,6,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Anatomical Lungs Control -->
                <controls:LungsControl x:Name="MediumLungsControl" Width="70" Height="75" Margin="4,0,14,0" VerticalAlignment="Center"/>

                <!-- Stats & Breakdown -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock x:Name="HealthStatusText" Text="Optimal lung capacity (100%)" FontSize="12" FontWeight="SemiBold" Foreground="#34D399"/>

                    <!-- Cigarettes vs Heated Breakdown -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                        <Border Background="#15FB7185" CornerRadius="6" Padding="6,2,6,2">
                            <TextBlock x:Name="CigarettesCountText" Text="🚬 0 Cigarettes" FontSize="10" Foreground="#FB7185"/>
                        </Border>
                        <Border Background="#15F59E0B" CornerRadius="6" Padding="6,2,6,2">
                            <TextBlock x:Name="HeatedCountText" Text="🔥 0 Heated" FontSize="10" Foreground="#FBBF24"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Quick Action Logging Chips (Glance Parity: Cig & Heat) -->
            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Height="30" HorizontalAlignment="Stretch" Padding="0"
                        Background="#20EF4444" BorderBrush="#35EF4444" BorderThickness="1" CornerRadius="8"
                        Click="LogCigarette_Click" ToolTipService.ToolTip="Log 1 Cigarette">
                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xECC4;" FontFamily="{StaticResource TablerIconsFont}" FontSize="12" Foreground="#FFEF4444"/>
                        <TextBlock Text="Cig" FontSize="11" FontWeight="Bold" Foreground="#FFEF4444"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Height="30" HorizontalAlignment="Stretch" Padding="0"
                        Background="#203B82F6" BorderBrush="#353B82F6" BorderThickness="1" CornerRadius="8"
                        Click="LogHeated_Click" ToolTipService.ToolTip="Log 1 Heated Tobacco Stick">
                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE945;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#FF3B82F6"/>
                        <TextBlock Text="Heat" FontSize="11" FontWeight="Bold" Foreground="#FF3B82F6"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- ── LARGE LAYOUT (360x360) ── -->
        <Grid x:Name="LargeLayout" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="17" Background="#25FB7185">
                        <FontIcon Glyph="&#xEC2C;" FontFamily="{StaticResource TablerIconsFont}" FontSize="16" Foreground="#FB7185" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Respiratory &amp; Smoke-Free" FontSize="14" FontWeight="Bold" Foreground="#FFFFFFFF"/>
                        <TextBlock x:Name="LargeCravingBadge" Text="Smoke-Free Today! 🌟" FontSize="11" Foreground="#34D399"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="LargeTotalCountText" Text="0" FontSize="20" FontWeight="Bold" Foreground="#FB7185"/>
                    <TextBlock x:Name="LargeBaselineText" Text="of 40" FontSize="12" Foreground="#80FFFFFF" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </StackPanel>
            </Grid>

            <!-- 2. Anatomical Lungs Control & Recovery Status -->
            <Border Grid.Row="1" Background="#10FFFFFF" CornerRadius="10" Padding="12,10,12,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <controls:LungsControl x:Name="LargeLungsControl" Width="80" Height="85" Margin="4,0,14,0" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="LargeHealthStatusText" Text="Optimal lung capacity (100%)" FontSize="12" FontWeight="SemiBold" Foreground="#34D399"/>
                        <TextBlock x:Name="LargeRecoveryDetail" Text="Cilia regeneration active · Alveolar oxygen exchange normalized." FontSize="10" Foreground="#A0FFFFFF" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. 4-Card Breakdown Grid (Cigarettes, Heated, Money Saved, Nicotine Load) -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Margin="0,0,4,6" Background="#15FFFFFF" CornerRadius="10" Padding="10,6,10,6">
                    <StackPanel Spacing="2">
                        <TextBlock Text="CIGARETTES" FontSize="9" FontWeight="SemiBold" Foreground="#80FFFFFF"/>
                        <TextBlock x:Name="LargeCigarettesText" Text="🚬 0 logged" FontSize="13" FontWeight="Bold" Foreground="#FB7185"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Margin="4,0,0,6" Background="#15FFFFFF" CornerRadius="10" Padding="10,6,10,6">
                    <StackPanel Spacing="2">
                        <TextBlock Text="HEATED TOBACCO" FontSize="9" FontWeight="SemiBold" Foreground="#80FFFFFF"/>
                        <TextBlock x:Name="LargeHeatedText" Text="🔥 0 logged" FontSize="13" FontWeight="Bold" Foreground="#FBBF24"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Margin="0,0,4,0" Background="#15FFFFFF" CornerRadius="10" Padding="10,6,10,6">
                    <StackPanel Spacing="2">
                        <TextBlock Text="FINANCIAL BENEFIT" FontSize="9" FontWeight="SemiBold" Foreground="#80FFFFFF"/>
                        <TextBlock x:Name="LargeMoneySavedText" Text="+25.0 Lei saved" FontSize="13" FontWeight="Bold" Foreground="#34D399"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Margin="4,0,0,0" Background="#15FFFFFF" CornerRadius="10" Padding="10,6,10,6">
                    <StackPanel Spacing="2">
                        <TextBlock Text="LIFE REGAINED" FontSize="9" FontWeight="SemiBold" Foreground="#80FFFFFF"/>
                        <TextBlock x:Name="LargeLifeRegainedText" Text="+4h 20m life" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. Quick Action Logging Chips (Cigarette, Heated, Undo) -->
            <Grid Grid.Row="3" Margin="0,0,0,8" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Height="32" HorizontalAlignment="Stretch" Padding="0"
                        Background="#20EF4444" BorderBrush="#35EF4444" BorderThickness="1" CornerRadius="8"
                        Click="LogCigarette_Click" ToolTipService.ToolTip="Log 1 Cigarette">
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xECC4;" FontFamily="{StaticResource TablerIconsFont}" FontSize="11" Foreground="#FFEF4444"/>
                        <TextBlock Text="+1 Cig" FontSize="11" FontWeight="Bold" Foreground="#FFEF4444"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Height="32" HorizontalAlignment="Stretch" Padding="0"
                        Background="#203B82F6" BorderBrush="#353B82F6" BorderThickness="1" CornerRadius="8"
                        Click="LogHeated_Click" ToolTipService.ToolTip="Log 1 Heated Tobacco Stick">
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE945;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#FF3B82F6"/>
                        <TextBlock Text="+1 Heat" FontSize="11" FontWeight="Bold" Foreground="#FF3B82F6"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Height="32" HorizontalAlignment="Stretch" Padding="0"
                        Background="#15FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="8"
                        Click="UndoLastSmoke_Click" ToolTipService.ToolTip="Undo Last Smoke">
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE7A7;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#A0FFFFFF"/>
                        <TextBlock Text="Undo" FontSize="11" FontWeight="SemiBold" Foreground="#A0FFFFFF"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 5. Bottom Status Pill -->
            <Border Grid.Row="4" Background="#15FB7185" CornerRadius="8" Padding="10,5,10,5">
                <Grid>
                    <TextBlock x:Name="LargeBottomStreakText" Text="Continuous Habit Parity" FontSize="10" Foreground="#FDA4AF" HorizontalAlignment="Left"/>
                    <TextBlock Text="Daily Smartwatch Sync" FontSize="10" Foreground="#FB7185" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
