<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Daily_WinUI.DesktopWidgets.Views.DesktopBubblesWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded">

    <Grid Padding="14,12,14,12">
        <!-- ── SMALL LAYOUT (170x170) ── -->
        <Grid x:Name="SmallLayout" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xEB42;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#38BDF8"/>
                <TextBlock Text="Hydration" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
            </StackPanel>

            <!-- Progress Ring & Value -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="72" Height="72">
                <ProgressRing x:Name="SmallProgressRing" Width="72" Height="72" Value="0" Maximum="100" IsIndeterminate="False"
                              Foreground="#38BDF8" Background="#2038BDF8" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="SmallPercentText" Text="0%" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FFFFFFFF"/>
                    <TextBlock x:Name="SmallAmountText" Text="0 ml" FontSize="10" Foreground="#A0FFFFFF" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Quick Action Buttons -->
            <Grid Grid.Row="2" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Height="26" Padding="0" HorizontalAlignment="Stretch"
                        Background="#26F59E0B" BorderBrush="#4DF59E0B" BorderThickness="1" CornerRadius="6"
                        Click="LogCoffee100_Click" ToolTipService.ToolTip="100 ml Coffee">
                    <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE706;" FontFamily="Segoe Fluent Icons" FontSize="9" Foreground="#FFF59E0B"/>
                        <TextBlock Text="100" FontSize="10" FontWeight="Bold" Foreground="#FFF59E0B"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Height="26" Padding="0" HorizontalAlignment="Stretch"
                        Background="#2400E5FF" BorderBrush="#4800E5FF" BorderThickness="1" CornerRadius="6"
                        Click="LogWater150_Click" ToolTipService.ToolTip="150 ml Water">
                    <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xEB42;" FontFamily="Segoe Fluent Icons" FontSize="9" Foreground="#FF00E5FF"/>
                        <TextBlock Text="150" FontSize="10" FontWeight="Bold" Foreground="#FF00E5FF"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Height="26" Padding="0" HorizontalAlignment="Stretch"
                        Background="#2400E5FF" BorderBrush="#4800E5FF" BorderThickness="1" CornerRadius="6"
                        Click="LogWater300_Click" ToolTipService.ToolTip="300 ml Water">
                    <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xEB42;" FontFamily="Segoe Fluent Icons" FontSize="9" Foreground="#FF00E5FF"/>
                        <TextBlock Text="300" FontSize="10" FontWeight="Bold" Foreground="#FF00E5FF"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- ── MEDIUM & LARGE LAYOUT (360x170 / 360x360) ── -->
        <Grid x:Name="MediumLargeLayout" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="13" Background="#2538BDF8">
                        <FontIcon Glyph="&#xEB42;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Hydration &amp; Bubbles" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                        <TextBlock x:Name="MediumSubtitleText" Text="Goal: 2,500 ml" FontSize="10" Foreground="#80FFFFFF"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="MediumPercentBadge" Text="0%" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Center Content: Progress and Metrics -->
            <Grid Grid.Row="1" Margin="0,8,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Circular Progress Ring -->
                <Grid Width="70" Height="70" Margin="4,0,14,0" VerticalAlignment="Center">
                    <ProgressRing x:Name="MediumProgressRing" Width="70" Height="70" Value="0" Maximum="100" IsIndeterminate="False"
                                  Foreground="#38BDF8" Background="#2038BDF8" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEB42;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Metrics & Drink Breakdown -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="CurrentIntakeText" Text="0" FontSize="20" FontWeight="Bold" Foreground="#FFFFFFFF"/>
                        <TextBlock Text="ml logged today" FontSize="12" Foreground="#90FFFFFF" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                    </StackPanel>

                    <!-- Breakdown Chips -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                        <Border Background="#1538BDF8" CornerRadius="6" Padding="6,2,6,2">
                            <TextBlock x:Name="WaterAmountText" Text="💧 0 ml" FontSize="10" Foreground="#38BDF8"/>
                        </Border>
                        <Border Background="#15EAB308" CornerRadius="6" Padding="6,2,6,2">
                            <TextBlock x:Name="CoffeeAmountText" Text="☕ 0 ml" FontSize="10" Foreground="#FBBF24"/>
                        </Border>
                        <Border Background="#1522C55E" CornerRadius="6" Padding="6,2,6,2">
                            <TextBlock x:Name="TeaAmountText" Text="🍵 0 ml" FontSize="10" Foreground="#4ADE80"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Quick Action Logging Chips (Parity: Coffee 100ml, Small Water 150ml, Large Water 300ml) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Margin="0,0,4,0" Height="30" HorizontalAlignment="Stretch" Padding="0"
                        Background="#26F59E0B" BorderBrush="#4DF59E0B" BorderThickness="1" CornerRadius="8"
                        Click="LogCoffee100_Click" ToolTipService.ToolTip="Log 100 ml Coffee">
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE706;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#FFF59E0B"/>
                        <TextBlock Text="100 ml" FontSize="11" FontWeight="SemiBold" Foreground="#FFF59E0B"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Margin="2,0,2,0" Height="30" HorizontalAlignment="Stretch" Padding="0"
                        Background="#2400E5FF" BorderBrush="#4800E5FF" BorderThickness="1" CornerRadius="8"
                        Click="LogWater150_Click" ToolTipService.ToolTip="Log 150 ml Water">
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xEB42;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#FF00E5FF"/>
                        <TextBlock Text="150 ml" FontSize="11" FontWeight="SemiBold" Foreground="#FF00E5FF"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Margin="4,0,0,0" Height="30" HorizontalAlignment="Stretch" Padding="0"
                        Background="#2400E5FF" BorderBrush="#4800E5FF" BorderThickness="1" CornerRadius="8"
                        Click="LogWater300_Click" ToolTipService.ToolTip="Log 300 ml Water">
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xEB42;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#FF00E5FF"/>
                        <TextBlock Text="300 ml" FontSize="11" FontWeight="SemiBold" Foreground="#FF00E5FF"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
