<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Daily_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Daily_WinUI"
    xmlns:controls="using:Daily_WinUI.Controls"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DayOne"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <Grid.Resources>
            <!-- Smooth cosmic breathing and floating animation for Orbit Icon -->
            <Storyboard x:Name="LoadingStoryboard" RepeatBehavior="Forever">
                <!-- Icon Translation Y (gentle float) -->
                <DoubleAnimation Storyboard.TargetName="IconTranslate" Storyboard.TargetProperty="Y"
                                 From="0" To="-8" Duration="0:0:1.8" AutoReverse="True">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>

                <!-- Icon Scale X & Y (gentle pulse) -->
                <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX"
                                 From="1.0" To="1.035" Duration="0:0:1.8" AutoReverse="True">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY"
                                 From="1.0" To="1.035" Duration="0:0:1.8" AutoReverse="True">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>

                <!-- Shadow Scale & Opacity (softens as icon floats up) -->
                <DoubleAnimation Storyboard.TargetName="ShadowScale" Storyboard.TargetProperty="ScaleX"
                                 From="1.0" To="0.85" Duration="0:0:1.8" AutoReverse="True">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="LoadingShadow" Storyboard.TargetProperty="Opacity"
                                 From="0.45" To="0.25" Duration="0:0:1.8" AutoReverse="True">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>

                <!-- Glow Scale & Opacity (luminous cosmic aura) -->
                <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleX"
                                 From="1.0" To="1.2" Duration="0:0:1.8" AutoReverse="True">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleY"
                                 From="1.0" To="1.2" Duration="0:0:1.8" AutoReverse="True">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="LoadingGlow" Storyboard.TargetProperty="Opacity"
                                 From="0.35" To="0.75" Duration="0:0:1.8" AutoReverse="True">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>

                <!-- Text Opacity Pulse -->
                <DoubleAnimation Storyboard.TargetName="LoadingText" Storyboard.TargetProperty="Opacity"
                                 From="0.65" To="0.95" Duration="0:0:1.8" AutoReverse="True">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Name="FadeOutStoryboard">
                <!-- Fade out the LoadingOverlay -->
                <DoubleAnimation Storyboard.TargetName="LoadingOverlay"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1.0" To="0.0"
                                 Duration="0:0:0.7">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>

                <!-- Scale up the LoadingOverlay background slightly as it expands away -->
                <DoubleAnimation Storyboard.TargetName="OverlayScale"
                                 Storyboard.TargetProperty="ScaleX"
                                 From="1.0" To="1.05"
                                 Duration="0:0:0.7">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="OverlayScale"
                                 Storyboard.TargetProperty="ScaleY"
                                 From="1.0" To="1.05"
                                 Duration="0:0:0.7">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>

                <!-- Scale down the central loading elements (icon, text, glow, shadow) to recede -->
                <DoubleAnimation Storyboard.TargetName="ContentPanelScale"
                                 Storyboard.TargetProperty="ScaleX"
                                 From="1.0" To="0.75"
                                 Duration="0:0:0.7">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="ContentPanelScale"
                                 Storyboard.TargetProperty="ScaleY"
                                 From="1.0" To="0.75"
                                 Duration="0:0:0.7">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>



                <!-- Fade in the RootFrame -->
                <DoubleAnimation Storyboard.TargetName="RootFrame"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0.0" To="1.0"
                                 Duration="0:0:0.7">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- High-performance hardware-accelerated Mica system backdrop -->

        <!-- Custom TitleBar Grid bypassing the buggy TitleBar control entirely -->
        <Grid x:Name="AppTitleBar" Background="Transparent" VerticalAlignment="Top" SizeChanged="AppTitleBar_SizeChanged" Opacity="0.0" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /> <!-- 0: Sidebar Toggle -->
                <ColumnDefinition Width="Auto" /> <!-- 1: Refresh Button (DayOne) -->
                <ColumnDefinition Width="Auto" /> <!-- 2: Date -->
                <ColumnDefinition Width="*" />    <!-- 3: Spacer -->
                <ColumnDefinition Width="Auto" /> <!-- 4: Right Buttons -->
                <ColumnDefinition x:Name="RightPaddingColumn" Width="140" /> <!-- 5: System Caption Buttons Area -->
            </Grid.ColumnDefinitions>

            <!-- Sidebar Toggle button -->
            <Button x:Name="TitleBarSidebarToggle"
                    Grid.Column="0"
                    Background="Transparent" BorderThickness="0"
                    CornerRadius="0" Padding="10,0"
                    VerticalAlignment="Stretch"
                    Click="TitleBarSidebarToggle_Click"
                    ToolTipService.ToolTip="Toggle Sidebar (Ctrl+S)">
                <FontIcon Glyph="&#xE700;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
            </Button>

            <!-- DayOne refresh button (replaces static icon + title) -->
            <Button x:Name="TitleBarRefreshButton"
                    Grid.Column="1"
                    Background="Transparent" BorderThickness="0"
                    CornerRadius="0" Padding="10,0"
                    VerticalAlignment="Stretch"
                    Click="TitleBarRefresh_Click"
                    ToolTipService.ToolTip="Refresh dashboard (Ctrl+R)">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Width="16" Height="16" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Image.Source>
                            <BitmapImage UriSource="ms-appx:///Assets/OrbitIcon-Unplated-32.png" DecodePixelWidth="32" DecodePixelHeight="32"/>
                        </Image.Source>
                    </Image>
                    <TextBlock Text="DayOne" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Date text, immediately following the App Title -->
            <TextBlock x:Name="TitleBarDateText"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Opacity="0.6"
                       Margin="12,0,0,0"
                       IsHitTestVisible="False"/>

            <!-- Right side: Theme toggle and User account -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="0" VerticalAlignment="Stretch">

                <!-- Theme toggle -->
                <Button x:Name="TitleBarThemeButton"
                        Background="Transparent" BorderThickness="0"
                        CornerRadius="0" Padding="10,0"
                        VerticalAlignment="Stretch"
                        Click="TitleBarTheme_Click"
                        ToolTipService.ToolTip="Toggle light/dark theme">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon x:Name="TitleBarThemeIcon" Glyph="&#xE708;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
                    </StackPanel>
                </Button>

                <!-- Settings -->
                <Button x:Name="TitleBarSettingsButton"
                        Background="Transparent" BorderThickness="0"
                        CornerRadius="0" Padding="10,0"
                        VerticalAlignment="Stretch"
                        Click="TitleBarSettings_Click"
                        ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                </Button>

                <!-- Smart Briefing -->
                <Button x:Name="TitleBarBriefingButton"
                        Background="Transparent" BorderThickness="0"
                        CornerRadius="0" Padding="10,0"
                        VerticalAlignment="Stretch"
                        Click="TitleBarBriefing_Click"
                        ToolTipService.ToolTip="Smart Briefing">
                    <FontIcon Glyph="&#xE82F;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                </Button>

                <!-- User account -->
                <Button x:Name="TitleBarAccountButton"
                        Background="Transparent" BorderThickness="0"
                        CornerRadius="0" Padding="10,0"
                        VerticalAlignment="Stretch"
                        ToolTipService.ToolTip="Account">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PersonPicture x:Name="TitleBarUserAvatar" Width="22" Height="22" DisplayName="?" />
                        <TextBlock x:Name="TitleBarUserEmailText"
                                   Text="Not signed in" FontSize="11"
                                   VerticalAlignment="Center" MaxWidth="130"
                                   TextTrimming="CharacterEllipsis" Opacity="0.8"/>
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="TitleBarAuthItem" Text="Sign In" Click="TitleBarAuth_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon x:Name="TitleBarAuthIcon" Glyph="&#xE77B;" FontFamily="Segoe Fluent Icons"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Window Docking & Layout Options -->
                <Button x:Name="TitleBarDockButton"
                        Background="Transparent" BorderThickness="0"
                        CornerRadius="0" Padding="10,0"
                        VerticalAlignment="Stretch"
                        ToolTipService.ToolTip="Window layout options">
                    <FontIcon Glyph="&#xE952;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Float Center (Default)" Click="DockNormal_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE73F;" FontFamily="Segoe Fluent Icons"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Dock Left" Click="DockLeft_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE90C;" FontFamily="Segoe Fluent Icons"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Dock Right" Click="DockRight_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE90D;" FontFamily="Segoe Fluent Icons"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

            </StackPanel>
        </Grid>

        <!--
            Main Application Layout: Collapsible Desktop Sidebar + Navigation Frame + Floating Glass Capsule
        -->
        <Grid Grid.Row="1" x:Name="MainContentGrid">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Modifiers="Control" Key="Number1" Invoked="OnAcceleratorCtrl1" />
                <KeyboardAccelerator Modifiers="Control" Key="Number2" Invoked="OnAcceleratorCtrl2" />
                <KeyboardAccelerator Modifiers="Control" Key="Number3" Invoked="OnAcceleratorCtrl3" />
                <KeyboardAccelerator Modifiers="Control" Key="Number4" Invoked="OnAcceleratorCtrl4" />
                <KeyboardAccelerator Modifiers="Control" Key="Number5" Invoked="OnAcceleratorCtrl5" />
                <KeyboardAccelerator Modifiers="Control" Key="Number6" Invoked="OnAcceleratorCtrl6" />
                <KeyboardAccelerator Modifiers="Control" Key="Number7" Invoked="OnAcceleratorCtrl7" />
                <KeyboardAccelerator Modifiers="Control" Key="Number8" Invoked="OnAcceleratorCtrl8" />
                <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="OnAcceleratorCtrlS" />
                <KeyboardAccelerator Modifiers="Control" Key="R" Invoked="OnAcceleratorCtrlR" />
                <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="OnAcceleratorCtrlN" />
            </Grid.KeyboardAccelerators>

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Collapsible Modern Desktop Sidebar (Ctrl+S) -->
            <controls:DesktopSidebarView x:Name="AppSidebar" Grid.Column="0" Visibility="Collapsed"
                                         TabSelected="OnSidebarTabSelected"
                                         CollapseRequested="OnSidebarCollapseRequested"
                                         SyncRequested="OnSidebarSyncRequested"
                                         SettingsRequested="OnSidebarSettingsRequested" />

            <!-- Central Content Area -->
            <Grid Grid.Column="1">
                <Frame x:Name="RootFrame" x:FieldModifier="public" Opacity="0.0" />

                <!-- Floating Liquid Glass Navigation Capsule (Docked at bottom) -->
                <controls:FloatingGlassCapsule x:Name="NavCapsule"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,0,24"
                                               Canvas.ZIndex="1000"
                                               IsHitTestVisible="True"
                                               TabSelected="OnCapsuleTabSelected" />
            </Grid>
        </Grid>

        <!-- Full-screen Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Background="{ThemeResource LoadingOverlayBgBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.RowSpan="2" Canvas.ZIndex="9999" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="OverlayScale" ScaleX="1.0" ScaleY="1.0" />
            </Grid.RenderTransform>
            <StackPanel x:Name="LoadingContentPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0" RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <ScaleTransform x:Name="ContentPanelScale" ScaleX="1.0" ScaleY="1.0" />
                </StackPanel.RenderTransform>
                <!-- Container for the icon to keep it positioned relative to the ground -->
                <Grid Height="120" Width="120" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Height="80" Width="80" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                        <Image x:Name="LoadingGemIcon" Width="80" Height="80" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,1.0">
                            <Image.Source>
                                <BitmapImage UriSource="ms-appx:///Assets/OrbitIcon-256.png" DecodePixelWidth="256" DecodePixelHeight="256"/>
                            </Image.Source>
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="IconScale" ScaleX="1.0" ScaleY="1.0" />
                                    <TranslateTransform x:Name="IconTranslate" Y="0" />
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>

                        <!-- Glowing show lights aura over the icon -->
                        <Ellipse x:Name="LoadingGlow" Width="140" Height="140" Fill="{ThemeResource LoadingGlowBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-30" RenderTransformOrigin="0.5,0.5" Opacity="0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="GlowScale" ScaleX="1.0" ScaleY="1.0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                </Grid>
                <!-- Shadow sits on the ground below the grid container -->
                <Ellipse x:Name="LoadingShadow" Width="64" Height="8" Fill="Black" Opacity="0.4" HorizontalAlignment="Center" Margin="0,8,0,0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="ShadowScale" ScaleX="1.0" ScaleY="1.0" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <TextBlock x:Name="LoadingText" Text="Loading your day..." Foreground="{ThemeResource AppFgColorBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,24,0,0" Opacity="0.75" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="TextScale" ScaleX="1.0" ScaleY="1.0" />
                            <SkewTransform x:Name="TextSkew" AngleX="0" AngleY="0" />
                            <TranslateTransform x:Name="TextTranslate" Y="0" />
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- System Tray Icon -->
        <tb:TaskbarIcon x:Name="TrayIcon" ToolTipText="DayOne">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Show DayOne" Click="TrayShow_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE737;" FontFamily="Segoe Fluent Icons" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Force Sync" Click="TitleBarRefresh_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit" Click="TrayExit_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE711;" FontFamily="Segoe Fluent Icons" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
