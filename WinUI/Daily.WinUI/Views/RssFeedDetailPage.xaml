<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Daily_WinUI.Views.RssFeedDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Daily_WinUI.ViewModels"
    xmlns:models="using:Daily.Models"
    xmlns:converters="using:Daily_WinUI.Converters"
    mc:Ignorable="d"
    SizeChanged="Page_SizeChanged"
    Background="Transparent">

    <Page.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- Dark navy background matching MainPage -->
        <LinearGradientBrush x:Key="RssPageBgBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF0B1121" Offset="0" />
            <GradientStop Color="#FF0B1121" Offset="0.35" />
            <GradientStop Color="#820B1121" Offset="0.65" />
            <GradientStop Color="#600B1121" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RssArtOverlayBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#000B1121" Offset="0" />
            <GradientStop Color="#FF0B1121" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="SourceItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid Background="Transparent">
                            <!-- Base Glass Pill -->
                            <Border x:Name="Pill" 
                                    Background="{ThemeResource AppGlassColorBrush}" 
                                    BorderBrush="{ThemeResource AppGlassBorderColorBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="16" 
                                    Padding="12,6"
                                    Margin="2"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="PillScale" ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>
                                <ContentPresenter x:Name="ContentPresenter"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Pill.Background" Value="#30FFFFFF"/>
                                            <Setter Target="Pill.BorderBrush" Value="#60FFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="PillScale.ScaleX" Value="0.95"/>
                                            <Setter Target="PillScale.ScaleY" Value="0.95"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualState x:Name="Unselected"/>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="Pill.Background" Value="{ThemeResource SystemControlForegroundAccentBrush}"/>
                                            <Setter Target="Pill.BorderBrush" Value="{ThemeResource SystemControlForegroundAccentBrush}"/>
                                            <Setter Target="Pill.Translation" Value="0,0,4"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="White"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="SelectedUnfocused">
                                        <VisualState.Setters>
                                            <Setter Target="Pill.Background" Value="{ThemeResource SystemControlForegroundAccentBrush}"/>
                                            <Setter Target="Pill.BorderBrush" Value="{ThemeResource SystemControlForegroundAccentBrush}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="White"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RssItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ListViewItemPresenter
                            ContentMargin="0"
                            PointerOverBackground="Transparent"
                            SelectedBackground="Transparent"
                            PressedBackground="Transparent"
                            SelectedPointerOverBackground="Transparent"
                            SelectedPressedBackground="Transparent"
                            FocusBorderBrush="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RssItemTemplate" x:DataType="vm:RssItemViewModel">
            <Border Background="{ThemeResource AppGlassColorBrush}"
                    BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                    BorderThickness="1"
                    Style="{StaticResource GlassPanelStyle}" Translation="0,0,18"
                    CornerRadius="18"
                    Padding="20"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Article Thumbnail -->
                    <Border Width="200" Height="130" CornerRadius="10" Background="{ThemeResource AppGlassSubColorBrush}">
                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource AppFgColorBrush}"
                                   TextWrapping="Wrap"
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,12" Spacing="8" VerticalAlignment="Center">
                            <!-- Publication Logo circular badge -->
                            <Border Width="18" Height="18" CornerRadius="9" Background="White" Padding="1" VerticalAlignment="Center">
                                <Image Source="{Binding PublicationIconUrl}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding PublicationName}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppFgColorBrush}"
                                       VerticalAlignment="Center"/>

                            <!-- Variant A: Ultra-Discreet Source Bias & Factuality Micro-Pill -->
                            <Button Click="CardOutletBadge_Click"
                                    Visibility="{Binding HasOutletBadge, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="{Binding OutletBadgeBackground}"
                                    BorderThickness="0"
                                    CornerRadius="9"
                                    Padding="7,2"
                                    MinHeight="0"
                                    MinWidth="0"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="View Source Transparency (Bias, Factuality &amp; Ownership)">
                                <TextBlock Text="{Binding OutletBadgeText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding OutletBadgeForeground}"/>
                            </Button>

                            <!-- Non-Standard Framing Tag (Opinion / Investigation / Analysis / Sensational) -->
                            <Border Visibility="{Binding HasFramingBadge, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="#22FFFFFF"
                                    CornerRadius="8"
                                    Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding FramingBadgeText}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding FramingBadgeForeground}"/>
                            </Border>

                            <TextBlock Text="•" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PublishDate}"
                                       FontSize="13"
                                       Foreground="{ThemeResource AppFgMutedColorBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="•" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center"/>
                            <FontIcon Glyph="&#xEB4D;" FontFamily="{StaticResource TablerIconsFont}" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Author}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{ThemeResource AppFgMutedColorBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Description}"
                                   FontSize="15"
                                   Foreground="{ThemeResource AppFgColorBrush}"
                                   TextWrapping="Wrap"
                                   MaxLines="3"
                                   TextTrimming="CharacterEllipsis"
                                   LineHeight="22"/>

                        <!-- Variant A: Conditional Multi-Source Bias Spectrum Bar (shown ONLY when >= 2 outlets cover story) -->
                        <Grid Visibility="{Binding HasMultipleSources, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center" Margin="0,0,16,0">
                                <Border CornerRadius="3" Height="6" Background="#22FFFFFF">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding LeftStarWidth}"/>
                                            <ColumnDefinition Width="{Binding CenterStarWidth}"/>
                                            <ColumnDefinition Width="{Binding RightStarWidth}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#FF3B82F6"/>
                                        <Border Grid.Column="1" Background="#FF94A3B8"/>
                                        <Border Grid.Column="2" Background="#FFF43F5E"/>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BiasSummaryLabel}"
                                               FontSize="11"
                                               Foreground="{ThemeResource AppFgMutedColorBrush}"
                                               VerticalAlignment="Center"/>
                                    <Border Visibility="{Binding HasBlindspot, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Background="#33F59E0B"
                                            BorderBrush="#66F59E0B"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="6,1">
                                        <TextBlock Text="{Binding BlindspotBadgeText}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFBBF24"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Click="CardPerspectivesButton_Click"
                                    Background="#2438BDF8"
                                    BorderBrush="#5538BDF8"
                                    BorderThickness="1"
                                    CornerRadius="13"
                                    Padding="11,4"
                                    MinHeight="0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding PerspectivesPillLabel}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#FF38BDF8"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Quick Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="12" VerticalAlignment="Center" Margin="20,0,0,0">
                        <!-- Favorite Button -->
                        <Button Click="FavoriteButton_Click"
                                Width="38" Height="38" 
                                CornerRadius="19"
                                Background="{ThemeResource AppGlassSubColorBrush}"
                                BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                                BorderThickness="1"
                                Padding="0"
                                ToolTipService.ToolTip="Toggle Favorite">
                            <FontIcon Glyph="{Binding FavoriteGlyph}" 
                                      FontFamily="Segoe Fluent Icons" 
                                      FontSize="16" 
                                      Foreground="{Binding FavoriteBrush}"/>
                        </Button>

                        <!-- Read Later Button -->
                        <Button Click="ReadLaterButton_Click"
                                Width="38" Height="38" 
                                CornerRadius="19"
                                Background="{ThemeResource AppGlassSubColorBrush}"
                                BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                                BorderThickness="1"
                                Padding="0"
                                ToolTipService.ToolTip="Toggle Read Later">
                            <FontIcon Glyph="{Binding ReadLaterGlyph}" 
                                      FontFamily="Segoe Fluent Icons" 
                                      FontSize="16" 
                                      Foreground="{Binding ReadLaterBrush}"/>
                        </Button>

                        <!-- Subscribe to Author / Publication Button -->
                        <Button Click="SubscribeAuthorButton_Click"
                                Width="38" Height="38" 
                                CornerRadius="19"
                                Background="{ThemeResource AppGlassSubColorBrush}"
                                BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                                BorderThickness="1"
                                Padding="0"
                                ToolTipService.ToolTip="Subscribe to Author / Publication"
                                Visibility="{Binding CanSubscribe, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE710;" 
                                      FontFamily="Segoe Fluent Icons" 
                                      FontSize="16" 
                                      Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="StoryClusterTemplate" x:DataType="vm:StoryClusterCardViewModel">
            <Border Background="{ThemeResource AppGlassColorBrush}"
                    BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                    BorderThickness="1"
                    Style="{StaticResource GlassPanelStyle}" Translation="0,0,18"
                    CornerRadius="18"
                    Padding="20"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Stretch">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Visibility="{Binding HasHeroImage, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Width="168" Height="110"
                            CornerRadius="10"
                            Background="{ThemeResource AppGlassSubColorBrush}">
                        <Image Source="{Binding HeroImageUrl}" Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="#2438BDF8" CornerRadius="9" Padding="8,2">
                                <TextBlock Text="{Binding UniqueOutletCountLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#FF38BDF8"/>
                            </Border>
                            <Border Visibility="{Binding HasBlindspot, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="#33F59E0B"
                                    BorderBrush="#66F59E0B"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="8,2">
                                <TextBlock Text="{Binding BlindspotBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#FFFBBF24"/>
                            </Border>
                            <TextBlock Text="{Binding LatestPublishedText}" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="{Binding CanonicalTitle}"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource AppFgColorBrush}"
                                   TextWrapping="Wrap"
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis"/>

                        <Border CornerRadius="4" Height="7" Background="#22FFFFFF" Margin="0,2,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding LeftStarWidth}"/>
                                    <ColumnDefinition Width="{Binding CenterStarWidth}"/>
                                    <ColumnDefinition Width="{Binding RightStarWidth}"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#FF3B82F6"/>
                                <Border Grid.Column="1" Background="#FF94A3B8"/>
                                <Border Grid.Column="2" Background="#FFF43F5E"/>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding BiasSummaryLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding TopOutletsSummary}" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        </Grid>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Click="ClusterCompareButton_Click"
                            Background="#2438BDF8"
                            BorderBrush="#5538BDF8"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="14,8"
                            VerticalAlignment="Center">
                        <TextBlock Text="Compare →" FontSize="13" FontWeight="SemiBold" Foreground="#FF38BDF8"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="Transparent">
        <!-- State 1: List View -->
        <Grid x:Name="ListViewContainer" Visibility="Visible">
            <!-- Centered Header Subtitle / Description -->
            <TextBlock x:Name="RssSubtitleTextBlock" 
                       Text="Latest articles from your selected feed" 
                       FontSize="13" 
                       Foreground="{ThemeResource AppFgMutedColorBrush}" 
                       Opacity="0.6"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Top" 
                       Margin="0,22,0,0"
                       IsHitTestVisible="False"/>

            <!-- Scrollable content: article lists within Pivot tabs -->
            <Pivot x:Name="RssPivot" Margin="20,0,0,0" SelectionChanged="RssPivot_SelectionChanged">
                <Pivot.Resources>
                    <Thickness x:Key="PivotItemMargin">0</Thickness>
                </Pivot.Resources>
                <Pivot.LeftHeader>
                    <Button x:Name="ListViewBackButton" Click="ListViewBackButton_Click" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="18" Width="36" Height="36" Padding="0" Margin="0,0,12,0" VerticalAlignment="Center" ToolTipService.ToolTip="Back to Dashboard">
                        <FontIcon Glyph="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{ThemeResource AppFgColorBrush}"/>
                    </Button>
                </Pivot.LeftHeader>
                <Pivot.RightHeader>
                    <!-- Spin-Wheel Selection Control -->
                    <StackPanel x:Name="FeedSelectorContainer" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,12,20,12">
                        <!-- Article Search Box -->
                        <AutoSuggestBox x:Name="ArticleSearchBox"
                                        PlaceholderText="Search articles..."
                                        Width="200"
                                        QueryIcon="Find"
                                        Height="36"
                                        CornerRadius="18"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"
                                        Background="{ThemeResource AppGlassColorBrush}"
                                        BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                                        BorderThickness="1"
                                        TextChanged="ArticleSearchBox_TextChanged"
                                        QuerySubmitted="ArticleSearchBox_QuerySubmitted"/>

                        <!-- Cycle Left Button -->
                        <Button x:Name="CycleLeftButton" 
                                Click="CycleLeftButton_Click"
                                Background="Transparent" BorderThickness="0"
                                Width="32" Height="36" Padding="0"
                                ToolTipService.ToolTip="Previous Feed">
                            <FontIcon Glyph="&#xE76B;" FontSize="12" Foreground="{ThemeResource AppFgColorBrush}"/>
                        </Button>

                        <!-- Center Feed Selector Button -->
                        <Button x:Name="FeedSelectorButton"
                                Background="{ThemeResource AppGlassColorBrush}" 
                                BorderBrush="{ThemeResource AppGlassBorderColorBrush}" 
                                BorderThickness="1" 
                                CornerRadius="16"
                                Height="36" Padding="12,0"
                                ToolTipService.ToolTip="Select Feed">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid Width="18" Height="18" VerticalAlignment="Center">
                                    <Border x:Name="SelectedFeedIconBorder" Width="18" Height="18" CornerRadius="9" Background="White" Padding="1">
                                        <Image x:Name="SelectedFeedIcon" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" ImageFailed="SelectedFeedIcon_ImageFailed"/>
                                    </Border>
                                    <FontIcon x:Name="SelectedFeedFontIcon" Glyph="&#xEAFD;" FontFamily="{StaticResource TablerIconsFont}" FontSize="14" Foreground="{ThemeResource AppFgColorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                                <TextBlock x:Name="SelectedFeedText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource AppFgColorBrush}" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            
                            <Button.Flyout>
                                <MenuFlyout x:Name="FeedMenuFlyout" Placement="Bottom"/>
                            </Button.Flyout>
                        </Button>

                        <!-- Cycle Right Button -->
                        <Button x:Name="CycleRightButton" 
                                Click="CycleRightButton_Click"
                                Background="Transparent" BorderThickness="0"
                                Width="32" Height="36" Padding="0"
                                ToolTipService.ToolTip="Next Feed">
                            <FontIcon Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource AppFgColorBrush}"/>
                        </Button>

                        <!-- Media Diet Analytics Button -->
                        <Button x:Name="MediaDietButton" Click="MediaDietButton_Click" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="18" Width="36" Height="36" Padding="0" Margin="6,0,0,0" ToolTipService.ToolTip="Media Diet &amp; Spectrum Balance">
                            <FontIcon Glyph="&#xEB05;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#FF38BDF8"/>
                        </Button>

                        <!-- Pop-out Window Button -->
                        <Button x:Name="ListViewPopOutButton" Click="PopOutButton_Click" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="18" Width="36" Height="36" Padding="0" Margin="6,0,0,0" ToolTipService.ToolTip="Pop out to separate window">
                            <FontIcon Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{ThemeResource AppFgColorBrush}"/>
                        </Button>
                    </StackPanel>
                </Pivot.RightHeader>
                <!-- Tab 1: Live Feed -->
                <PivotItem>
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Live Feed" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" MinWidth="20" Height="20" Padding="6,0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Articles.Count, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </PivotItem.Header>
                    <Grid>
                        <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                            <ProgressRing IsActive="True" Width="56" Height="56"/>
                            <TextBlock Text="Fetching latest news..." Foreground="{ThemeResource AppFgMutedColorBrush}" FontSize="16"/>
                        </StackPanel>

                        <ListView x:Name="ArticlesListView"
                                  SelectionMode="None"
                                  ShowsScrollingPlaceholders="False"
                                  Visibility="Collapsed"
                                  IsItemClickEnabled="True"
                                  ItemClick="ArticlesListView_ItemClick"
                                  Padding="0,16,20,20"
                                  ItemContainerStyle="{StaticResource RssItemContainerStyle}"
                                  ItemTemplate="{StaticResource RssItemTemplate}"/>
                    </Grid>
                </PivotItem>

                <!-- Tab 2: Perspectives & Blindspots -->
                <PivotItem>
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Perspectives" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="#FF0284C7" CornerRadius="10" MinWidth="20" Height="20" Padding="6,0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind PerspectiveClusters.Count, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </PivotItem.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Sub-section Filter Chips (Multi-Source Stories | Blindspots | Expand External Spectrum | Media Diet) -->
                        <Grid Grid.Row="0" Margin="0,14,20,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Button x:Name="PerspectivesAllFilterBtn"
                                        Click="PerspectivesAllFilterBtn_Click"
                                        Background="#3338BDF8"
                                        BorderBrush="#7738BDF8"
                                        BorderThickness="1"
                                        CornerRadius="15"
                                        Padding="14,6">
                                    <TextBlock Text="Multi-Source Stories" FontSize="13" FontWeight="SemiBold" Foreground="#FF38BDF8"/>
                                </Button>
                                <Button x:Name="PerspectivesBlindspotsFilterBtn"
                                        Click="PerspectivesBlindspotsFilterBtn_Click"
                                        Background="{ThemeResource AppGlassColorBrush}"
                                        BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                                        BorderThickness="1"
                                        CornerRadius="15"
                                        Padding="14,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#FFFBBF24"/>
                                        <TextBlock Text="Blindspots" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <ProgressRing x:Name="PerspectivesExpandProgress" IsActive="False" Visibility="Collapsed" Width="18" Height="18"/>
                                <Button x:Name="PerspectivesExpandBtn"
                                        Click="PerspectivesExpandBtn_Click"
                                        Background="{ThemeResource AppGlassColorBrush}"
                                        BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                                        BorderThickness="1"
                                        CornerRadius="15"
                                        Padding="12,6"
                                        ToolTipService.ToolTip="Discover cross-spectrum coverage from Google News &amp; GDELT on demand">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#FF38BDF8"/>
                                        <TextBlock Text="Expand Spectrum" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="MediaDietButton_Click"
                                        Background="{ThemeResource AppGlassColorBrush}"
                                        BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                                        BorderThickness="1"
                                        CornerRadius="15"
                                        Padding="12,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xEB05;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#FF2DD4BF"/>
                                        <TextBlock Text="Media Diet" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   x:Name="NoPerspectivesTextBlock"
                                   Text="Select 'All News' or click 'Expand Spectrum' to surface multi-source story clusters and Blindspots."
                                   Foreground="{ThemeResource AppFgMutedColorBrush}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>

                        <ListView Grid.Row="1"
                                  x:Name="PerspectivesClustersListView"
                                  SelectionMode="None"
                                  ShowsScrollingPlaceholders="False"
                                  IsItemClickEnabled="True"
                                  ItemClick="PerspectivesClustersListView_ItemClick"
                                  Padding="0,4,20,20"
                                  ItemContainerStyle="{StaticResource RssItemContainerStyle}"
                                  ItemTemplate="{StaticResource StoryClusterTemplate}"/>
                    </Grid>
                </PivotItem>

                <!-- Tab 2: Read Later -->
                <PivotItem>
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Read Later" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="{ThemeResource AppErrorBrush}" CornerRadius="10" MinWidth="20" Height="20" Padding="6,0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ReadLaterArticles.Count, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </PivotItem.Header>
                    <Grid>
                        <TextBlock x:Name="NoReadLaterTextBlock" 
                                   Text="No articles saved for later." 
                                   Foreground="{ThemeResource AppFgMutedColorBrush}" 
                                   FontSize="16" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center" 
                                   Visibility="Collapsed"/>

                        <ListView x:Name="ReadLaterListView"
                                  SelectionMode="None"
                                  ShowsScrollingPlaceholders="False"
                                  IsItemClickEnabled="True"
                                  ItemClick="ArticlesListView_ItemClick"
                                  Padding="0,16,20,20"
                                  ItemContainerStyle="{StaticResource RssItemContainerStyle}"
                                  ItemTemplate="{StaticResource RssItemTemplate}"/>
                    </Grid>
                </PivotItem>

                <!-- Tab 3: Favorites -->
                <PivotItem>
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Favorites" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="{ThemeResource AppWarningBrush}" CornerRadius="10" MinWidth="20" Height="20" Padding="6,0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind FavoriteArticles.Count, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AppWarningForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </PivotItem.Header>
                    <Grid>
                        <TextBlock x:Name="NoFavoritesTextBlock" 
                                   Text="No favorite articles starred." 
                                   Foreground="{ThemeResource AppFgMutedColorBrush}" 
                                   FontSize="16" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center" 
                                   Visibility="Collapsed"/>

                        <ListView x:Name="FavoritesListView"
                                  SelectionMode="None"
                                  ShowsScrollingPlaceholders="False"
                                  IsItemClickEnabled="True"
                                  ItemClick="ArticlesListView_ItemClick"
                                  Padding="0,16,20,20"
                                  ItemContainerStyle="{StaticResource RssItemContainerStyle}"
                                  ItemTemplate="{StaticResource RssItemTemplate}"/>
                    </Grid>
                </PivotItem>
            </Pivot>
        </Grid>

        <!-- State 2: Reader View -->
        <Grid x:Name="ReaderViewContainer" Visibility="Collapsed" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Fixed TopBar Row: back button and action buttons -->
            <Grid Grid.Row="0" Padding="20,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Grid.Column="0" Click="BackButton_Click" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" Translation="0,0,18" CornerRadius="18" Padding="14,0" Height="36" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" Foreground="{ThemeResource AppFgColorBrush}"/>
                        <TextBlock Text="Back to List" FontSize="14" Foreground="{ThemeResource AppFgColorBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <!-- Horizontal scrollable smart recommendations -->
                <Grid Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Height="36">
                    <ScrollViewer x:Name="RecommendationsScrollViewer" 
                                  HorizontalScrollBarVisibility="Hidden" 
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled" 
                                  VerticalScrollMode="Disabled"
                                  ViewChanged="RecommendationsScrollViewer_ViewChanged">
                        <ItemsControl x:Name="RecommendationsItemsControl" Padding="12,0,12,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:RssItem">
                                    <Button Click="RecommendationButton_Click"
                                            Background="{ThemeResource AppGlassColorBrush}"
                                            BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Height="32"
                                            Padding="10,0,10,0"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            ToolTipService.ToolTip="{x:Bind Title}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <!-- Publication Icon circular badge -->
                                            <Border Width="14" Height="14" CornerRadius="7" Background="White" Padding="0.5" VerticalAlignment="Center"
                                                    Visibility="{x:Bind PublicationIconUrl, Converter={StaticResource StringToVisibilityConverter}}">
                                                <Image Source="{x:Bind PublicationIconUrl}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            
                                            <!-- Title text -->
                                            <TextBlock Text="{x:Bind Title}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       MaxWidth="140"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource AppFgColorBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <!-- Reader Subscribe to Publisher/Author Button -->
                    <Button x:Name="ReaderSubscribeButton" Click="ReaderSubscribeButton_Click" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" Translation="0,0,18" CornerRadius="18" Height="36" Padding="12,0" Visibility="Collapsed" ToolTipService.ToolTip="Subscribe to Publication">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon x:Name="ReaderSubscribeIcon" Glyph="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                            <TextBlock x:Name="ReaderSubscribeText" Text="Subscribe" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Source Transparency Button (Bias, Factuality & Ownership Flyout) -->
                    <Button x:Name="ReaderSourceInfoButton"
                            Background="{ThemeResource AppGlassColorBrush}"
                            BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                            BorderThickness="1"
                            Translation="0,0,18"
                            CornerRadius="18"
                            Height="36"
                            Padding="11,0"
                            ToolTipService.ToolTip="Source Transparency (Bias, Factuality &amp; Ownership)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#FF38BDF8"/>
                            <TextBlock x:Name="ReaderSourceBadgeText" Text="Source" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="320" Spacing="10" Padding="4">
                                    <TextBlock x:Name="FlyoutOutletNameText" Text="Publication" FontSize="17" FontWeight="Bold" Foreground="{ThemeResource AppFgColorBrush}"/>
                                    <TextBlock x:Name="FlyoutOutletDomainText" Text="domain.com" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                                    <Border Height="1" Background="{ThemeResource AppGlassBorderColorBrush}" Margin="0,2"/>
                                    <Grid ColumnSpacing="10" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Editorial Bias:" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FlyoutBiasText" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Factuality:" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="FlyoutFactualityText" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ownership:" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="FlyoutOwnerText" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Category:" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="FlyoutOwnershipCatText" FontSize="12" Foreground="{ThemeResource AppFgColorBrush}" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Border Background="#18FFFFFF" CornerRadius="8" Padding="10,8">
                                        <TextBlock x:Name="FlyoutFundingText" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Perspectives Split-Pane Toggle Button -->
                    <Button x:Name="ReaderPerspectivesToggleButton"
                            Click="ReaderPerspectivesToggleButton_Click"
                            Background="#2438BDF8"
                            BorderBrush="#5538BDF8"
                            BorderThickness="1"
                            Translation="0,0,18"
                            CornerRadius="18"
                            Height="36"
                            Padding="12,0"
                            ToolTipService.ToolTip="Compare Cross-Spectrum Perspectives (Ctrl+Shift+P)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8FD;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#FF38BDF8"/>
                            <TextBlock x:Name="ReaderPerspectivesBtnText" Text="Perspectives" FontSize="12" FontWeight="SemiBold" Foreground="#FF38BDF8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Open in Prism Studio Button -->
                    <Button x:Name="ReaderOpenInPrismButton"
                            AutomationProperties.Name="Open Article in Prism Studio"
                            Click="ReaderOpenInPrismButton_Click"
                            Background="#2400E5FF"
                            BorderBrush="#5500E5FF"
                            BorderThickness="1"
                            Translation="0,0,18"
                            CornerRadius="18"
                            Width="36" Height="36" Padding="0"
                            ToolTipService.ToolTip="Open in Prism Studio (Ctrl+0)">
                        <FontIcon Glyph="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#FF00E5FF"/>
                    </Button>

                    <!-- Reader Favorite Button -->
                    <Button x:Name="ReaderFavoriteButton" Click="ReaderFavoriteButton_Click" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" Translation="0,0,18" CornerRadius="18" Width="36" Height="36" Padding="0" ToolTipService.ToolTip="Toggle Favorite">
                        <FontIcon x:Name="ReaderFavoriteIcon" Glyph="&#xE734;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource AppFgColorBrush}"/>
                    </Button>
                    
                    <!-- Reader Read Later Button -->
                    <Button x:Name="ReaderReadLaterButton" Click="ReaderReadLaterButton_Click" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" Translation="0,0,18" CornerRadius="18" Width="36" Height="36" Padding="0" ToolTipService.ToolTip="Toggle Read Later">
                        <FontIcon x:Name="ReaderReadLaterIcon" Glyph="&#xE8A4;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource AppFgColorBrush}"/>
                    </Button>

                    <!-- Pop-out Window Button -->
                    <Button x:Name="ReaderPopOutButton" Click="PopOutButton_Click" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" Translation="0,0,18" CornerRadius="18" Width="36" Height="36" Padding="0" ToolTipService.ToolTip="Pop out to separate window">
                        <FontIcon Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource AppFgColorBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Color Ribbon Separator - matches darkest tones from SVG gradients -->
            <Border Grid.Row="1" Height="3" Background="{ThemeResource AppReaderRibbonBrush}"/>

            <!-- Reader Main Split Container (65% Article WebView2 / 35% Perspectives Companion Pane) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="ReaderPerspectivesCol" Width="0"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <!-- Reader Loading State -->
                    <StackPanel x:Name="ReaderLoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                        <ProgressRing x:Name="ReaderProgressRing" IsActive="True" Width="56" Height="56"/>
                        <TextBlock x:Name="ReaderLoadingText" Text="Extracting article..." Foreground="{ThemeResource AppFgMutedColorBrush}" FontSize="16"/>
                    </StackPanel>

                    <!-- WebView2 for Reader Content -->
                    <WebView2 x:Name="ReaderWebView" Margin="0" Visibility="Collapsed"/>
                    <WebView2 x:Name="BackgroundWebView" Margin="0" Width="0" Height="0" Opacity="0" Visibility="Visible"/>
                </Grid>

                <!-- Side-by-Side Perspectives & Framing Comparison Pane -->
                <Border Grid.Column="1"
                        x:Name="ReaderPerspectivesPane"
                        Visibility="Collapsed"
                        Background="{ThemeResource AppGlassColorBrush}"
                        BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                        BorderThickness="1,0,0,0"
                        Padding="18,16">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Perspectives" FontSize="17" FontWeight="Bold" Foreground="{ThemeResource AppFgColorBrush}"/>
                                    <Border Background="#2438BDF8" CornerRadius="8" Padding="7,2">
                                        <TextBlock x:Name="ReaderPerspectiveEngineBadge" Text="Lens" FontSize="10" FontWeight="SemiBold" Foreground="#FF38BDF8"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="ReaderPerspectiveSubtitle" Text="Cross-spectrum framing &amp; source coverage" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Click="CloseReaderPerspectivesBtn_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Width="30" Height="30" Padding="0"
                                    CornerRadius="15">
                                <FontIcon Glyph="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14" Padding="0,0,4,16">
                                <!-- Loading indicator while discovering external coverage / NPU framing -->
                                <StackPanel x:Name="ReaderPerspectivesLoadingRow" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                                    <ProgressRing IsActive="True" Width="16" Height="16"/>
                                    <TextBlock Text="Discovering cross-spectrum coverage..." FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Spectrum Distribution Bar -->
                                <Border Background="#18FFFFFF" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                                    <StackPanel Spacing="8">
                                        <Border CornerRadius="4" Height="8" Background="#22FFFFFF">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition x:Name="ReaderLeftCol" Width="1*"/>
                                                    <ColumnDefinition x:Name="ReaderCenterCol" Width="1*"/>
                                                    <ColumnDefinition x:Name="ReaderRightCol" Width="1*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#FF3B82F6"/>
                                                <Border Grid.Column="1" Background="#FF94A3B8"/>
                                                <Border Grid.Column="2" Background="#FFF43F5E"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="ReaderSpectrumSummaryText" Text="Spectrum Distribution" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}"/>
                                        <Border x:Name="ReaderBlindspotBanner" Visibility="Collapsed" Background="#2BF59E0B" BorderBrush="#66F59E0B" BorderThickness="1" CornerRadius="8" Padding="8,6">
                                            <TextBlock x:Name="ReaderBlindspotBannerText" FontSize="11" Foreground="#FFFBBF24" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Shared Facts -->
                                <Border Background="#18FFFFFF" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="COMMON FACTS ACROSS OUTLETS" FontSize="11" FontWeight="Bold" Foreground="#FF2DD4BF"/>
                                        <StackPanel x:Name="ReaderSharedFactsStack" Spacing="6"/>
                                    </StackPanel>
                                </Border>

                                <!-- Framing & Tone Differences -->
                                <Border Background="#18FFFFFF" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="FRAMING &amp; EMPHASIS DIFFERENCES" FontSize="11" FontWeight="Bold" Foreground="#FF38BDF8"/>
                                        <StackPanel x:Name="ReaderFramingDiffsStack" Spacing="8"/>
                                        <TextBlock x:Name="ReaderOmissionsNoteText" Visibility="Collapsed" FontSize="11" FontStyle="Italic" Foreground="#FFFBBF24" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- All Outlets Covering This Story -->
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="ReaderCoverageHeader" Text="OUTLETS COVERING THIS STORY" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                                    <ItemsControl x:Name="ReaderCoverageItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ReaderCoverageRowViewModel">
                                                <Button Click="ReaderCoverageRow_Click"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        Background="#16FFFFFF"
                                                        BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="10,8"
                                                        Margin="0,0,0,8">
                                                    <StackPanel Spacing="4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding OutletName}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource AppFgColorBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <Border Grid.Column="1" Background="{Binding BiasBadgeBackground}" CornerRadius="7" Padding="6,1">
                                                                <TextBlock Text="{Binding BiasBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding BiasBadgeForeground}"/>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Headline}" FontSize="12" Foreground="{ThemeResource AppFgColorBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding OwnerSummary}" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
