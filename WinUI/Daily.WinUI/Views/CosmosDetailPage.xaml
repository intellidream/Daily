<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Daily_WinUI.Views.CosmosDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#FF00E5FF" />
        <SolidColorBrush x:Key="NightVisionRedBrush" Color="#FFFF1824" />
        <SolidColorBrush x:Key="PanelGlassBrush" Color="#200B1121" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#33FFFFFF" />
    </Page.Resources>

    <Grid x:Name="RootLayout" Background="#FF050811">
        <Grid.RowDefinitions>
            <RowDefinition Height="84" /> <!-- Top Bar -->
            <RowDefinition Height="*" />  <!-- Main Sky Dome & HUD -->
        </Grid.RowDefinitions>

        <!-- ── Top Bar ────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Padding="24,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Back Button, Icon, Title, Location & Mode Badge -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button
                    x:Name="BackButton"
                    Click="BackButton_Click"
                    Width="38" Height="38"
                    CornerRadius="19"
                    Background="{ThemeResource AppGlassColorBrush}"
                    BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                    BorderThickness="1"
                    Padding="0"
                    ToolTipService.ToolTip="Înapoi la Dashboard">
                    <FontIcon Glyph="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource AppFgColorBrush}" />
                </Button>

                <Border Width="40" Height="40" CornerRadius="20" Background="#2600E5FF" BorderBrush="#4D00E5FF" BorderThickness="1" VerticalAlignment="Center">
                    <FontIcon x:Name="HeaderIcon" Glyph="&#xE706;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#FF00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="TitleText"
                            Text="Cosmos"
                            FontFamily="Segoe UI Variable Display"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="{ThemeResource AppFgColorBrush}" />
                        
                        <Border x:Name="SimulationBadge" Background="#2600E5FF" BorderBrush="#4D00E5FF" BorderThickness="1" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock x:Name="SimulationBadgeText" Text="LIVE" FontSize="10" FontWeight="Bold" Foreground="#FF00E5FF" />
                        </Border>
                    </StackPanel>

                    <TextBlock
                        x:Name="LocationSubtitle"
                        Text="Observator Cerul Nopții • Coordonate Locale"
                        FontSize="12"
                        Foreground="{ThemeResource AppFgMutedColorBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Right: Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Red Night-Vision Toggle -->
                <Button
                    x:Name="NightVisionButton"
                    Click="NightVisionButton_Click"
                    Height="38"
                    CornerRadius="19"
                    Background="{ThemeResource AppGlassColorBrush}"
                    BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                    BorderThickness="1"
                    Padding="12,0"
                    ToolTipService.ToolTip="Comută modul nocturn roșu pentru protejarea vederii scotopice">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="NightVisionIcon" Glyph="&#xE781;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#FFFF1824" />
                        <TextBlock x:Name="NightVisionText" Text="Vedere Nocturnă" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Search Catalog Button with Flyout -->
                <Button
                    x:Name="SearchButton"
                    Width="38" Height="38"
                    CornerRadius="19"
                    Background="{ThemeResource AppGlassColorBrush}"
                    BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                    BorderThickness="1"
                    Padding="0"
                    ToolTipService.ToolTip="Căutare stele, constelații, DSOs">
                    <FontIcon Glyph="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource AppFgColorBrush}" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="320" Spacing="10">
                                <TextBlock Text="Căutare Catalog Astronomic" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource AppFgColorBrush}" />
                                <AutoSuggestBox
                                    x:Name="CatalogSearchBox"
                                    PlaceholderText="Ex: Sirius, Orion, Pleiade, M31..."
                                    TextChanged="CatalogSearchBox_TextChanged"
                                    SuggestionChosen="CatalogSearchBox_SuggestionChosen"
                                    QuerySubmitted="CatalogSearchBox_QuerySubmitted"
                                    DisplayMemberPath="Title"
                                    TextMemberPath="Title" />
                                <TextBlock Text="Selectează un obiect pentru centrare pe bolta cerească." FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Reset Camera Orientation Button -->
                <Button
                    x:Name="ResetCameraButton"
                    Click="ResetCameraButton_Click"
                    Width="38" Height="38"
                    CornerRadius="19"
                    Background="{ThemeResource AppGlassColorBrush}"
                    BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                    BorderThickness="1"
                    Padding="0"
                    ToolTipService.ToolTip="Resetează orientarea către Zenit (90°)">
                    <FontIcon Glyph="&#xE7AD;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource AppFgColorBrush}" />
                </Button>

                <!-- Detach Window Button -->
                <Button
                    x:Name="PopOutButton"
                    Click="PopOutButton_Click"
                    Width="38" Height="38"
                    CornerRadius="19"
                    Background="{ThemeResource AppGlassColorBrush}"
                    BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                    BorderThickness="1"
                    Padding="0"
                    ToolTipService.ToolTip="Deschide în fereastră separată de observator">
                    <FontIcon Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource AppFgColorBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── Main Sky Dome & HUD Overlay ───────────────────────── -->
        <Grid Grid.Row="1" x:Name="ViewportContainer" ClipToBounds="True">
            <!-- Sky Canvas (Interactive Drawing Surface) -->
            <Canvas
                x:Name="SkyCanvas"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                PointerPressed="SkyCanvas_PointerPressed"
                PointerMoved="SkyCanvas_PointerMoved"
                PointerReleased="SkyCanvas_PointerReleased"
                PointerWheelChanged="SkyCanvas_PointerWheelChanged"
                SizeChanged="SkyCanvas_SizeChanged" />

            <!-- Reticle Crosshair & Viewport Telemetry (Top Right) -->
            <Border
                x:Name="TelemetryCard"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,16,24,0"
                Background="#26000000"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,8">
                <StackPanel Spacing="3">
                    <TextBlock x:Name="TelemetryAzAlt" Text="Az: 180.0° • Alt: 45.0°" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#FF00E5FF" />
                    <TextBlock x:Name="TelemetryFov" Text="Câmp vizual (FOV): 90°" FontSize="10" FontFamily="Consolas, Segoe UI" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                    <TextBlock x:Name="TelemetryStargazing" Text="Calitate cer: Excelent (88)" FontSize="10" Foreground="#FF00D09C" />
                </StackPanel>
            </Border>

            <!-- Target Inspector Floating Card (Top Left) -->
            <Border
                x:Name="TargetInspectorCard"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="24,16,0,0"
                Width="280"
                Background="#E6070D1A"
                BorderBrush="#4D00E5FF"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16"
                Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="TargetNameText" Text="Jupiter" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource AppFgColorBrush}" />
                            <TextBlock x:Name="TargetTypeText" Text="Planetă • Sistemul Solar" FontSize="11" Foreground="#FF00E5FF" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="CloseTargetCard_Click" Background="Transparent" BorderThickness="0" Padding="4">
                            <FontIcon Glyph="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,10,0,0" Spacing="4">
                        <TextBlock x:Name="TargetCoordsText" Text="Az: 142.3° • Alt: +38.5°" FontSize="12" FontFamily="Consolas, Segoe UI" Foreground="{ThemeResource AppFgColorBrush}" />
                        <TextBlock x:Name="TargetMagDistText" Text="Mag: -2.4 • Dist: 4.82 AU" FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                    </StackPanel>

                    <Border Grid.Row="2" Margin="0,10,0,0" Background="#15FFFFFF" CornerRadius="8" Padding="10,6">
                        <TextBlock x:Name="TargetOpticsText" Text="Vizibil cu ochiul liber • Detalii benzi atmosferice prin telescop 70mm+" FontSize="11" Foreground="{ThemeResource AppFgColorBrush}" TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <!-- Bottom Control Deck: Time Machine Scrubber & Quick Planets Bar -->
            <StackPanel
                x:Name="BottomControlDeck"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                Spacing="12">

                <!-- Quick Planets Status Carousel -->
                <Border
                    x:Name="PlanetsDeckBorder"
                    Background="#D9070D1A"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="12,6">
                    <StackPanel x:Name="PlanetsStack" Orientation="Horizontal" Spacing="8">
                        <!-- Populated programmatically in code-behind -->
                    </StackPanel>
                </Border>

                <!-- Time Machine Scrubber -->
                <Border
                    x:Name="TimeScrubberBorder"
                    Background="#E6070D1A"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="16,8">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Click="TimeTravel_Minus1h" Background="Transparent" BorderThickness="0" Padding="8,4" CornerRadius="12">
                            <TextBlock Text="-1h" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}" />
                        </Button>
                        <Button Click="TimeTravel_Minus15m" Background="Transparent" BorderThickness="0" Padding="8,4" CornerRadius="12">
                            <TextBlock Text="-15m" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}" />
                        </Button>

                        <Border Background="#2600E5FF" BorderBrush="#4D00E5FF" BorderThickness="1" CornerRadius="14" Padding="14,6">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE823;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#FF00E5FF" />
                                <TextBlock x:Name="SimulatedTimeText" Text="LIVE: 28 Oct, 21:00" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource AppFgColorBrush}" />
                            </StackPanel>
                        </Border>

                        <Button Click="TimeTravel_Plus15m" Background="Transparent" BorderThickness="0" Padding="8,4" CornerRadius="12">
                            <TextBlock Text="+15m" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}" />
                        </Button>
                        <Button Click="TimeTravel_Plus1h" Background="Transparent" BorderThickness="0" Padding="8,4" CornerRadius="12">
                            <TextBlock Text="+1h" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}" />
                        </Button>
                        <Button Click="TimeTravel_Plus24h" Background="Transparent" BorderThickness="0" Padding="8,4" CornerRadius="12">
                            <TextBlock Text="+24h" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}" />
                        </Button>
                        <Button Click="TimeTravel_ResetLive" Background="#20FFFFFF" BorderThickness="0" Padding="10,4" CornerRadius="12">
                            <TextBlock Text="LIVE" FontSize="11" FontWeight="Bold" Foreground="#FF00E5FF" />
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
