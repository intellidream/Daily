<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Daily_WinUI.Views.SupabaseAdminPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Sticky Top Console Bar -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Click="BackButton_Click" Padding="10,6" VerticalAlignment="Center" ToolTipService.ToolTip="Back to Data &amp; Cloud Sync">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                        <TextBlock Text="Data &amp; Sync" FontSize="12" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="ProjectTitleText" Text="Supabase Cloud Console" FontSize="17" FontWeight="SemiBold" />
                        <Border Background="#2238BDF8" BorderBrush="#5538BDF8" BorderThickness="1" CornerRadius="10" Padding="7,2" VerticalAlignment="Center">
                            <TextBlock x:Name="PlanBadgeText" Text="FREE" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" />
                        </Border>
                        <Border Background="#2210B981" BorderBrush="#5510B981" BorderThickness="1" CornerRadius="10" Padding="7,2" VerticalAlignment="Center">
                            <TextBlock Text="READ-ONLY" FontSize="10" FontWeight="Bold" Foreground="#10B981" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="SubtitleStatusText" Text="Loading cloud observability telemetry..." FontSize="11.5" Opacity="0.68" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ComboBox x:Name="ProjectSelectorCombo"
                              Visibility="Collapsed"
                              MinWidth="150"
                              SelectionChanged="ProjectSelectorCombo_SelectionChanged" />

                    <Button x:Name="AnalyzeAiButton" Click="AnalyzeAiButton_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,6" ToolTipService.ToolTip="Run Cloud SRE Diagnostic (On-Device AI + Deterministic Analyzer)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE945;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                            <TextBlock x:Name="AnalyzeAiButtonLabel" Text="Analyze SRE" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="CopyReportButton" Click="CopyReportButton_Click" Padding="9,6" ToolTipService.ToolTip="Copy Forensic Markdown Report">
                        <FontIcon Glyph="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                    </Button>

                    <Button x:Name="SaveReportButton" Click="SaveReportButton_Click" Padding="9,6" ToolTipService.ToolTip="Export Forensic Markdown (.md)">
                        <FontIcon Glyph="&#xE74E;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                    </Button>

                    <ToggleSwitch x:Name="RequireHelloToggle"
                                  OffContent="Hello"
                                  OnContent="Hello"
                                  Toggled="RequireHelloToggle_Toggled"
                                  ToolTipService.ToolTip="Require Windows Hello / PIN to open Supabase Admin Console"
                                  VerticalAlignment="Center"
                                  Margin="2,0" />

                    <Button x:Name="RefreshButton" Click="RefreshButton_Click" Padding="9,6" ToolTipService.ToolTip="Force Refresh Live Telemetry">
                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                    </Button>

                    <Button x:Name="DisconnectButton" Click="DisconnectButton_Click" Padding="9,6" ToolTipService.ToolTip="Disconnect Admin Credentials">
                        <FontIcon Glyph="&#xF3B1;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#F87171" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filter Tab Strip -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Padding="24,10,24,4">
            <StackPanel x:Name="FilterTabsPanel" Orientation="Horizontal" Spacing="8">
                <Button Tag="ALL" Content="All Telemetry" Click="FilterTab_Click" />
                <Button Tag="QUOTAS" Content="Quotas &amp; Egress" Click="FilterTab_Click" />
                <Button Tag="DATABASE" Content="Database &amp; Bloat" Click="FilterTab_Click" />
                <Button Tag="GATEWAY" Content="Gateway &amp; Logs" Click="FilterTab_Click" />
                <Button Tag="RUNTIME" Content="Functions &amp; Realtime" Click="FilterTab_Click" />
                <Button Tag="FLEET" Content="Fleet &amp; Advisors" Click="FilterTab_Click" />
            </StackPanel>
        </ScrollViewer>

        <!-- Main Telemetry Feed -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,12,24,64">
            <StackPanel x:Name="MainTelemetryRoot" Spacing="16" MaxWidth="980" HorizontalAlignment="Stretch">
                <Border x:Name="LoadingBanner"
                        Visibility="Collapsed"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ProgressRing IsActive="True" Width="22" Height="22" />
                        <TextBlock Text="Querying Supabase Management API, ClickHouse Edge Logs, and Read-Only pg_catalog..."
                                   VerticalAlignment="Center" FontSize="12.5" Opacity="0.8" />
                    </StackPanel>
                </Border>

                <Border x:Name="ErrorBanner"
                        Visibility="Collapsed"
                        Background="#28EF4444"
                        BorderBrush="#66EF4444"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <TextBlock x:Name="ErrorBannerText" FontSize="12.5" TextWrapping="Wrap" />
                </Border>

                <StackPanel x:Name="DynamicSectionsHost" Spacing="16" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
