<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Daily_WinUI.Views.WeatherDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Daily_WinUI"
    xmlns:models="using:Daily_WinUI.Models"
    xmlns:chart="using:Syncfusion.UI.Xaml.Charts"
    xmlns:gauge="using:Syncfusion.UI.Xaml.Gauges"
    xmlns:notif="using:Syncfusion.UI.Xaml.Notifications"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF0B1121" Offset="0" />
            <GradientStop Color="#FF0B1121" Offset="0.35" />
            <GradientStop Color="#820B1121" Offset="0.65" />
            <GradientStop Color="#600B1121" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#FF69B6FF" />
        <SolidColorBrush x:Key="AccentMintBrush" Color="#FF7FF0D5" />
        <SolidColorBrush x:Key="AccentSunBrush" Color="#FFFFD166" />
        <SolidColorBrush x:Key="AccentRoseBrush" Color="#FFFF8FA3" />
        <SolidColorBrush x:Key="ButtonPrimaryBrush" Color="#CC2274D8" />
        <SolidColorBrush x:Key="ButtonSecondaryBrush" Color="#AA165AA8" />
        <SolidColorBrush x:Key="ShellBrush" Color="#20FFFFFF" />
        <SolidColorBrush x:Key="ShellBorderBrush" Color="#46FFFFFF" />
        <SolidColorBrush x:Key="TileBrush" Color="#18FFFFFF" />
        <SolidColorBrush x:Key="TileBorderBrush" Color="#30FFFFFF" />
        <SolidColorBrush x:Key="SubTileBrush" Color="#15FFFFFF" />
        <SolidColorBrush x:Key="ForecastCardBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="ForecastCardBorderBrush" Color="#33FFFFFF" />
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="84" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Navigation & Location Bar (macOS Parity & Hub Alignment) -->
        <Grid Grid.Row="0" Padding="24,0" VerticalAlignment="Center" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Circular Glass Back Button + Icon + Large Location Title + GPS Badge -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button
                    x:Name="BackButton"
                    Click="BackButton_Click"
                    Width="38" Height="38"
                    CornerRadius="19"
                    Background="{ThemeResource AppGlassColorBrush}"
                    BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                    BorderThickness="1"
                    Padding="0"
                    ToolTipService.ToolTip="Back to Dashboard">
                    <FontIcon Glyph="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource AppFgColorBrush}" />
                </Button>
                <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource AppGlassColorBrush}" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE753;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#FF69B6FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind ViewModel.LocationName, Mode=OneWay}"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="32"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AppFgColorBrush}"
                        VerticalAlignment="Center" />
                    <Border Background="#2569B6FF" BorderBrush="#5069B6FF" BorderThickness="1" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE707;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#FF69B6FF" VerticalAlignment="Center" />
                            <TextBlock
                                Text="{x:Bind ViewModel.LocationSourceName, Mode=OneWay}"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="#FF69B6FF"
                                CharacterSpacing="60"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Right: Action Buttons (Auto-Location, Search, PopOut) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- 1-Click GPS Auto-Location Button -->
                <Button
                    x:Name="AutoLocationButton"
                    Click="AutoLocationButton_Click"
                    Width="38" Height="38"
                    CornerRadius="19"
                    Background="{ThemeResource AppGlassColorBrush}"
                    BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                    BorderThickness="1"
                    Padding="0"
                    ToolTipService.ToolTip="Use current location (GPS / Network)">
                    <FontIcon Glyph="&#xE707;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#FF00E5FF" />
                </Button>

                <!-- City Search Button with Sleek Flyout -->
                <Button
                    x:Name="SearchButton"
                    Width="38" Height="38"
                    CornerRadius="19"
                    Background="{ThemeResource AppGlassColorBrush}"
                    BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                    BorderThickness="1"
                    Padding="0"
                    ToolTipService.ToolTip="Search city worldwide">
                    <FontIcon Glyph="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource AppFgColorBrush}" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="320" Spacing="12">
                                <TextBlock Text="Search City" FontWeight="SemiBold" FontSize="15" />
                                <AutoSuggestBox
                                    x:Name="LocationSearchBox"
                                    PlaceholderText="Search city (e.g. London, Tokyo)..."
                                    TextChanged="LocationSearchBox_TextChanged"
                                    SuggestionChosen="LocationSearchBox_SuggestionChosen"
                                    QuerySubmitted="LocationSearchBox_QuerySubmitted"
                                    DisplayMemberPath="DisplayName"
                                    TextMemberPath="DisplayName" />
                                <Button
                                    x:Name="FlyoutAutoLocationButton"
                                    Click="AutoLocationButton_Click"
                                    HorizontalAlignment="Stretch"
                                    Padding="10,8"
                                    Background="{ThemeResource AppGlassSubColorBrush}"
                                    CornerRadius="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE707;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#FF00E5FF" />
                                        <TextBlock Text="Use Current Location (GPS)" FontSize="13" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="QUICK CITIES" FontSize="10" FontWeight="Bold" Opacity="0.5" CharacterSpacing="60" Margin="0,4,0,0" />
                                <ItemsRepeater ItemsSource="{x:Bind QuickCities}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical" Spacing="4" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:LocationSuggestion">
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="8,6"
                                                CornerRadius="8"
                                                Click="QuickCity_Click"
                                                Tag="{x:Bind}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE81D;" FontFamily="Segoe Fluent Icons" FontSize="12" Opacity="0.6" />
                                                    <TextBlock Text="{x:Bind DisplayName}" FontSize="13" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Pop-out Button -->
                <Button
                    x:Name="PopOutButton"
                    Click="PopOutButton_Click"
                    Width="38" Height="38"
                    CornerRadius="19"
                    Background="{ThemeResource AppGlassColorBrush}"
                    BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                    BorderThickness="1"
                    Padding="0"
                    ToolTipService.ToolTip="Pop out to separate window">
                    <FontIcon Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource AppFgColorBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Scrollable Centered Content Stream (macOS Parity, MaxWidth 880) -->
        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled">
            <StackPanel
                MaxWidth="880"
                HorizontalAlignment="Center"
                Margin="20,10,20,20"
                Spacing="16"
                Padding="0,0,0,120">

                <!-- 1. Hero Weather Card (macOS Parity) -->
                <Border
                    Background="{ThemeResource AppGlassSubColorBrush}"
                    BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="22">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top row: Condition description pill on left, High/Low on right -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AppFgColorBrush}"
                                VerticalAlignment="Center" />

                            <Border
                                Grid.Column="1"
                                Background="{ThemeResource AppGlassSubColorBrush}"
                                BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,5"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind ViewModel.HighLow, Mode=OneWay}"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Opacity="0.85"
                                    Foreground="{ThemeResource AppFgColorBrush}" />
                            </Border>
                        </Grid>

                        <!-- Bottom row: Huge temperature display + feels like on left, glowing condition icon on right -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock
                                    Text="{x:Bind ViewModel.Temperature, Mode=OneWay}"
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="68"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource AppFgColorBrush}"
                                    LineHeight="72" />

                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                    <TextBlock
                                        Text="FEELS LIKE"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Opacity="0.5"
                                        CharacterSpacing="60"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.FeelsLike, Mode=OneWay}"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Opacity="0.9"
                                        Foreground="{ThemeResource AppFgColorBrush}"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock
                                    Text="{x:Bind ViewModel.Details, Mode=OneWay}"
                                    FontSize="11"
                                    Opacity="0.5"
                                    Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Ambient Glowing Weather Icon -->
                            <Grid Grid.Column="1" Width="92" Height="92" VerticalAlignment="Center">
                                <Border
                                    Width="80" Height="80"
                                    CornerRadius="40"
                                    Background="#2569B6FF"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                                <Image
                                    x:Name="ConditionIcon"
                                    Source="{x:Bind ViewModel.IconUrl, Mode=OneWay}"
                                    Width="72" Height="72"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 2. Hourly Forecast Card (Custom Spline Chart — strictly preserved & enhanced) -->
                <Border
                    Background="{ThemeResource AppGlassSubColorBrush}"
                    BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="18">
                    <Grid RowSpacing="6" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header with subtle icon -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="2,0,0,4">
                            <FontIcon Glyph="&#xE823;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#FF00E5FF" VerticalAlignment="Center" />
                            <TextBlock
                                Text="HOURLY FORECAST"
                                FontSize="11"
                                FontWeight="Bold"
                                CharacterSpacing="70"
                                Opacity="0.65"
                                Foreground="{ThemeResource AppFgColorBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid Grid.Row="1" RowSpacing="2" HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Icon + temperature row aligned with chart plot area -->
                            <ItemsRepeater
                                x:Name="HourlyIconStrip"
                                Grid.Row="0"
                                ItemsSource="{x:Bind ViewModel.HourlyForecast, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                Margin="0,12,0,8">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MaximumRowsOrColumns="8" MinItemWidth="56" MinColumnSpacing="0" ItemsStretch="Fill" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:HourlyForecastSnapshot">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="1" Padding="0,4,0,0">
                                            <Image Source="{x:Bind IconImage}" Width="30" Height="30" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind TemperatureText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#FFF4FAFF" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <!-- Spline chart -->
                            <chart:SfCartesianChart
                                x:Name="HourlyForecastChart"
                                Grid.Row="1"
                                Height="190"
                                Margin="0,0,8,0"
                                PlotAreaBorderThickness="0"
                                SeriesBoundsChanged="HourlyForecastChart_SeriesBoundsChanged"
                                SizeChanged="HourlyForecastChart_SizeChanged">

                                <chart:SfCartesianChart.TrackballBehavior>
                                    <chart:ChartTrackballBehavior
                                        ShowLine="True"
                                        DisplayMode="NearestPoint">
                                        <chart:ChartTrackballBehavior.LineStyle>
                                            <Style TargetType="Line">
                                                <Setter Property="Stroke" Value="#80FFFFFF" />
                                                <Setter Property="StrokeThickness" Value="1.5" />
                                                <Setter Property="StrokeDashArray" Value="4,3" />
                                            </Style>
                                        </chart:ChartTrackballBehavior.LineStyle>
                                    </chart:ChartTrackballBehavior>
                                </chart:SfCartesianChart.TrackballBehavior>

                                <chart:SfCartesianChart.XAxes>
                                    <chart:CategoryAxis ShowMajorGridLines="False" TickLineSize="0">
                                        <chart:CategoryAxis.LabelStyle>
                                            <chart:LabelStyle Foreground="#CCE0EEFF" FontSize="11" />
                                        </chart:CategoryAxis.LabelStyle>
                                        <chart:CategoryAxis.AxisLineStyle>
                                            <Style TargetType="Line">
                                                <Setter Property="StrokeThickness" Value="0" />
                                            </Style>
                                        </chart:CategoryAxis.AxisLineStyle>
                                    </chart:CategoryAxis>
                                </chart:SfCartesianChart.XAxes>

                                <chart:SfCartesianChart.YAxes>
                                    <chart:NumericalAxis
                                        x:Name="HourlyYAxis"
                                        ShowMajorGridLines="True"
                                        TickLineSize="0"
                                        LabelCreated="HourlyYAxis_LabelCreated">
                                        <chart:NumericalAxis.MajorGridLineStyle>
                                            <Style TargetType="Line">
                                                <Setter Property="Stroke" Value="#20FFFFFF" />
                                                <Setter Property="StrokeDashArray" Value="3,3" />
                                            </Style>
                                        </chart:NumericalAxis.MajorGridLineStyle>
                                        <chart:NumericalAxis.LabelStyle>
                                            <chart:LabelStyle Foreground="#99E0EEFF" FontSize="11" />
                                        </chart:NumericalAxis.LabelStyle>
                                        <chart:NumericalAxis.AxisLineStyle>
                                            <Style TargetType="Line">
                                                <Setter Property="StrokeThickness" Value="0" />
                                            </Style>
                                        </chart:NumericalAxis.AxisLineStyle>
                                    </chart:NumericalAxis>
                                </chart:SfCartesianChart.YAxes>

                                <chart:SplineAreaSeries
                                    ItemsSource="{x:Bind ViewModel.HourlyForecast, Mode=OneWay}"
                                    XBindingPath="HourLabel"
                                    YBindingPath="Temperature"
                                    StrokeWidth="2"
                                    Fill="{x:Bind ViewModel.HourlyChartFill, Mode=OneWay}"
                                    Stroke="{x:Bind ViewModel.HourlyChartStroke, Mode=OneWay}">
                                    <chart:SplineAreaSeries.TrackballLabelTemplate>
                                        <DataTemplate>
                                            <Border Background="#E61A3A6C"
                                                    BorderBrush="#60FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="16"
                                                    Padding="14,12">
                                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                    <TextBlock
                                                        Text="{Binding Item.HourLabel}"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Opacity="0.80"
                                                        HorizontalAlignment="Center"
                                                        Foreground="#FFE0EEFF"
                                                        CharacterSpacing="80" />
                                                    <Image
                                                        Source="{Binding Item.IconImage}"
                                                        Width="44"
                                                        Height="44"
                                                        HorizontalAlignment="Center" />
                                                    <TextBlock
                                                        Text="{Binding Item.TemperatureText}"
                                                        FontFamily="Segoe UI Variable Display"
                                                        FontSize="26"
                                                        FontWeight="Bold"
                                                        HorizontalAlignment="Center"
                                                        Foreground="{ThemeResource AppFgColorBrush}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                        <TextBlock
                                                            Text="Feels like"
                                                            FontSize="11"
                                                            Opacity="0.65"
                                                            VerticalAlignment="Center"
                                                            Foreground="#FFE0EEFF" />
                                                        <TextBlock
                                                            Text="{Binding Item.FeelsLikeText}"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            VerticalAlignment="Center"
                                                            Foreground="#FFE0EEFF" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                                        <FontIcon
                                                            Glyph="&#xEB42;"
                                                            FontFamily="Segoe Fluent Icons"
                                                            FontSize="13"
                                                            Foreground="#FF69B6FF"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            Text="{Binding Item.PrecipitationText}"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            VerticalAlignment="Center"
                                                            Foreground="#FF69B6FF" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </chart:SplineAreaSeries.TrackballLabelTemplate>
                                </chart:SplineAreaSeries>
                            </chart:SfCartesianChart>

                            <!-- Sunrise / Sunset overlay badges (positioned from code-behind) -->
                            <Canvas
                                x:Name="SunAnnotationCanvas"
                                Grid.Row="1"
                                IsHitTestVisible="False"
                                Margin="0,0,8,0">
                                <!-- Sunrise badge -->
                                <Border
                                    x:Name="SunriseBadge"
                                    Background="#E01A3A6C"
                                    BorderBrush="#60FFD166"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="7,5"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock
                                            Text="&#x2600;&#x2191;"
                                            FontFamily="Segoe UI Symbol"
                                            FontSize="12"
                                            Foreground="#FFFFD166"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            x:Name="SunriseTimeText"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="#FFFFD166"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <!-- Sunset badge -->
                                <Border
                                    x:Name="SunsetBadge"
                                    Background="#E01A3A6C"
                                    BorderBrush="#60FFB347"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="7,5"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock
                                            Text="&#x2600;&#x2193;"
                                            FontFamily="Segoe UI Symbol"
                                            FontSize="12"
                                            Foreground="#FFFFB347"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            x:Name="SunsetTimeText"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="#FFFFB347"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <!-- Current weather bubble -->
                                <Border
                                    x:Name="CurrentWeatherBadge"
                                    Background="#E0103050"
                                    BorderBrush="#80FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="8,6"
                                    Visibility="Collapsed">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <Image
                                            x:Name="CurrentWeatherIcon"
                                            Width="28"
                                            Height="28"
                                            HorizontalAlignment="Center" />
                                        <TextBlock
                                            x:Name="CurrentWeatherTemp"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="{ThemeResource AppFgColorBrush}"
                                            HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Canvas>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 3. 2x3 Atmospheric Metrics Grid (macOS Parity: Wind, Humidity, Pressure, Visibility, Clouds, Sun) -->
                <Grid ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Wind Metric Tile -->
                    <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource AppGlassSubColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="18" Padding="16">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE734;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#FF00E5FF" />
                                <TextBlock Text="WIND" FontSize="11" FontWeight="Bold" CharacterSpacing="80" Opacity="0.6" Foreground="{ThemeResource AppFgColorBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.Wind, Mode=OneWay}" FontSize="26" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource AppFgColorBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.WindSubtitle, Mode=OneWay}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" Foreground="{ThemeResource AppFgColorBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Humidity Metric Tile -->
                    <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource AppGlassSubColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="18" Padding="16">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEB42;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#FF69B6FF" />
                                <TextBlock Text="HUMIDITY" FontSize="11" FontWeight="Bold" CharacterSpacing="80" Opacity="0.6" Foreground="{ThemeResource AppFgColorBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.Humidity, Mode=OneWay}" FontSize="26" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource AppFgColorBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.HumiditySubtitle, Mode=OneWay}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" Foreground="{ThemeResource AppFgColorBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Pressure Metric Tile -->
                    <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource AppGlassSubColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="18" Padding="16">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#FF7FF0D5" />
                                <TextBlock Text="PRESSURE" FontSize="11" FontWeight="Bold" CharacterSpacing="80" Opacity="0.6" Foreground="{ThemeResource AppFgColorBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.Pressure, Mode=OneWay}" FontSize="26" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource AppFgColorBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.PressureSubtitle, Mode=OneWay}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" Foreground="{ThemeResource AppFgColorBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Visibility Metric Tile -->
                    <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource AppGlassSubColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="18" Padding="16">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE890;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#FFA0B2C6" />
                                <TextBlock Text="VISIBILITY" FontSize="11" FontWeight="Bold" CharacterSpacing="80" Opacity="0.6" Foreground="{ThemeResource AppFgColorBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.Visibility, Mode=OneWay}" FontSize="26" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource AppFgColorBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.VisibilitySubtitle, Mode=OneWay}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" Foreground="{ThemeResource AppFgColorBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Clouds Metric Tile -->
                    <Border Grid.Row="2" Grid.Column="0" Background="{ThemeResource AppGlassSubColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="18" Padding="16">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE753;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#FF90A4AE" />
                                <TextBlock Text="CLOUDS" FontSize="11" FontWeight="Bold" CharacterSpacing="80" Opacity="0.6" Foreground="{ThemeResource AppFgColorBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.Clouds, Mode=OneWay}" FontSize="26" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource AppFgColorBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.CloudsSubtitle, Mode=OneWay}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" Foreground="{ThemeResource AppFgColorBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Sun Schedule Metric Tile -->
                    <Border Grid.Row="2" Grid.Column="1" Background="{ThemeResource AppGlassSubColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="18" Padding="16">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE706;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#FFFFD166" />
                                <TextBlock Text="SUN SCHEDULE" FontSize="11" FontWeight="Bold" CharacterSpacing="80" Opacity="0.6" Foreground="{ThemeResource AppFgColorBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.Sunrise, Mode=OneWay}" FontSize="26" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource AppFgColorBrush}" />
                                <TextBlock Text="↑" FontSize="18" Foreground="#FFFFD166" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.SunSchedule, Mode=OneWay}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" Foreground="{ThemeResource AppFgColorBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 4. 5-Day Forecast Card (macOS Parity: Daily Forecast with Visual Range Gradient Bars) -->
                <Border
                    Background="{ThemeResource AppGlassSubColorBrush}"
                    BorderBrush="{ThemeResource AppGlassBorderColorBrush}"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="20">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE787;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#FF00E5FF" VerticalAlignment="Center" />
                            <TextBlock
                                Text="5-DAY FORECAST"
                                FontSize="11"
                                FontWeight="Bold"
                                CharacterSpacing="80"
                                Opacity="0.6"
                                Foreground="{ThemeResource AppFgColorBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <Rectangle Height="1" Fill="{ThemeResource AppGlassBorderColorBrush}" Opacity="0.3" Margin="0,-2,0,4" />

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.ForecastDays, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="12" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:ForecastDaySnapshot">
                                    <Grid VerticalAlignment="Center" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Day Label -->
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind DayLabel}"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource AppFgColorBrush}" />

                                        <!-- Description & Rain Probability -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" MinWidth="130">
                                            <TextBlock
                                                Text="{x:Bind Description}"
                                                FontSize="13"
                                                Opacity="0.8"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Text="{x:Bind PrecipitationText}"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="#FF69B6FF"
                                                VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Visual Temperature Range Bar (macOS Parity) -->
                                        <Grid Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                            <Border Height="5" CornerRadius="2.5" Background="#18FFFFFF" HorizontalAlignment="Stretch" />
                                            <Border Height="5" CornerRadius="2.5" HorizontalAlignment="Stretch" Margin="20,0,20,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#FF69B6FF" Offset="0" />
                                                        <GradientStop Color="#FF00E5FF" Offset="0.5" />
                                                        <GradientStop Color="#FFFFD166" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>

                                        <!-- Min / Max Temp -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind MinTempText}"
                                                FontSize="14"
                                                Opacity="0.6"
                                                Width="36"
                                                TextAlignment="Right"
                                                Foreground="{ThemeResource AppFgColorBrush}" />
                                            <TextBlock
                                                Text="{x:Bind MaxTempText}"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Width="36"
                                                TextAlignment="Right"
                                                Foreground="{ThemeResource AppFgColorBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
