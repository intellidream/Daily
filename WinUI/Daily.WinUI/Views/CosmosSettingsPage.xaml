<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Daily_WinUI.Views.CosmosSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,32">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left" Spacing="20">

            <StackPanel Spacing="4">
                <TextBlock Text="Cosmos &amp; Night Sky Observatory" FontSize="26" FontWeight="SemiBold" CharacterSpacing="15" />
                <TextBlock Text="Configure NASA APOD API access, multi-layer astronomical weather endpoints, and sky observation alerts."
                           FontSize="12.5" Opacity="0.65" TextWrapping="Wrap" />
            </StackPanel>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- ISS Pass Alerts -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Bright ISS Visible Pass Alerts" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Notify 15 minutes before sunlit SGP4 passes above 40° altitude." FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" x:Name="IssAlertsSwitch" Toggled="AlertSwitch_Toggled" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
            </Border>

            <!-- Aurora Alerts -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Geomagnetic Storm &amp; Aurora Alerts" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Notify when NOAA SWPC planetary Kp reaches 5.0+ (G1+ geomagnetic storm)." FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" x:Name="AuroraAlertsSwitch" Toggled="AlertSwitch_Toggled" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
            </Border>

            <!-- Pristine Sky Alerts -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Pristine Dark-Sky Window Alerts" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Notify when tonight's Stargazing Score exceeds 85/100 under clear skies." FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" x:Name="PristineSkyAlertsSwitch" Toggled="AlertSwitch_Toggled" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
            </Border>

            <!-- API Keys Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Astronomical Telemetry Keys (Optional)" FontWeight="SemiBold" FontSize="14" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="NASA APOD API Key (Free at api.nasa.gov — falls back to cached APOD when rate-limited)" FontSize="12" Opacity="0.75" />
                        <TextBox x:Name="NasaApiKeyBox" PlaceholderText="DEMO_KEY (or paste personal NASA key)" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Custom Forecast Endpoint (Defaults to Open-Meteo UTC + 7Timer ASTRO)" FontSize="12" Opacity="0.75" />
                        <TextBox x:Name="WeatherEndpointBox" PlaceholderText="https://api.open-meteo.com/v1/forecast" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Commercial Forecast API Key (Optional)" FontSize="12" Opacity="0.75" />
                        <TextBox x:Name="WeatherApiKeyBox" PlaceholderText="Optional API key" />
                    </StackPanel>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText"
                                   Text="Catalogs: ESA Hipparcos (I/239), Yale Bright Star (V/50), IAU WGSN, d3-celestial (BSD-3), NASA/Hubble PD."
                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Grid.Column="1" x:Name="SaveKeysButton" Content="Save Keys" Style="{StaticResource AccentButtonStyle}" Click="SaveKeysButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
