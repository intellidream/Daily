<Page
    x:Class="Daily_WinUI.Views.HealthDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:chart="using:Syncfusion.UI.Xaml.Charts"
    xmlns:controls="using:Daily_WinUI.Controls"
    xmlns:local="using:Daily_WinUI.Views"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Grid Background="Transparent">
        <!-- Adaptive Responsive Layout Breakpoints -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="MobileState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HealthShell.Margin" Value="10,0,10,12" />
                        <Setter Target="HealthShell.Padding" Value="10" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DesktopState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HealthShell.Margin" Value="20,0,20,20" />
                        <Setter Target="HealthShell.Padding" Value="20" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="110" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Standard TopBar (Consistent with WeatherDetailPage, HabitsDetailPage, FinancesDetailPage) -->
        <Grid Grid.Row="0" Padding="20,0" VerticalAlignment="Center" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 40x40 Circle Icon -->
            <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource AppGlassColorBrush}" VerticalAlignment="Center">
                <FontIcon Glyph="&#xEB51;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#FF2D55" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,16,0">
                <TextBlock Text="Health Hub" FontSize="32" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource AppFgColorBrush}"/>
                <TextBlock Text="Unified Daily Vitals, Sleep &amp; Stress Studio" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
            </StackPanel>

            <!-- Actions Row: Date Navigator + Device Filter Menu + Force Sync -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Day Navigator Pill -->
                <Border Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="4,2">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="PrevDayButton" Click="PrevDayButton_Click" ToolTipService.ToolTip="Previous Day" Padding="8,5" CornerRadius="6" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE76B;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                        </Button>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="4,0">
                            <FontIcon Glyph="&#xE787;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#FF2D55" />
                            <TextBlock x:Name="SelectedDateTextBlock" Text="Today" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource AppFgColorBrush}" />
                        </StackPanel>
                        <Button x:Name="NextDayButton" Click="NextDayButton_Click" ToolTipService.ToolTip="Next Day" Padding="8,5" CornerRadius="6" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Jump Today Button -->
                <Button x:Name="JumpTodayButton" Content="Today" Click="JumpTodayButton_Click" Visibility="{x:Bind JumpTodayVisibility, Mode=OneWay}" CornerRadius="8" Padding="10,6" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" />

                <!-- Multi-Device Filter Selector -->
                <DropDownButton x:Name="DeviceSelectorButton" CornerRadius="8" Padding="10,6" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{x:Bind SelectedDeviceDotBrush, Mode=OneWay}" VerticalAlignment="Center" />
                        <FontIcon Glyph="{x:Bind SelectedDeviceGlyph, Mode=OneWay}" FontFamily="Segoe Fluent Icons" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource AppFgColorBrush}" />
                        <TextBlock Text="{x:Bind SelectedDeviceLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource AppFgColorBrush}" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="DeviceMenuFlyout" />
                    </DropDownButton.Flyout>
                </DropDownButton>

                <!-- Force Sync Button -->
                <Button x:Name="SyncButton" Click="SyncButton_Click" IsEnabled="{x:Bind IsNotSyncing, Mode=OneWay}" CornerRadius="8" Padding="12,6" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ProgressRing Width="14" Height="14" IsActive="{x:Bind IsSyncing, Mode=OneWay}" Visibility="{x:Bind SyncRingVisibility, Mode=OneWay}" />
                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12" Visibility="{x:Bind SyncIconVisibility, Mode=OneWay}" Foreground="{ThemeResource AppFgColorBrush}" />
                        <TextBlock Text="Sync" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource AppFgColorBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Shell -->
        <Border x:Name="HealthShell" Grid.Row="1" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="20" Margin="20,0,20,20" Padding="16">
            <!-- 5-Tab Pivot Navigation -->
            <Pivot x:Name="HealthPivot" SelectionChanged="HealthPivot_SelectionChanged">
                <Pivot.Resources>
                    <Thickness x:Key="PivotItemMargin">0</Thickness>
                </Pivot.Resources>

                <!-- ========================================== -->
                <!-- TAB 0: OVERVIEW                           -->
                <!-- ========================================== -->
                <PivotItem Header="Overview">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Padding="0,8,12,20">

                            <!-- HERO ACTIVITY & SLEEP SUMMARY -->
                            <Border Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <TextBlock Text="DAILY BIOMETRICS &amp; ACTIVITY" FontSize="11" FontWeight="Bold" CharacterSpacing="80" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{x:Bind HasDominantDevice, Mode=OneWay}">
                                            <controls:DeviceOriginBadge DeviceName="{x:Bind DominantDeviceName, Mode=OneWay}" IsCompact="True" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 4 Hero Columns -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Steps -->
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <TextBlock Text="STEPS" FontSize="10" FontWeight="Bold" CharacterSpacing="80" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind StepsText, Mode=OneWay}" FontSize="26" FontWeight="Bold" Foreground="#FF2D55" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            <!-- Progress towards 10k -->
                                            <ProgressBar Value="{x:Bind StepsProgressValue, Mode=OneWay}" Maximum="100" Height="3" CornerRadius="1.5" Foreground="#FF2D55" Background="{ThemeResource AppGlassBorderColorBrush}" Width="70" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- Calories -->
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <TextBlock Text="CALORIES" FontSize="10" FontWeight="Bold" CharacterSpacing="80" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind CaloriesText, Mode=OneWay}" FontSize="26" FontWeight="Bold" Foreground="#FF9500" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            <TextBlock Text="active kcal" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- Sleep -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                            <TextBlock Text="SLEEP" FontSize="10" FontWeight="Bold" CharacterSpacing="80" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind SleepText, Mode=OneWay}" FontSize="26" FontWeight="Bold" Foreground="#00C7BE" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            <TextBlock Text="{x:Bind SleepEfficiencySummaryText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- Stress -->
                                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                            <TextBlock Text="STRESS" FontSize="10" FontWeight="Bold" CharacterSpacing="80" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind StressScoreText, Mode=OneWay}" FontSize="26" FontWeight="Bold" Foreground="{x:Bind StressScoreBrush, Mode=OneWay}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            <TextBlock Text="{x:Bind StressLevelLabelText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Activity Sub-Metrics Row -->
                                    <Border Background="{ThemeResource AppGlassColorBrush}" CornerRadius="10" Padding="14,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                                <FontIcon Glyph="&#xE819;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#34C759" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind DistanceText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                                <FontIcon Glyph="&#xE74A;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#00C7BE" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind FloorsText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                                <FontIcon Glyph="&#xE8A4;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#FF9500" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind SpeedText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- HOURLY STEPS HISTOGRAM (24H) -->
                            <Border Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7EE;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#FF2D55" />
                                            <TextBlock Text="24-Hour Steps Cadence" FontSize="15" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind HourlyStepsMaxText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <chart:SfCartesianChart Height="150">
                                        <chart:SfCartesianChart.XAxes>
                                            <chart:CategoryAxis ShowMajorGridLines="False" />
                                        </chart:SfCartesianChart.XAxes>
                                        <chart:SfCartesianChart.YAxes>
                                            <chart:NumericalAxis ShowMajorGridLines="True" />
                                        </chart:SfCartesianChart.YAxes>
                                        <chart:ColumnSeries ItemsSource="{x:Bind HourlyStepsCollection, Mode=OneWay}" XBindingPath="Label" YBindingPath="Value" Fill="#FF2D55" />
                                    </chart:SfCartesianChart>
                                </StackPanel>
                            </Border>

                            <!-- QUICK PREVIEWS: SLEEP & STRESS STUDIOS -->
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Sleep Preview Card -->
                                <Border Grid.Column="0" Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Tapped="SleepPreview_Tapped">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="56" Height="56" CornerRadius="28" Background="#1A00C7BE" BorderBrush="#00C7BE" BorderThickness="2" VerticalAlignment="Center">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{x:Bind SleepScoreText, Mode=OneWay}" FontSize="17" FontWeight="Bold" Foreground="#00C7BE" HorizontalAlignment="Center" />
                                                <TextBlock Text="SCORE" FontSize="8" Opacity="0.6" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="Sleep Studio" FontSize="15" FontWeight="SemiBold" />
                                                <FontIcon Glyph="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind SleepVerdictSummaryText, Mode=OneWay}" FontSize="12" Foreground="#00C7BE" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind SleepScheduleText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Stress Preview Card -->
                                <Border Grid.Column="1" Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Tapped="StressPreview_Tapped">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="56" Height="56" CornerRadius="28" Background="{x:Bind MonkeyMoodBackgroundBrush, Mode=OneWay}" BorderBrush="{x:Bind MonkeyMoodBorderBrush, Mode=OneWay}" BorderThickness="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind MonkeyMoodEmoji, Mode=OneWay}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="Stress Studio" FontSize="15" FontWeight="SemiBold" />
                                                <FontIcon Glyph="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind MonkeyMoodLabelText, Mode=OneWay}" FontSize="12" Foreground="{x:Bind MonkeyMoodBorderBrush, Mode=OneWay}" Margin="0,2,0,0" />
                                            <TextBlock Text="{x:Bind AutonomicDominantText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 8-TILE KEY VITALS GRID -->
                            <TextBlock Text="Key Vitals &amp; Biometrics" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />

                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 1. Heart Rate -->
                                <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <FontIcon Glyph="&#xEB51;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#FF2D55" Margin="0,0,0,4" />
                                        <TextBlock Text="HEART RATE" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource AppFgMutedColorBrush}" CharacterSpacing="50" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind HeartRateText, Mode=OneWay}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- 2. Resting Heart Rate -->
                                <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <FontIcon Glyph="&#xE95E;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#FF2D55" Margin="0,0,0,4" />
                                        <TextBlock Text="RESTING HR" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource AppFgMutedColorBrush}" CharacterSpacing="50" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind RhrText, Mode=OneWay}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- 3. HRV -->
                                <Border Grid.Row="0" Grid.Column="2" Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <FontIcon Glyph="&#xEC92;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#AF52DE" Margin="0,0,0,4" />
                                        <TextBlock Text="HRV (SDNN)" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource AppFgMutedColorBrush}" CharacterSpacing="50" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind HrvText, Mode=OneWay}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- 4. SpO2 -->
                                <Border Grid.Row="0" Grid.Column="3" Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <FontIcon Glyph="&#xE7EE;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#00C7BE" Margin="0,0,0,4" />
                                        <TextBlock Text="BLOOD OXYGEN" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource AppFgMutedColorBrush}" CharacterSpacing="50" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Spo2Text, Mode=OneWay}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- 5. Blood Pressure -->
                                <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <FontIcon Glyph="&#xE8D5;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#FF9500" Margin="0,0,0,4" />
                                        <TextBlock Text="BLOOD PRESS." FontSize="9" FontWeight="Bold" Foreground="{ThemeResource AppFgMutedColorBrush}" CharacterSpacing="50" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind BloodPressureText, Mode=OneWay}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- 6. Respiration -->
                                <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <FontIcon Glyph="&#xE753;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#34C759" Margin="0,0,0,4" />
                                        <TextBlock Text="RESP. RATE" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource AppFgMutedColorBrush}" CharacterSpacing="50" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind RespText, Mode=OneWay}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- 7. Glucose -->
                                <Border Grid.Row="1" Grid.Column="2" Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <FontIcon Glyph="&#xE7B7;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#FF9500" Margin="0,0,0,4" />
                                        <TextBlock Text="GLUCOSE" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource AppFgMutedColorBrush}" CharacterSpacing="50" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind GlucoseText, Mode=OneWay}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- 8. Weight -->
                                <Border Grid.Row="1" Grid.Column="3" Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <FontIcon Glyph="&#xEC0A;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#3897F0" Margin="0,0,0,4" />
                                        <TextBlock Text="WEIGHT" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource AppFgMutedColorBrush}" CharacterSpacing="50" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind WeightText, Mode=OneWay}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- BODY COMPOSITION -->
                            <Border Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="BODY FAT" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind BodyFatText, Mode=OneWay}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{ThemeResource AppGlassBorderColorBrush}" />

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="BMI" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind BmiText, Mode=OneWay}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="3" Background="{ThemeResource AppGlassBorderColorBrush}" />

                                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                        <TextBlock Text="LEAN MASS" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind LeanMassText, Mode=OneWay}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <!-- ========================================== -->
                <!-- TAB 1: SLEEP STUDIO                       -->
                <!-- ========================================== -->
                <PivotItem Header="Sleep Studio">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Padding="0,8,12,20">

                            <!-- Hero Sleep Architecture Card -->
                            <Border Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                                <StackPanel Spacing="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="LAST NIGHT'S SLEEP" FontSize="11" FontWeight="Bold" Foreground="#00C7BE" />
                                                <controls:DeviceOriginBadge DeviceName="{x:Bind SleepSourceDevice, Mode=OneWay}" IsCompact="True" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind TotalSleepText, Mode=OneWay}" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource AppFgColorBrush}" />
                                            <TextBlock Text="{x:Bind SleepScheduleAndEfficiencyText, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                                        </StackPanel>

                                        <!-- Sleep Score Radial Ring -->
                                        <Border Grid.Column="1" Width="74" Height="74" CornerRadius="37" Background="#1A00C7BE" BorderBrush="#00C7BE" BorderThickness="3" VerticalAlignment="Center">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{x:Bind SleepScoreText, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="#00C7BE" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind SleepQualityRatingText, Mode=OneWay}" FontSize="8.5" FontWeight="SemiBold" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource AppGlassBorderColorBrush}" />

                                    <!-- Bedtime, Wake Time, In Bed, Restorative Row -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="BEDTIME" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                                            <TextBlock Text="{x:Bind BedtimeText, Mode=OneWay}" FontSize="14" FontWeight="Bold" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="WAKE TIME" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                                            <TextBlock Text="{x:Bind WakeTimeText, Mode=OneWay}" FontSize="14" FontWeight="Bold" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="IN BED" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                                            <TextBlock Text="{x:Bind TimeInBedText, Mode=OneWay}" FontSize="14" FontWeight="Bold" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Spacing="2">
                                            <TextBlock Text="RESTORATIVE" FontSize="9.5" FontWeight="Bold" Foreground="#00C7BE" />
                                            <TextBlock Text="{x:Bind RestorativePctText, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="#00C7BE" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Recovery Verdict & Clinical Readiness Card -->
                            <Border Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="17" Background="#2600C7BE" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE708;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#00C7BE" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Sleep Readiness Verdict:" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                                            <TextBlock Text="{x:Bind SleepVerdictQualityText, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#00C7BE" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind SleepVerdictSummaryText, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource AppFgColorBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- CLINICAL HYPNOGRAM & STAGE PROPORTIONS CARD -->
                            <Border Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind HypnogramHeaderTitle, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" />
                                        </StackPanel>
                                        
                                        <!-- Stage Legend Pills (Deep, REM, Core, Awake) -->
                                        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4"><Ellipse Width="7" Height="7" Fill="#FF7043" /><TextBlock Text="Awake" FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4"><Ellipse Width="7" Height="7" Fill="#26C6DA" /><TextBlock Text="REM" FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4"><Ellipse Width="7" Height="7" Fill="#42A5F5" /><TextBlock Text="Core" FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4"><Ellipse Width="7" Height="7" Fill="#3949AB" /><TextBlock Text="Deep" FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}" /></StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Interactive Inspection Pill (Appears when user clicks any stage) -->
                                    <Border Visibility="{x:Bind SelectedStagePillVisibility, Mode=OneWay}" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{x:Bind SelectedStageColorBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="14" Padding="12,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{x:Bind SelectedStageColorBrush, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind SelectedStageName, Mode=OneWay}" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource AppFgColorBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind SelectedStageTimeRange, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind SelectedStageDurationText, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#00C7BE" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <Button Grid.Column="4" Padding="4" Background="Transparent" BorderThickness="0" Click="ClearStageSelection_Click">
                                                <FontIcon Glyph="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Conditional View A: 4-Level Granular Hypnogram Canvas -->
                                    <Grid Visibility="{x:Bind GranularHypnogramVisibility, Mode=OneWay}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 4-Level Canvas & Labels -->
                                        <Grid Grid.Row="0" Height="150" Background="#12000000" CornerRadius="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Y-Axis Stage Labels -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Stretch" Padding="6,6,0,6">
                                                <TextBlock Text="AWAKE" FontSize="9" FontWeight="SemiBold" Foreground="#FF7043" Height="34" VerticalAlignment="Center" />
                                                <TextBlock Text="REM" FontSize="9" FontWeight="SemiBold" Foreground="#26C6DA" Height="34" VerticalAlignment="Center" />
                                                <TextBlock Text="CORE" FontSize="9" FontWeight="SemiBold" Foreground="#42A5F5" Height="34" VerticalAlignment="Center" />
                                                <TextBlock Text="DEEP" FontSize="9" FontWeight="SemiBold" Foreground="#3949AB" Height="34" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <Border Grid.Column="0" Width="1" Background="{ThemeResource AppGlassBorderColorBrush}" HorizontalAlignment="Right" />

                                            <!-- Hypnogram Canvas -->
                                            <Canvas x:Name="SleepHypnogramCanvas" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SizeChanged="SleepHypnogramCanvas_SizeChanged" />
                                        </Grid>

                                        <!-- X-Axis Hourly Ticks Canvas -->
                                        <Grid Grid.Row="1" Height="22" Margin="56,2,0,0">
                                            <Canvas x:Name="SleepXAxisCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                        </Grid>
                                    </Grid>

                                    <!-- Conditional View B: Stage Proportion Bar (When granular hypnogram is not available) -->
                                    <StackPanel Visibility="{x:Bind StageProportionVisibility, Mode=OneWay}" Spacing="6" Margin="0,4,0,8">
                                        <Canvas x:Name="StageProportionCanvas" Height="22" HorizontalAlignment="Stretch" SizeChanged="StageProportionCanvas_SizeChanged" />
                                    </StackPanel>

                                    <!-- 4 Stage Breakdown Cards -->
                                    <Grid ColumnSpacing="10" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="#3949AB" BorderThickness="1" CornerRadius="10" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="DEEP" FontSize="10" FontWeight="Bold" Foreground="#3949AB" />
                                                <TextBlock Text="{x:Bind DeepDurationText, Mode=OneWay}" FontSize="15" FontWeight="Bold" Margin="0,2,0,0" />
                                                <TextBlock Text="{x:Bind DeepPercentText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="#26C6DA" BorderThickness="1" CornerRadius="10" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="REM" FontSize="10" FontWeight="Bold" Foreground="#26C6DA" />
                                                <TextBlock Text="{x:Bind RemDurationText, Mode=OneWay}" FontSize="15" FontWeight="Bold" Margin="0,2,0,0" />
                                                <TextBlock Text="{x:Bind RemPercentText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="#42A5F5" BorderThickness="1" CornerRadius="10" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="CORE" FontSize="10" FontWeight="Bold" Foreground="#42A5F5" />
                                                <TextBlock Text="{x:Bind LightDurationText, Mode=OneWay}" FontSize="15" FontWeight="Bold" Margin="0,2,0,0" />
                                                <TextBlock Text="{x:Bind LightPercentText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="3" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="#FF7043" BorderThickness="1" CornerRadius="10" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="AWAKE" FontSize="10" FontWeight="Bold" Foreground="#FF7043" />
                                                <TextBlock Text="{x:Bind AwakeDurationText, Mode=OneWay}" FontSize="15" FontWeight="Bold" Margin="0,2,0,0" />
                                                <TextBlock Text="{x:Bind AwakePercentText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- DAYTIME NAPS SECTION (Shown when naps exist) -->
                            <Border Visibility="{x:Bind HasNapsVisibility, Mode=OneWay}" Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE708;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#FF9500" />
                                        <TextBlock Text="Daytime Naps" FontSize="15" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{x:Bind DaytimeNapsList, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:NapDisplayItem">
                                                <Border Background="{ThemeResource AppGlassColorBrush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind TimeRange}" FontSize="13" FontWeight="SemiBold" />
                                                            <TextBlock Text="{x:Bind DurationText}" FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                                                        </StackPanel>
                                                        <controls:DeviceOriginBadge Grid.Column="1" DeviceName="{x:Bind DeviceName}" IsCompact="True" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind NapMinutesText}" FontSize="14" FontWeight="Bold" Foreground="#FF9500" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- AI SLEEP HYGIENE & RECOVERY TIPS -->
                            <Border Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#00C7BE" />
                                        <TextBlock Text="AI Sleep Hygiene &amp; Recovery Protocol" FontSize="15" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Tip 1: Circadian -->
                                        <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource AppGlassColorBrush}" CornerRadius="10" Padding="12">
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE706;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#FF9500" />
                                                    <TextBlock Text="Circadian Rhythm" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind TipCircadianText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Tip 2: Bedroom Climate -->
                                        <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource AppGlassColorBrush}" CornerRadius="10" Padding="12">
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE790;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#00C7BE" />
                                                    <TextBlock Text="Bedroom Climate" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind TipClimateText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Tip 3: Evening Nutrition -->
                                        <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource AppGlassColorBrush}" CornerRadius="10" Padding="12">
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#AF52DE" />
                                                    <TextBlock Text="Evening Nutrition" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind TipNutritionText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Tip 4: Wind-Down Protocol -->
                                        <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource AppGlassColorBrush}" CornerRadius="10" Padding="12">
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xEC92;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#3897F0" />
                                                    <TextBlock Text="Wind-Down Protocol" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind TipWindDownText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <!-- ========================================== -->
                <!-- TAB 2: STRESS STUDIO                      -->
                <!-- ========================================== -->
                <PivotItem Header="Stress Studio">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Padding="0,8,12,20">

                            <!-- MONKEY MASCOT & AUTONOMIC BALANCE -->
                            <Border Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                                <StackPanel Spacing="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="72" Height="72" CornerRadius="36" Background="{x:Bind MonkeyMoodBackgroundBrush, Mode=OneWay}" BorderBrush="{x:Bind MonkeyMoodBorderBrush, Mode=OneWay}" BorderThickness="3">
                                            <TextBlock Text="{x:Bind MonkeyMoodEmoji, Mode=OneWay}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Monkey Mascot:" FontSize="13" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                                                <TextBlock Text="{x:Bind MonkeyMoodLabelText, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="{x:Bind MonkeyMoodBorderBrush, Mode=OneWay}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind MonkeyMoodDescriptionText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AppFgColorBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="STRESS SCORE" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{x:Bind StressScoreText, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="{x:Bind MonkeyMoodBorderBrush, Mode=OneWay}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Autonomic Balance Bar (Sympathetic vs Parasympathetic) -->
                                    <Border Background="{ThemeResource AppGlassColorBrush}" CornerRadius="12" Padding="16,12">
                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <TextBlock Text="Autonomic Balance" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind AutonomicDominantText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Right" />
                                            </Grid>

                                            <ProgressBar Value="{x:Bind ParasympatheticRatioPct, Mode=OneWay}" Maximum="100" Height="8" CornerRadius="4" Foreground="#34C759" Background="#FF7043" />

                                            <Grid>
                                                <TextBlock Text="{x:Bind SympatheticLabelText, Mode=OneWay}" FontSize="11" Foreground="#FF7043" />
                                                <TextBlock Text="{x:Bind ParasympatheticLabelText, Mode=OneWay}" FontSize="11" Foreground="#34C759" HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 4 STRESS DRIVERS BREAKDOWN -->
                            <Border Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Stress &amp; Strain Drivers" FontSize="15" FontWeight="SemiBold" />

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Driver 1: Activity -->
                                        <Border Grid.Column="0" Background="{ThemeResource AppGlassColorBrush}" CornerRadius="10" Padding="12">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="ACTIVITY" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                                                <TextBlock Text="{x:Bind DriverActivityText, Mode=OneWay}" FontSize="15" FontWeight="Bold" />
                                                <ProgressBar Value="{x:Bind DriverActivityPct, Mode=OneWay}" Maximum="100" Height="4" CornerRadius="2" Foreground="#FF9500" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Driver 2: Sleep Deficit -->
                                        <Border Grid.Column="1" Background="{ThemeResource AppGlassColorBrush}" CornerRadius="10" Padding="12">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="SLEEP DEFICIT" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                                                <TextBlock Text="{x:Bind DriverSleepText, Mode=OneWay}" FontSize="15" FontWeight="Bold" />
                                                <ProgressBar Value="{x:Bind DriverSleepPct, Mode=OneWay}" Maximum="100" Height="4" CornerRadius="2" Foreground="#AF52DE" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Driver 3: HRV Suppression -->
                                        <Border Grid.Column="2" Background="{ThemeResource AppGlassColorBrush}" CornerRadius="10" Padding="12">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="HRV DIP" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                                                <TextBlock Text="{x:Bind DriverHrvText, Mode=OneWay}" FontSize="15" FontWeight="Bold" />
                                                <ProgressBar Value="{x:Bind DriverHrvPct, Mode=OneWay}" Maximum="100" Height="4" CornerRadius="2" Foreground="#3897F0" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Driver 4: Spikes -->
                                        <Border Grid.Column="3" Background="{ThemeResource AppGlassColorBrush}" CornerRadius="10" Padding="12">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="SPIKES" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                                                <TextBlock Text="{x:Bind DriverSpikesText, Mode=OneWay}" FontSize="15" FontWeight="Bold" />
                                                <ProgressBar Value="{x:Bind DriverSpikesPct, Mode=OneWay}" Maximum="100" Height="4" CornerRadius="2" Foreground="#FF2D55" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- INTERACTIVE BOX BREATHING PLAYER -->
                            <Border Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                                <StackPanel Spacing="16">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE753;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#34C759" />
                                            <TextBlock Text="Box Breathing Exercise (4-4-4-4)" FontSize="15" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <Button x:Name="BreathingButton" Content="{x:Bind BreathingButtonText, Mode=OneWay}" Click="BreathingButton_Click" HorizontalAlignment="Right" CornerRadius="6" Padding="12,4" />
                                    </Grid>

                                    <!-- Visual Breathing Circle Indicator -->
                                    <Grid Height="140">
                                        <Border Width="110" Height="110" CornerRadius="55" Background="#1234C759" BorderBrush="#34C759" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border x:Name="BreathingCircle" Width="90" Height="90" CornerRadius="45" Background="#2A34C759" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock x:Name="BreathingPhaseText" Text="Ready" FontSize="16" FontWeight="Bold" Foreground="#34C759" HorizontalAlignment="Center" />
                                                <TextBlock x:Name="BreathingTimerText" Text="4s" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="Calibrate your vagal nerve and restore parasympathetic dominance." FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <!-- ========================================== -->
                <!-- TAB 3: HEART & VITALS                     -->
                <!-- ========================================== -->
                <PivotItem Header="Heart &amp; Vitals">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Padding="0,8,12,20">

                            <!-- CONTINUOUS INTRADAY HEART RATE CHART -->
                            <Border Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xEB51;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#FF2D55" />
                                            <TextBlock Text="Continuous Intraday Heart Rate" FontSize="16" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind AvgHeartRateText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#FF2D55" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <chart:SfCartesianChart Height="210">
                                        <chart:SfCartesianChart.XAxes>
                                            <chart:DateTimeAxis ShowMajorGridLines="False" />
                                        </chart:SfCartesianChart.XAxes>
                                        <chart:SfCartesianChart.YAxes>
                                            <chart:NumericalAxis ShowMajorGridLines="True" Minimum="40" Maximum="180" Interval="20" />
                                        </chart:SfCartesianChart.YAxes>
                                        <chart:SplineSeries ItemsSource="{x:Bind HeartRateCollection, Mode=OneWay}" XBindingPath="LocalStartTime" YBindingPath="NumericValue" Fill="#FF2D55" />
                                    </chart:SfCartesianChart>

                                    <!-- 4 Heart Rate Zones -->
                                    <Grid ColumnSpacing="10" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#1234C759" CornerRadius="8" Padding="10">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="RESTING (&lt;100)" FontSize="9" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind HrRestingPctText, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="#34C759" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Background="#12FF9500" CornerRadius="8" Padding="10">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="FAT BURN (100-120)" FontSize="9" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind HrFatBurnPctText, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="#FF9500" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="#12FF7043" CornerRadius="8" Padding="10">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="CARDIO (120-150)" FontSize="9" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind HrCardioPctText, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="#FF7043" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="3" Background="#12FF2D55" CornerRadius="8" Padding="10">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="PEAK (&gt;150)" FontSize="9" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind HrPeakPctText, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="#FF2D55" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- FULL VITALS LIST -->
                            <Border Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Cardiovascular &amp; Metabolic Baseline" FontSize="15" FontWeight="SemiBold" />

                                    <Grid ColumnSpacing="16" RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="Resting Heart Rate" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                                            <TextBlock Text="{x:Bind RhrText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1">
                                            <TextBlock Text="HRV (SDNN)" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                                            <TextBlock Text="{x:Bind HrvText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="Blood Oxygen (SpO2)" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                                            <TextBlock Text="{x:Bind Spo2Text, Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0">
                                            <TextBlock Text="Blood Pressure" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                                            <TextBlock Text="{x:Bind BloodPressureText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock Text="Respiration Rate" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                                            <TextBlock Text="{x:Bind RespText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="2">
                                            <TextBlock Text="Blood Glucose" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                                            <TextBlock Text="{x:Bind GlucoseText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <!-- ========================================== -->
                <!-- TAB 4: TRENDS                             -->
                <!-- ========================================== -->
                <PivotItem Header="Trends">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Padding="0,8,12,20">

                            <!-- STEPS 7-DAY TREND CARD -->
                            <Border Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7EE;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#FF2D55" />
                                        <TextBlock Text="Steps (7-Day)" FontSize="15" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <chart:SfCartesianChart Height="150">
                                        <chart:SfCartesianChart.XAxes>
                                            <chart:CategoryAxis ShowMajorGridLines="False" />
                                        </chart:SfCartesianChart.XAxes>
                                        <chart:SfCartesianChart.YAxes>
                                            <chart:NumericalAxis ShowMajorGridLines="True" />
                                        </chart:SfCartesianChart.YAxes>
                                        <chart:FastLineSeries ItemsSource="{x:Bind StepsHistory, Mode=OneWay}" XBindingPath="Label" YBindingPath="Value" Fill="#FF2D55" />
                                    </chart:SfCartesianChart>

                                    <!-- Stats Row -->
                                    <Border Background="{ThemeResource AppGlassColorBrush}" CornerRadius="8" Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                <TextBlock Text="AVG" FontSize="9" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind StepsAvgText, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                <TextBlock Text="HIGH" FontSize="9" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind StepsMaxText, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                <TextBlock Text="LOW" FontSize="9" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind StepsMinText, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                                <TextBlock Text="TOTAL" FontSize="9" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind StepsTotalText, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- SLEEP 7-DAY TREND CARD -->
                            <Border Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE708;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#00C7BE" />
                                        <TextBlock Text="Sleep Duration (7-Day)" FontSize="15" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <chart:SfCartesianChart Height="150">
                                        <chart:SfCartesianChart.XAxes>
                                            <chart:CategoryAxis ShowMajorGridLines="False" />
                                        </chart:SfCartesianChart.XAxes>
                                        <chart:SfCartesianChart.YAxes>
                                            <chart:NumericalAxis ShowMajorGridLines="True" />
                                        </chart:SfCartesianChart.YAxes>
                                        <chart:ColumnSeries ItemsSource="{x:Bind SleepHistory, Mode=OneWay}" XBindingPath="Label" YBindingPath="Value" Fill="#00C7BE" />
                                    </chart:SfCartesianChart>

                                    <!-- Stats Row -->
                                    <Border Background="{ThemeResource AppGlassColorBrush}" CornerRadius="8" Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                <TextBlock Text="AVG DURATION" FontSize="9" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind SleepAvgText, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                <TextBlock Text="LONGEST" FontSize="9" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind SleepMaxText, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                <TextBlock Text="SHORTEST" FontSize="9" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind SleepMinText, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- RESTING HEART RATE 7-DAY TREND CARD -->
                            <Border Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEB51;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#FF2D55" />
                                        <TextBlock Text="Heart Rate (7-Day)" FontSize="15" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <chart:SfCartesianChart Height="150">
                                        <chart:SfCartesianChart.XAxes>
                                            <chart:CategoryAxis ShowMajorGridLines="False" />
                                        </chart:SfCartesianChart.XAxes>
                                        <chart:SfCartesianChart.YAxes>
                                            <chart:NumericalAxis ShowMajorGridLines="True" />
                                        </chart:SfCartesianChart.YAxes>
                                        <chart:FastLineSeries ItemsSource="{x:Bind HrHistory, Mode=OneWay}" XBindingPath="Label" YBindingPath="Value" Fill="#FF2D55" />
                                    </chart:SfCartesianChart>

                                    <Border Background="{ThemeResource AppGlassColorBrush}" CornerRadius="8" Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                <TextBlock Text="AVG BPM" FontSize="9" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind HrAvgText, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                <TextBlock Text="MAX BPM" FontSize="9" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind HrMaxText, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                <TextBlock Text="MIN BPM" FontSize="9" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind HrMinText, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- CALORIES 7-DAY TREND CARD -->
                            <Border Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A4;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#FF9500" />
                                        <TextBlock Text="Active Calories (7-Day)" FontSize="15" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <chart:SfCartesianChart Height="150">
                                        <chart:SfCartesianChart.XAxes>
                                            <chart:CategoryAxis ShowMajorGridLines="False" />
                                        </chart:SfCartesianChart.XAxes>
                                        <chart:SfCartesianChart.YAxes>
                                            <chart:NumericalAxis ShowMajorGridLines="True" />
                                        </chart:SfCartesianChart.YAxes>
                                        <chart:ColumnSeries ItemsSource="{x:Bind CaloriesHistory, Mode=OneWay}" XBindingPath="Label" YBindingPath="Value" Fill="#FF9500" />
                                    </chart:SfCartesianChart>

                                    <Border Background="{ThemeResource AppGlassColorBrush}" CornerRadius="8" Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                <TextBlock Text="AVG" FontSize="9" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind CaloriesAvgText, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                <TextBlock Text="MAX" FontSize="9" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind CaloriesMaxText, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                <TextBlock Text="MIN" FontSize="9" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind CaloriesMinText, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                                <TextBlock Text="TOTAL" FontSize="9" Foreground="{ThemeResource AppFgMutedColorBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind CaloriesTotalText, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

            </Pivot>
        </Border>
    </Grid>
</Page>
