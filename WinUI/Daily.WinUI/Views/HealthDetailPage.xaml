                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Text="Blood Pressure" FontSize="12" Opacity="0.6" />
                                        <TextBlock Text="{x:Bind BloodPressureText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Text="Respiration Rate" FontSize="12" Opacity="0.6" />
                                        <TextBlock Text="{x:Bind RespText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                        <TextBlock Text="Blood Glucose" FontSize="12" Opacity="0.6" />
