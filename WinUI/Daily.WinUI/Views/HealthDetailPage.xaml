                                    <Border Grid.Column="0" Background="#104CAF50" CornerRadius="8" Padding="10">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="RESTING (&lt;100)" FontSize="10" Opacity="0.6" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind HrRestingPctText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center" Margin="0,2,0,0" />
