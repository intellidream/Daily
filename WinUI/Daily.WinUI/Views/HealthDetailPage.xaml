                                        <TextBlock Text="{x:Bind StressScoreText, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="{x:Bind MonkeyMoodBorderBrush, Mode=OneWay}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>

                                <!-- Autonomic Balance Bar (Sympathetic vs Parasympathetic) -->
                                <Border Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" CornerRadius="12" Padding="16,12">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <TextBlock Text="Autonomic Balance" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind AutonomicDominantText, Mode=OneWay}" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" />
                                        </Grid>

                                        <ProgressBar Value="{x:Bind ParasympatheticRatioPct, Mode=OneWay}" Maximum="100" Height="8" CornerRadius="4" Foreground="#4CAF50" Background="#FF7043" />

                                        <Grid>
                                            <TextBlock Text="{x:Bind SympatheticLabelText, Mode=OneWay}" FontSize="11" Foreground="#FF7043" />
                                            <TextBlock Text="{x:Bind ParasympatheticLabelText, Mode=OneWay}" FontSize="11" Foreground="#4CAF50" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 4 STRESS DRIVERS BREAKDOWN -->
                        <Border Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Stress &amp; Strain Drivers" FontSize="15" FontWeight="SemiBold" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Driver 1: Activity -->
                                    <Border Grid.Column="0" Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" CornerRadius="10" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="ACTIVITY" FontSize="10" Opacity="0.6" />
                                            <TextBlock Text="{x:Bind DriverActivityText, Mode=OneWay}" FontSize="15" FontWeight="Bold" />
                                            <ProgressBar Value="{x:Bind DriverActivityPct, Mode=OneWay}" Maximum="100" Height="4" CornerRadius="2" Foreground="#FF9800" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Driver 2: Sleep Deficit -->
                                    <Border Grid.Column="1" Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" CornerRadius="10" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="SLEEP DEFICIT" FontSize="10" Opacity="0.6" />
                                            <TextBlock Text="{x:Bind DriverSleepText, Mode=OneWay}" FontSize="15" FontWeight="Bold" />
                                            <ProgressBar Value="{x:Bind DriverSleepPct, Mode=OneWay}" Maximum="100" Height="4" CornerRadius="2" Foreground="#7C4DFF" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Driver 3: HRV Suppression -->
                                    <Border Grid.Column="2" Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" CornerRadius="10" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="HRV DIP" FontSize="10" Opacity="0.6" />
                                            <TextBlock Text="{x:Bind DriverHrvText, Mode=OneWay}" FontSize="15" FontWeight="Bold" />
                                            <ProgressBar Value="{x:Bind DriverHrvPct, Mode=OneWay}" Maximum="100" Height="4" CornerRadius="2" Foreground="#9C27B0" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Driver 4: Spikes -->
                                    <Border Grid.Column="3" Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" CornerRadius="10" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="SPIKES" FontSize="10" Opacity="0.6" />
                                            <TextBlock Text="{x:Bind DriverSpikesText, Mode=OneWay}" FontSize="15" FontWeight="Bold" />
                                            <ProgressBar Value="{x:Bind DriverSpikesPct, Mode=OneWay}" Maximum="100" Height="4" CornerRadius="2" Foreground="#FF5252" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- INTERACTIVE BOX BREATHING PLAYER -->
