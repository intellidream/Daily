                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                            <TextBlock Text="SHORTEST" FontSize="9" Opacity="0.6" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind SleepMinText, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- RESTING HEART RATE 7-DAY TREND CARD -->
                        <Border Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEB51;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#FF5252" />
                                    <TextBlock Text="Heart Rate (7-Day)" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>

                                <chart:SfCartesianChart Height="160">
                                    <chart:SfCartesianChart.XAxes>
                                        <chart:CategoryAxis ShowMajorGridLines="False" />
                                    </chart:SfCartesianChart.XAxes>
                                    <chart:SfCartesianChart.YAxes>
                                        <chart:NumericalAxis ShowMajorGridLines="True" />
                                    </chart:SfCartesianChart.YAxes>
                                    <chart:FastLineSeries ItemsSource="{x:Bind HrHistory, Mode=OneWay}" XBindingPath="Label" YBindingPath="Value" Fill="#FF5252" />
                                </chart:SfCartesianChart>

                                <Border Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" CornerRadius="8" Padding="12,8">
