            <!-- ========================================== -->
            <!-- TAB 2: STRESS STUDIO                      -->
            <!-- ========================================== -->
            <PivotItem Header="Stress Studio">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20" Padding="0,12,20,24">

                        <!-- MONKEY MASCOT & AUTONOMIC BALANCE -->
