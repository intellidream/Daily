                                <chart:SfCartesianChart Height="160">
                                    <chart:SfCartesianChart.XAxes>
                                        <chart:CategoryAxis ShowMajorGridLines="False" />
                                    </chart:SfCartesianChart.XAxes>
                                    <chart:SfCartesianChart.YAxes>
                                        <chart:NumericalAxis ShowMajorGridLines="True" />
                                    </chart:SfCartesianChart.YAxes>
                                    <chart:ColumnSeries ItemsSource="{x:Bind SleepHistory, Mode=OneWay}" XBindingPath="Label" YBindingPath="Value" Fill="#7C4DFF" />
                                </chart:SfCartesianChart>

                                <!-- Stats Row -->
                                <Border Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" CornerRadius="8" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <TextBlock Text="AVG DURATION" FontSize="9" Opacity="0.6" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind SleepAvgText, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
