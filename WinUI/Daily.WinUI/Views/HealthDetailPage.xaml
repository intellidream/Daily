                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- ========================================== -->
            <!-- TAB 3: HEART & VITALS                     -->
            <!-- ========================================== -->
            <PivotItem Header="Heart &amp; Vitals">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20" Padding="0,12,20,24">

                        <!-- CONTINUOUS INTRADAY HEART RATE CHART -->
                        <Border Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                            <StackPanel Spacing="14">
