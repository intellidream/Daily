<Page
    x:Class="Daily_WinUI.Views.HealthDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:chart="using:Syncfusion.UI.Xaml.Charts"
    xmlns:local="using:Daily_WinUI.Views"
    mc:Ignorable="d"
    Background="Transparent" DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Grid Background="Transparent">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="850" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- Main Layout adjustments -->
                        <Setter Target="MainCol1.Width" Value="0" />
                        <Setter Target="MainCol2.Width" Value="0" />
                        <Setter Target="HeroBorder.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="VitalsGrid.(Grid.Row)" Value="1" />
                        <Setter Target="VitalsGrid.(Grid.Column)" Value="0" />
                        <Setter Target="VitalsGrid.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="VitalsGrid.Margin" Value="0,24,0,0" />

                        <!-- Trends Grid adjustments -->
                        <Setter Target="TrendsCol1.Width" Value="0" />
                        <Setter Target="TrendsCol2.Width" Value="0" />
                        
                        <Setter Target="StepsCard.(Grid.Row)" Value="0" />
                        <Setter Target="StepsCard.(Grid.Column)" Value="0" />
                        <Setter Target="StepsCard.Margin" Value="0" />

                        <Setter Target="HrCard.(Grid.Row)" Value="1" />
                        <Setter Target="HrCard.(Grid.Column)" Value="0" />
                        <Setter Target="HrCard.Margin" Value="0,24,0,0" />

                        <Setter Target="SleepCard.(Grid.Row)" Value="2" />
                        <Setter Target="SleepCard.(Grid.Column)" Value="0" />
                        <Setter Target="SleepCard.Margin" Value="0,24,0,0" />

                        <Setter Target="CaloriesCard.(Grid.Row)" Value="3" />
                        <Setter Target="CaloriesCard.(Grid.Column)" Value="0" />
                        <Setter Target="CaloriesCard.Margin" Value="0,24,0,0" />

                        <Setter Target="WeightCard.(Grid.Row)" Value="4" />
                        <Setter Target="WeightCard.(Grid.Column)" Value="0" />
                        <Setter Target="WeightCard.Margin" Value="0,24,0,0" />

                        <Setter Target="HrvCard.(Grid.Row)" Value="5" />
                        <Setter Target="HrvCard.(Grid.Column)" Value="0" />
                        <Setter Target="HrvCard.Margin" Value="0,24,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="110" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Bar with Icon, Title and Action Button -->
        <Grid Grid.Row="0" Padding="20,0" VerticalAlignment="Center" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource AppGlassColorBrush}">
                    <FontIcon Glyph="&#xE95E;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{ThemeResource AppFgColorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Health" FontSize="32" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource AppFgColorBrush}" />
                    <TextBlock Text="Comprehensive biometrics and clinical hypnogram" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                </StackPanel>
            </StackPanel>

            <Button x:Name="SyncButton" Grid.Column="2" Content="Force Native Sync" Click="SyncButton_Click" IsEnabled="{x:Bind IsNotSyncing, Mode=OneWay}" />
        </Grid>

        <!-- 4-TAB SEGMENTED NAVIGATION (PIVOT) -->
        <Pivot Grid.Row="1" x:Name="HealthPivot" Margin="20,0,20,0" SelectionChanged="HealthPivot_SelectionChanged">
            <Pivot.Resources>
                <Thickness x:Key="PivotItemMargin">0</Thickness>
            </Pivot.Resources>

            <!-- TAB 1: OVERVIEW -->
            <PivotItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="24" Padding="0,16,0,20">
                        <Grid x:Name="MainGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="MainCol0" Width="2*" />
                                <ColumnDefinition x:Name="MainCol1" Width="24" />
                                <ColumnDefinition x:Name="MainCol2" Width="3*" />
                            </Grid.ColumnDefinitions>

                            <!-- LEFT COLUMN: Hero (Steps, Cals, Sleep) and Sub-metrics -->
                            <Border x:Name="HeroBorder" Grid.Column="0" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" Style="{StaticResource GlassPanelStyle}" Translation="0,0,18" CornerRadius="16" Padding="20">
                                <StackPanel Spacing="16">
                                    <!-- Hero Metrics Grid -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Steps -->
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="STEPS" FontSize="12" Opacity="0.6" Margin="0,0,0,4" HorizontalAlignment="Center" CharacterSpacing="100" />
                                            <TextBlock Text="{x:Bind StepsText, Mode=OneWay}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Calories -->
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="CALORIES" FontSize="12" Opacity="0.6" Margin="0,0,0,4" HorizontalAlignment="Center" CharacterSpacing="100" />
                                            <TextBlock Text="{x:Bind CaloriesText, Mode=OneWay}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FF9800" />
                                        </StackPanel>

                                        <!-- Sleep -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="SLEEP" FontSize="12" Opacity="0.6" Margin="0,0,0,4" HorizontalAlignment="Center" CharacterSpacing="100" />
                                            <TextBlock Text="{x:Bind SleepText, Mode=OneWay}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#7C4DFF" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Activity Sub-Metrics -->
                                    <Border Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" CornerRadius="12" Padding="16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Distance -->
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE819;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#4CAF50" Margin="0,0,0,4" />
                                                <TextBlock Text="{x:Bind DistanceText, Mode=OneWay}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" />
                                                <TextBlock Text="Distance" FontSize="10" Opacity="0.5" HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Floors -->
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE74A;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#00BCD4" Margin="0,0,0,4" />
                                                <TextBlock Text="{x:Bind FloorsText, Mode=OneWay}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" />
                                                <TextBlock Text="Floors" FontSize="10" Opacity="0.5" HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Speed -->
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE8A4;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#FF9800" Margin="0,0,0,4" />
                                                <TextBlock Text="{x:Bind SpeedText, Mode=OneWay}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" />
                                                <TextBlock Text="Pace" FontSize="10" Opacity="0.5" HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Basal -->
                                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE708;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#9C27B0" Margin="0,0,0,4" />
                                                <TextBlock Text="{x:Bind BasalCaloriesText, Mode=OneWay}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" />
                                                <TextBlock Text="Resting" FontSize="10" Opacity="0.5" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- RIGHT COLUMN: Core Vitals Grid -->
                            <Grid x:Name="VitalsGrid" Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Heart Rate -->
                                <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xEB51;" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="#FF5252" Margin="0,0,0,8" />
                                        <TextBlock Text="HEART RATE" FontSize="10" Opacity="0.6" HorizontalAlignment="Center" CharacterSpacing="50" Margin="0,0,0,4" />
                                        <TextBlock Text="{x:Bind HeartRateText, Mode=OneWay}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Blood Pressure -->
                                <Border Grid.Row="0" Grid.Column="2" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8D5;" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="#2196F3" Margin="0,0,0,8" />
                                        <TextBlock Text="BLOOD PRESSURE" FontSize="10" Opacity="0.6" HorizontalAlignment="Center" CharacterSpacing="50" Margin="0,0,0,4" />
                                        <TextBlock Text="{x:Bind BloodPressureText, Mode=OneWay}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- HRV -->
                                <Border Grid.Row="2" Grid.Column="0" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xEC92;" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="#9C27B0" Margin="0,0,0,8" />
                                        <TextBlock Text="HRV" FontSize="10" Opacity="0.6" HorizontalAlignment="Center" CharacterSpacing="50" Margin="0,0,0,4" />
                                        <TextBlock Text="{x:Bind HrvText, Mode=OneWay}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- SpO2 -->
                                <Border Grid.Row="2" Grid.Column="2" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE753;" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="#00BCD4" Margin="0,0,0,8" />
                                        <TextBlock Text="BLOOD OXYGEN" FontSize="10" Opacity="0.6" HorizontalAlignment="Center" CharacterSpacing="50" Margin="0,0,0,4" />
                                        <TextBlock Text="{x:Bind Spo2Text, Mode=OneWay}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Expanded Vitals Row -->
                        <Border Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" Style="{StaticResource GlassPanelStyle}" Translation="0,0,18" CornerRadius="16" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- RHR -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="RHR" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                    <TextBlock Text="{x:Bind RhrText, Mode=OneWay}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                                </StackPanel>

                                <Border Grid.Column="1" Background="{ThemeResource AppGlassBorderColorBrush}" />

                                <!-- RESP -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="RESP" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                    <TextBlock Text="{x:Bind RespText, Mode=OneWay}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                                </StackPanel>

                                <Border Grid.Column="3" Background="{ThemeResource AppGlassBorderColorBrush}" />

                                <!-- GLUCOSE -->
                                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                    <TextBlock Text="GLUCOSE" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                    <TextBlock Text="{x:Bind GlucoseText, Mode=OneWay}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                                </StackPanel>

                                <Border Grid.Column="5" Background="{ThemeResource AppGlassBorderColorBrush}" />

                                <!-- TEMP -->
                                <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                                    <TextBlock Text="TEMP" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                    <TextBlock Text="{x:Bind TempText, Mode=OneWay}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Trends Grid (7-Day Charts) -->
                        <Grid x:Name="TrendsGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="TrendsCol0" Width="*" />
                                <ColumnDefinition x:Name="TrendsCol1" Width="24" />
                                <ColumnDefinition x:Name="TrendsCol2" Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Steps Trend -->
                            <Border x:Name="StepsCard" Grid.Row="0" Grid.Column="0" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" Style="{StaticResource GlassPanelStyle}" Translation="0,0,18" CornerRadius="16" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Steps" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <chart:SfCartesianChart Height="120">
                                        <chart:SfCartesianChart.XAxes><chart:CategoryAxis ShowMajorGridLines="False" /></chart:SfCartesianChart.XAxes>
                                        <chart:SfCartesianChart.YAxes><chart:NumericalAxis ShowMajorGridLines="False" /></chart:SfCartesianChart.YAxes>
                                        <chart:FastLineSeries ItemsSource="{Binding StepsHistory}" XBindingPath="Label" YBindingPath="Value" Fill="#2196F3" />
                                    </chart:SfCartesianChart>
                                </StackPanel>
                            </Border>

                            <!-- HR Trend -->
                            <Border x:Name="HrCard" Grid.Row="0" Grid.Column="2" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" Style="{StaticResource GlassPanelStyle}" Translation="0,0,18" CornerRadius="16" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Heart Rate" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <chart:SfCartesianChart Height="120">
                                        <chart:SfCartesianChart.XAxes><chart:CategoryAxis ShowMajorGridLines="False" /></chart:SfCartesianChart.XAxes>
                                        <chart:SfCartesianChart.YAxes><chart:NumericalAxis ShowMajorGridLines="False" /></chart:SfCartesianChart.YAxes>
                                        <chart:FastLineSeries ItemsSource="{Binding HrHistory}" XBindingPath="Label" YBindingPath="Value" Fill="#FF5252" />
                                    </chart:SfCartesianChart>
                                </StackPanel>
                            </Border>

                            <!-- Sleep Trend -->
                            <Border x:Name="SleepCard" Grid.Row="1" Grid.Column="0" Margin="0,24,0,0" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" Style="{StaticResource GlassPanelStyle}" Translation="0,0,18" CornerRadius="16" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Sleep (hours)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <chart:SfCartesianChart Height="120">
                                        <chart:SfCartesianChart.XAxes><chart:CategoryAxis ShowMajorGridLines="False" /></chart:SfCartesianChart.XAxes>
                                        <chart:SfCartesianChart.YAxes><chart:NumericalAxis ShowMajorGridLines="False" /></chart:SfCartesianChart.YAxes>
                                        <chart:FastLineSeries ItemsSource="{Binding SleepHistory}" XBindingPath="Label" YBindingPath="Value" Fill="#7C4DFF" />
                                    </chart:SfCartesianChart>
                                </StackPanel>
                            </Border>

                            <!-- Calories Trend -->
                            <Border x:Name="CaloriesCard" Grid.Row="1" Grid.Column="2" Margin="0,24,0,0" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" Style="{StaticResource GlassPanelStyle}" Translation="0,0,18" CornerRadius="16" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Active Calories" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <chart:SfCartesianChart Height="120">
                                        <chart:SfCartesianChart.XAxes><chart:CategoryAxis ShowMajorGridLines="False" /></chart:SfCartesianChart.XAxes>
                                        <chart:SfCartesianChart.YAxes><chart:NumericalAxis ShowMajorGridLines="False" /></chart:SfCartesianChart.YAxes>
                                        <chart:FastLineSeries ItemsSource="{Binding CaloriesHistory}" XBindingPath="Label" YBindingPath="Value" Fill="#FF9800" />
                                    </chart:SfCartesianChart>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- TAB 2: SLEEP ARCHITECTURE (CLINICAL HYPNOGRAM) -->
            <PivotItem Header="Sleep">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="24" Padding="0,16,0,20">
                        
                        <!-- Sleep Score & Summary Header -->
                        <Border Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" Style="{StaticResource GlassPanelStyle}" CornerRadius="16" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Sleep Score Ring -->
                                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                    <Border Width="76" Height="76" CornerRadius="38" Background="#1A7C4DFF" BorderBrush="#7C4DFF" BorderThickness="3">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Bind SleepScoreText, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#7C4DFF" HorizontalAlignment="Center" />
                                            <TextBlock Text="SCORE" FontSize="9" Opacity="0.6" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind SleepQualityTitle, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind SleepScheduleText, Mode=OneWay}" FontSize="13" Opacity="0.6" Margin="0,2,0,0" />
                                        <TextBlock Text="{x:Bind SleepEfficiencyText, Mode=OneWay}" FontSize="12" Opacity="0.5" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Summary Pills -->
                                <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="ASLEEP" FontSize="11" Opacity="0.5" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind SleepAsleepText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#42A5F5" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="IN BED" FontSize="11" Opacity="0.5" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind SleepInBedText, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="AWAKE" FontSize="11" Opacity="0.5" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind AwakeCountText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#FF7043" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                        <TextBlock Text="DEEP+REM" FontSize="11" Opacity="0.5" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind RestorativePercentText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#26C6DA" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 4-LEVEL CLINICAL HYPNOGRAM GRAPH -->
                        <Border Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" Style="{StaticResource GlassPanelStyle}" CornerRadius="16" Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE708;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#7C4DFF" />
                                        <TextBlock Text="Clinical Sleep Hypnogram" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <!-- Legend -->
                                    <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="8" Height="8" Fill="#FF7043" />
                                            <TextBlock Text="Awake" FontSize="11" Opacity="0.7" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="8" Height="8" Fill="#26C6DA" />
                                            <TextBlock Text="REM" FontSize="11" Opacity="0.7" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="8" Height="8" Fill="#42A5F5" />
                                            <TextBlock Text="Core / Light" FontSize="11" Opacity="0.7" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="8" Height="8" Fill="#3949AB" />
                                            <TextBlock Text="Deep" FontSize="11" Opacity="0.7" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Multi-level Chart Wrapper -->
                                <Grid Height="165" Background="#15000000" CornerRadius="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Y-Axis Stage Labels -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Stretch" Padding="8,8,0,8">
                                        <TextBlock Text="AWAKE" FontSize="10" FontWeight="SemiBold" Foreground="#FF7043" Height="40" VerticalAlignment="Center" />
                                        <TextBlock Text="REM" FontSize="10" FontWeight="SemiBold" Foreground="#26C6DA" Height="40" VerticalAlignment="Center" />
                                        <TextBlock Text="CORE" FontSize="10" FontWeight="SemiBold" Foreground="#42A5F5" Height="40" VerticalAlignment="Center" />
                                        <TextBlock Text="DEEP" FontSize="10" FontWeight="SemiBold" Foreground="#3949AB" Height="40" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Border Grid.Column="0" Width="1" Background="{ThemeResource AppGlassBorderColorBrush}" HorizontalAlignment="Right" />

                                    <!-- Canvas for 4-Level Blocks & Guidelines -->
                                    <Canvas x:Name="SleepHypnogramCanvas" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SizeChanged="SleepHypnogramCanvas_SizeChanged" />
                                </Grid>

                                <!-- X-Axis Hourly Ticks Canvas -->
                                <Grid Height="24" Margin="65,4,0,0">
                                    <Canvas x:Name="SleepXAxisCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 4 Stage Target Cards -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Deep -->
                            <Border Grid.Column="0" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="#3949AB" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="DEEP SLEEP" FontSize="11" FontWeight="Bold" Foreground="#3949AB" Margin="0,0,0,4" />
                                    <TextBlock Text="{x:Bind DeepDurationText, Mode=OneWay}" FontSize="20" FontWeight="Bold" />
                                    <TextBlock Text="{x:Bind DeepPercentText, Mode=OneWay}" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                                    <TextBlock Text="Optimal: 15-25%" FontSize="10" Foreground="#4CAF50" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- REM -->
                            <Border Grid.Column="1" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="#26C6DA" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="REM SLEEP" FontSize="11" FontWeight="Bold" Foreground="#26C6DA" Margin="0,0,0,4" />
                                    <TextBlock Text="{x:Bind RemDurationText, Mode=OneWay}" FontSize="20" FontWeight="Bold" />
                                    <TextBlock Text="{x:Bind RemPercentText, Mode=OneWay}" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                                    <TextBlock Text="Optimal: 20-25%" FontSize="10" Foreground="#4CAF50" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Core / Light -->
                            <Border Grid.Column="2" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="#42A5F5" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="CORE / LIGHT" FontSize="11" FontWeight="Bold" Foreground="#42A5F5" Margin="0,0,0,4" />
                                    <TextBlock Text="{x:Bind LightDurationText, Mode=OneWay}" FontSize="20" FontWeight="Bold" />
                                    <TextBlock Text="{x:Bind LightPercentText, Mode=OneWay}" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                                    <TextBlock Text="Optimal: 50-60%" FontSize="10" Foreground="#4CAF50" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Awake -->
                            <Border Grid.Column="3" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="#FF7043" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="AWAKE" FontSize="11" FontWeight="Bold" Foreground="#FF7043" Margin="0,0,0,4" />
                                    <TextBlock Text="{x:Bind AwakeDurationText, Mode=OneWay}" FontSize="20" FontWeight="Bold" />
                                    <TextBlock Text="{x:Bind AwakePercentText, Mode=OneWay}" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                                    <TextBlock Text="Target: &lt;10%" FontSize="10" Foreground="#4CAF50" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- TAB 3: SENSORS & TELEMETRY -->
            <PivotItem Header="Sensors">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="24" Padding="0,16,0,20">
                        
                        <!-- Continuous Intraday Heart Rate -->
                        <Border Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" Style="{StaticResource GlassPanelStyle}" CornerRadius="16" Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEB51;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#FF5252" />
                                        <TextBlock Text="Continuous Heart Rate Today" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind AvgIntradayHrText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#FF5252" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <chart:SfCartesianChart Height="220">
                                    <chart:SfCartesianChart.XAxes><chart:DateTimeAxis ShowMajorGridLines="False" /></chart:SfCartesianChart.XAxes>
                                    <chart:SfCartesianChart.YAxes><chart:NumericalAxis ShowMajorGridLines="True" Minimum="40" Maximum="180" Interval="20" /></chart:SfCartesianChart.YAxes>
                                    <chart:SplineSeries ItemsSource="{x:Bind HeartRateTelemetryData, Mode=OneWay}" XBindingPath="LocalStartTime" YBindingPath="NumericValue" Fill="#FF5252" />
                                </chart:SfCartesianChart>

                                <!-- HR Zones Breakdown -->
                                <Grid Margin="0,16,0,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#104CAF50" CornerRadius="8" Padding="10">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="RESTING (&lt;100)" FontSize="10" Opacity="0.6" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind HrRestingPctText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="#10FFB300" CornerRadius="8" Padding="10">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="FAT BURN (100-120)" FontSize="10" Opacity="0.6" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind HrFatBurnPctText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#FFB300" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#10FF7043" CornerRadius="8" Padding="10">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="CARDIO (120-150)" FontSize="10" Opacity="0.6" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind HrCardioPctText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#FF7043" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="3" Background="#10F44336" CornerRadius="8" Padding="10">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="PEAK (&gt;150)" FontSize="10" Opacity="0.6" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind HrPeakPctText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#F44336" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Stress & PAI Grid -->
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Stress Level -->
                            <Border Grid.Column="0" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" Style="{StaticResource GlassPanelStyle}" CornerRadius="16" Padding="20">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8D7;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#9C27B0" />
                                            <TextBlock Text="Stress Level" FontSize="16" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="Relaxed" FontSize="12" Foreground="#4CAF50" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind StressLevelText, Mode=OneWay}" FontSize="32" FontWeight="Bold" />
                                    <ProgressBar Value="{x:Bind StressLevelValue, Mode=OneWay}" Maximum="100" Foreground="#9C27B0" Height="6" />
                                    <TextBlock Text="Continuous physiological stress telemetry" FontSize="11" Opacity="0.5" />
                                </StackPanel>
                            </Border>

                            <!-- PAI Score -->
                            <Border Grid.Column="1" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" Style="{StaticResource GlassPanelStyle}" CornerRadius="16" Padding="20">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE734;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#FF9800" />
                                            <TextBlock Text="PAI Score" FontSize="16" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="Target: 100" FontSize="12" Foreground="#FF9800" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind PaiScoreText, Mode=OneWay}" FontSize="32" FontWeight="Bold" />
                                    <ProgressBar Value="{x:Bind PaiScoreValue, Mode=OneWay}" Maximum="100" Foreground="#FF9800" Height="6" />
                                    <TextBlock Text="Personal Activity Intelligence (rolling 7 days)" FontSize="11" Opacity="0.5" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- TAB 4: NUTRITION & BODY COMPOSITION -->
            <PivotItem Header="Nutrition">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="24" Padding="0,16,0,20">
                        
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Hydration Hero -->
                            <Border Grid.Column="0" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" Style="{StaticResource GlassPanelStyle}" CornerRadius="16" Padding="20">
                                <StackPanel Spacing="16">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE753;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#29B6F6" />
                                            <TextBlock Text="Hydration" FontSize="18" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="Goal: 3.0 L" FontSize="12" Foreground="#29B6F6" HorizontalAlignment="Right" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind WaterIntakeText, Mode=OneWay}" FontSize="36" FontWeight="Bold" Foreground="#29B6F6" />
                                        <TextBlock Text="Liters" FontSize="14" Opacity="0.6" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                                    </StackPanel>

                                    <ProgressBar Value="{x:Bind WaterPercentValue, Mode=OneWay}" Maximum="100" Foreground="#29B6F6" Height="8" />
                                    <TextBlock Text="{x:Bind WaterPercentText, Mode=OneWay}" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </Border>

                            <!-- Macronutrients -->
                            <Border Grid.Column="1" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" Style="{StaticResource GlassPanelStyle}" CornerRadius="16" Padding="20">
                                <StackPanel Spacing="16">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xEB52;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#FFA726" />
                                            <TextBlock Text="Macronutrients" FontSize="18" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind TotalMacrosText, Mode=OneWay}" FontSize="12" Opacity="0.6" HorizontalAlignment="Right" />
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Carbs -->
                                        <Border Grid.Column="0" Background="#1026C6DA" CornerRadius="8" Padding="12">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="CARBS" FontSize="10" FontWeight="Bold" Foreground="#26C6DA" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind CarbsText, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Protein -->
                                        <Border Grid.Column="1" Background="#107E57C2" CornerRadius="8" Padding="12">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="PROTEIN" FontSize="10" FontWeight="Bold" Foreground="#7E57C2" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind ProteinText, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Fat -->
                                        <Border Grid.Column="2" Background="#10FFA726" CornerRadius="8" Padding="12">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="FAT" FontSize="10" FontWeight="Bold" Foreground="#FFA726" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind FatText, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Body Composition -->
                        <Border Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" Style="{StaticResource GlassPanelStyle}" CornerRadius="16" Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#2196F3" />
                                    <TextBlock Text="Body Composition &amp; Biometrics" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Weight -->
                                    <Border Grid.Column="0" Background="#0AFFFFFF" CornerRadius="10" Padding="12">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="WEIGHT" FontSize="10" Opacity="0.5" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind WeightText, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Height -->
                                    <Border Grid.Column="1" Background="#0AFFFFFF" CornerRadius="10" Padding="12">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="HEIGHT" FontSize="10" Opacity="0.5" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind HeightText, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- BMI -->
                                    <Border Grid.Column="2" Background="#0AFFFFFF" CornerRadius="10" Padding="12">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="BMI" FontSize="10" Opacity="0.5" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind BmiText, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                            <TextBlock Text="{x:Bind BmiCategoryText, Mode=OneWay}" FontSize="10" Foreground="#4CAF50" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Body Fat -->
                                    <Border Grid.Column="3" Background="#0AFFFFFF" CornerRadius="10" Padding="12">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="BODY FAT" FontSize="10" Opacity="0.5" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind BodyFatText, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Lean Mass -->
                                    <Border Grid.Column="4" Background="#0AFFFFFF" CornerRadius="10" Padding="12">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="LEAN MASS" FontSize="10" Opacity="0.5" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind LeanMassText, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Bone Mass -->
                                    <Border Grid.Column="5" Background="#0AFFFFFF" CornerRadius="10" Padding="12">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="BONE MASS" FontSize="10" Opacity="0.5" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind BoneMassText, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Micronutrients Grid -->
                        <Border Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" Style="{StaticResource GlassPanelStyle}" CornerRadius="16" Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE909;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#00BCD4" />
                                    <TextBlock Text="Micronutrients &amp; Stimulants" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>

                                <Grid ColumnSpacing="12" RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" Background="#0AFFFFFF" CornerRadius="8" Padding="12">
                                        <StackPanel><TextBlock Text="CAFFEINE" FontSize="10" Opacity="0.5" /><TextBlock Text="{x:Bind CaffeineText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Margin="0,2,0,0" /></StackPanel>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Background="#0AFFFFFF" CornerRadius="8" Padding="12">
                                        <StackPanel><TextBlock Text="SUGAR" FontSize="10" Opacity="0.5" /><TextBlock Text="{x:Bind SugarText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Margin="0,2,0,0" /></StackPanel>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="2" Background="#0AFFFFFF" CornerRadius="8" Padding="12">
                                        <StackPanel><TextBlock Text="MAGNESIUM" FontSize="10" Opacity="0.5" /><TextBlock Text="{x:Bind MagnesiumText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Margin="0,2,0,0" /></StackPanel>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="3" Background="#0AFFFFFF" CornerRadius="8" Padding="12">
                                        <StackPanel><TextBlock Text="ZINC" FontSize="10" Opacity="0.5" /><TextBlock Text="{x:Bind ZincText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Margin="0,2,0,0" /></StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="0" Background="#0AFFFFFF" CornerRadius="8" Padding="12">
                                        <StackPanel><TextBlock Text="CALCIUM" FontSize="10" Opacity="0.5" /><TextBlock Text="{x:Bind CalciumText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Margin="0,2,0,0" /></StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" Background="#0AFFFFFF" CornerRadius="8" Padding="12">
                                        <StackPanel><TextBlock Text="IRON" FontSize="10" Opacity="0.5" /><TextBlock Text="{x:Bind IronText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Margin="0,2,0,0" /></StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="2" Background="#0AFFFFFF" CornerRadius="8" Padding="12">
                                        <StackPanel><TextBlock Text="VITAMIN C" FontSize="10" Opacity="0.5" /><TextBlock Text="{x:Bind VitaminCText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Margin="0,2,0,0" /></StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="3" Background="#0AFFFFFF" CornerRadius="8" Padding="12">
                                        <StackPanel><TextBlock Text="VITAMIN A" FontSize="10" Opacity="0.5" /><TextBlock Text="{x:Bind VitaminAText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Margin="0,2,0,0" /></StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
