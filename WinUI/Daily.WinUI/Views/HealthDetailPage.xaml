                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- ========================================== -->
            <!-- TAB 4: TRENDS                             -->
            <!-- ========================================== -->
            <PivotItem Header="Trends">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20" Padding="0,12,20,24">

