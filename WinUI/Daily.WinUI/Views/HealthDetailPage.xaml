                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <TextBlock Text="AVG BPM" FontSize="9" Opacity="0.6" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind HrAvgText, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <TextBlock Text="MAX BPM" FontSize="9" Opacity="0.6" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind HrMaxText, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                            <TextBlock Text="MIN BPM" FontSize="9" Opacity="0.6" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind HrMinText, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- CALORIES 7-DAY TREND CARD -->
                        <Border Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A4;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#FF5722" />
                                    <TextBlock Text="Active Calories (7-Day)" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>

                                <chart:SfCartesianChart Height="160">
                                    <chart:SfCartesianChart.XAxes>
                                        <chart:CategoryAxis ShowMajorGridLines="False" />
                                    </chart:SfCartesianChart.XAxes>
                                    <chart:SfCartesianChart.YAxes>
                                        <chart:NumericalAxis ShowMajorGridLines="True" />
                                    </chart:SfCartesianChart.YAxes>
                                    <chart:ColumnSeries ItemsSource="{x:Bind CaloriesHistory, Mode=OneWay}" XBindingPath="Label" YBindingPath="Value" Fill="#FF5722" />
                                </chart:SfCartesianChart>

                                <Border Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" CornerRadius="8" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <TextBlock Text="AVG" FontSize="9" Opacity="0.6" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind CaloriesAvgText, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <TextBlock Text="MAX" FontSize="9" Opacity="0.6" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind CaloriesMaxText, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                            <TextBlock Text="MIN" FontSize="9" Opacity="0.6" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind CaloriesMinText, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                            <TextBlock Text="TOTAL" FontSize="9" Opacity="0.6" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind CaloriesTotalText, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

        </Pivot>
    </Grid>
</Page>
