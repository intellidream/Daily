                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#10FF7043" CornerRadius="8" Padding="10">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="CARDIO (120-150)" FontSize="10" Opacity="0.6" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind HrCardioPctText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#FF7043" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="3" Background="#10F44336" CornerRadius="8" Padding="10">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="PEAK (&gt;150)" FontSize="10" Opacity="0.6" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind HrPeakPctText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#F44336" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
