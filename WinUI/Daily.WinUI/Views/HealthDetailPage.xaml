                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE708;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#7C4DFF" />
