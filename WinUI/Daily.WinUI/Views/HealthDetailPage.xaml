<Page
    x:Class="Daily_WinUI.Views.HealthDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:chart="using:Syncfusion.UI.Xaml.Charts"
    xmlns:local="using:Daily_WinUI.Views"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Bar with Icon, Title, and Sync Button -->
        <Grid Grid.Row="0" Padding="20,16,20,12" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="22" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1">
                    <FontIcon Glyph="&#xE95E;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Health Hub" FontSize="28" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource AppFgColorBrush}" />
                    <TextBlock Text="Unified Daily Vitals, Sleep &amp; Stress Studio" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                </StackPanel>
            </StackPanel>

            <Button x:Name="SyncButton" Grid.Column="1" Content="Force Sync" Click="SyncButton_Click" IsEnabled="{x:Bind IsNotSyncing, Mode=OneWay}" CornerRadius="8" Padding="14,6" />
        </Grid>

        <!-- Day Navigator Bar -->
        <Border Grid.Row="1" Margin="20,0,20,12" Padding="14,8" CornerRadius="12" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="PrevDayButton" Click="PrevDayButton_Click" ToolTipService.ToolTip="Previous Day" Padding="10,6" CornerRadius="6">
                        <FontIcon Glyph="&#xE76B;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0">
                        <FontIcon Glyph="&#xE787;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#4CAF50" />
                        <TextBlock x:Name="SelectedDateTextBlock" Text="Today" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource AppFgColorBrush}" />
                    </StackPanel>
                    <Button x:Name="NextDayButton" Click="NextDayButton_Click" ToolTipService.ToolTip="Next Day" Padding="10,6" CornerRadius="6">
                        <FontIcon Glyph="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                    </Button>
                </StackPanel>

                <Button x:Name="JumpTodayButton" Grid.Column="2" Content="Jump to Today" Click="JumpTodayButton_Click" Visibility="Collapsed" CornerRadius="6" />
            </Grid>
        </Border>

        <!-- 5-Tab Pivot Navigation -->
        <Pivot x:Name="HealthPivot" Grid.Row="2" Margin="20,0,0,0" SelectionChanged="HealthPivot_SelectionChanged">
            <Pivot.Resources>
                <Thickness x:Key="PivotItemMargin">0</Thickness>
            </Pivot.Resources>

            <!-- ========================================== -->
            <!-- TAB 0: OVERVIEW                           -->
            <!-- ========================================== -->
            <PivotItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20" Padding="0,12,20,24">

                        <!-- HERO ACTIVITY & SLEEP SUMMARY -->
                        <Border Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                            <StackPanel Spacing="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Steps -->
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="STEPS" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" CharacterSpacing="100" />
                                        <TextBlock Text="{x:Bind StepsText, Mode=OneWay}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FF9800" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <!-- Calories -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="CALORIES" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" CharacterSpacing="100" />
                                        <TextBlock Text="{x:Bind CaloriesText, Mode=OneWay}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FF5722" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <!-- Sleep -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="SLEEP" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" CharacterSpacing="100" />
                                        <TextBlock Text="{x:Bind SleepText, Mode=OneWay}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#7C4DFF" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <!-- Stress -->
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                        <TextBlock Text="STRESS" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" CharacterSpacing="100" />
                                        <TextBlock Text="{x:Bind StressScoreText, Mode=OneWay}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#00BCD4" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- Activity Sub-Metrics Row -->
                                <Border Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" CornerRadius="10" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                            <FontIcon Glyph="&#xE819;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#4CAF50" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind DistanceText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                            <FontIcon Glyph="&#xE74A;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#00BCD4" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind FloorsText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                            <FontIcon Glyph="&#xE8A4;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#FF9800" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind SpeedText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- HOURLY STEPS HISTOGRAM (24H) -->
                        <Border Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7EE;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#FF9800" />
                                        <TextBlock Text="24-Hour Steps Cadence" FontSize="15" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind HourlyStepsMaxText, Mode=OneWay}" FontSize="12" Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <chart:SfCartesianChart Height="160">
                                    <chart:SfCartesianChart.XAxes>
                                        <chart:CategoryAxis ShowMajorGridLines="False" />
                                    </chart:SfCartesianChart.XAxes>
                                    <chart:SfCartesianChart.YAxes>
                                        <chart:NumericalAxis ShowMajorGridLines="True" />
                                    </chart:SfCartesianChart.YAxes>
                                    <chart:ColumnSeries ItemsSource="{x:Bind HourlyStepsCollection, Mode=OneWay}" XBindingPath="Label" YBindingPath="Value" Fill="#FF9800" />
                                </chart:SfCartesianChart>
                            </StackPanel>
                        </Border>

                        <!-- QUICK PREVIEWS: SLEEP & STRESS STUDIOS -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Sleep Preview Card -->
                            <Border Grid.Column="0" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Tapped="SleepPreview_Tapped">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="56" Height="56" CornerRadius="28" Background="#1A7C4DFF" BorderBrush="#7C4DFF" BorderThickness="2" VerticalAlignment="Center">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Bind SleepScoreText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#7C4DFF" HorizontalAlignment="Center" />
                                            <TextBlock Text="SCORE" FontSize="8" Opacity="0.6" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Sleep Studio" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind SleepVerdictSummaryText, Mode=OneWay}" FontSize="12" Foreground="#7C4DFF" Margin="0,2,0,0" />
                                        <TextBlock Text="{x:Bind SleepScheduleText, Mode=OneWay}" FontSize="11" Opacity="0.6" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Stress Preview Card -->
                            <Border Grid.Column="1" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Tapped="StressPreview_Tapped">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="56" Height="56" CornerRadius="28" Background="{x:Bind MonkeyMoodBackgroundBrush, Mode=OneWay}" BorderBrush="{x:Bind MonkeyMoodBorderBrush, Mode=OneWay}" BorderThickness="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind MonkeyMoodEmoji, Mode=OneWay}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Stress Studio" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind MonkeyMoodLabelText, Mode=OneWay}" FontSize="12" Foreground="{x:Bind MonkeyMoodBorderBrush, Mode=OneWay}" Margin="0,2,0,0" />
                                        <TextBlock Text="{x:Bind AutonomicDominantText, Mode=OneWay}" FontSize="11" Opacity="0.6" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 8-TILE VITALS GRID -->
                        <TextBlock Text="Key Vitals" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 1. Heart Rate -->
                            <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                <StackPanel HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xEB51;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#FF5252" Margin="0,0,0,6" />
                                    <TextBlock Text="HEART RATE" FontSize="9" Opacity="0.6" CharacterSpacing="50" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind HeartRateText, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 2. Resting Heart Rate -->
                            <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                <StackPanel HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE95E;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#E91E63" Margin="0,0,0,6" />
                                    <TextBlock Text="RESTING HR" FontSize="9" Opacity="0.6" CharacterSpacing="50" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind RhrText, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 3. HRV -->
                            <Border Grid.Row="0" Grid.Column="2" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                <StackPanel HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xEC92;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#9C27B0" Margin="0,0,0,6" />
                                    <TextBlock Text="HRV (SDNN)" FontSize="9" Opacity="0.6" CharacterSpacing="50" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind HrvText, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 4. SpO2 -->
                            <Border Grid.Row="0" Grid.Column="3" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                <StackPanel HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE7EE;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#00BCD4" Margin="0,0,0,6" />
                                    <TextBlock Text="BLOOD OXYGEN" FontSize="9" Opacity="0.6" CharacterSpacing="50" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Spo2Text, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 5. Blood Pressure -->
                            <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                <StackPanel HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8D5;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#FF7043" Margin="0,0,0,6" />
                                    <TextBlock Text="BLOOD PRESS." FontSize="9" Opacity="0.6" CharacterSpacing="50" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind BloodPressureText, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 6. Respiration -->
                            <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                <StackPanel HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE753;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#4CAF50" Margin="0,0,0,6" />
                                    <TextBlock Text="RESP. RATE" FontSize="9" Opacity="0.6" CharacterSpacing="50" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind RespText, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 7. Glucose -->
                            <Border Grid.Row="1" Grid.Column="2" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                <StackPanel HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE7B7;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#FFB300" Margin="0,0,0,6" />
                                    <TextBlock Text="GLUCOSE" FontSize="9" Opacity="0.6" CharacterSpacing="50" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind GlucoseText, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 8. Weight -->
                            <Border Grid.Row="1" Grid.Column="3" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                <StackPanel HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xEC0A;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#29B6F6" Margin="0,0,0,6" />
                                    <TextBlock Text="WEIGHT" FontSize="9" Opacity="0.6" CharacterSpacing="50" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind WeightText, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- BODY COMPOSITION -->
                        <Border Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="BODY FAT" FontSize="10" Opacity="0.6" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind BodyFatText, Mode=OneWay}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{ThemeResource AppGlassBorderColorBrush}" />

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="BMI" FontSize="10" Opacity="0.6" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind BmiText, Mode=OneWay}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="3" Background="{ThemeResource AppGlassBorderColorBrush}" />

                                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                    <TextBlock Text="LEAN MASS" FontSize="10" Opacity="0.6" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind LeanMassText, Mode=OneWay}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- ========================================== -->
            <!-- TAB 1: SLEEP STUDIO                       -->
            <!-- ========================================== -->
            <PivotItem Header="Sleep Studio">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20" Padding="0,12,20,24">

                        <!-- Sleep Score & Summary Header -->
                        <Border Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                            <StackPanel Spacing="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                        <Border Width="68" Height="68" CornerRadius="34" Background="#1A7C4DFF" BorderBrush="#7C4DFF" BorderThickness="3">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{x:Bind SleepScoreText, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="#7C4DFF" HorizontalAlignment="Center" />
                                                <TextBlock Text="SCORE" FontSize="9" Opacity="0.6" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Sleep Architecture" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind SleepScheduleText, Mode=OneWay}" FontSize="13" Opacity="0.7" Margin="0,2,0,0" />
                                            <TextBlock Text="{x:Bind SleepEfficiencyText, Mode=OneWay}" FontSize="12" Opacity="0.5" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <TextBlock Text="ASLEEP" FontSize="10" Opacity="0.5" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind TotalSleepText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#42A5F5" HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <TextBlock Text="IN BED" FontSize="10" Opacity="0.5" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind TimeInBedText, Mode=OneWay}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                            <TextBlock Text="AWAKE" FontSize="10" Opacity="0.5" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind AwakeCountText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#FF7043" HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                            <TextBlock Text="RESTORATIVE" FontSize="10" Opacity="0.5" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind RestorativePctText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#26C6DA" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- Clinical Sleep Verdict Card -->
                                <Border Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}" CornerRadius="12" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="16" Background="#267C4DFF" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE708;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#7C4DFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Verdict:" FontSize="12" Opacity="0.6" />
                                                <TextBlock Text="{x:Bind SleepVerdictQualityText, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#7C4DFF" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind SleepVerdictSummaryText, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Opacity="0.85" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- CLINICAL SLEEP HYPNOGRAM CANVAS -->
                        <Border Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <TextBlock Text="Clinical Sleep Hypnogram" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4"><Ellipse Width="8" Height="8" Fill="#FF7043" /><TextBlock Text="Awake" FontSize="11" Opacity="0.7" /></StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4"><Ellipse Width="8" Height="8" Fill="#26C6DA" /><TextBlock Text="REM" FontSize="11" Opacity="0.7" /></StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4"><Ellipse Width="8" Height="8" Fill="#42A5F5" /><TextBlock Text="Core" FontSize="11" Opacity="0.7" /></StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4"><Ellipse Width="8" Height="8" Fill="#3949AB" /><TextBlock Text="Deep" FontSize="11" Opacity="0.7" /></StackPanel>
                                    </StackPanel>
