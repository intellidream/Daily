<UserControl
    x:Class="Daily_WinUI.Controls.DesktopSidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Active Tab Indicator Brush -->
        <LinearGradientBrush x:Key="SidebarActiveTabBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4D0078D4" Offset="0.0" />
            <GradientStop Color="#1A00C7D4" Offset="1.0" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Border Width="230"
            Background="{ThemeResource SidebarBackgroundBrush}"
            BorderBrush="{ThemeResource SidebarBorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="12,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Divider -->
                <RowDefinition Height="*" />    <!-- Navigation Items -->
                <RowDefinition Height="Auto" /> <!-- Divider -->
                <RowDefinition Height="Auto" /> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header: App branding & Collapse button -->
            <Grid Grid.Row="0" Margin="4,4,4,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Image.Source>
                        <BitmapImage UriSource="ms-appx:///Assets/OrbitIcon-Unplated-32.png" DecodePixelWidth="44" DecodePixelHeight="44"/>
                    </Image.Source>
                </Image>

                <TextBlock Grid.Column="1" Text="DayOne" FontSize="16" FontWeight="Bold" FontFamily="Segoe UI Variable Display" VerticalAlignment="Center" Foreground="{ThemeResource AppFgColorBrush}"/>

                <Button Grid.Column="2" x:Name="CollapseSidebarButton" Click="CollapseSidebarButton_Click"
                        Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="6"
                        ToolTipService.ToolTip="Collapse Sidebar (Ctrl+S)">
                    <FontIcon Glyph="&#xE90C;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                </Button>
            </Grid>

            <!-- Divider -->
            <Rectangle Grid.Row="1" Height="1" Fill="{ThemeResource SidebarBorderBrush}" Margin="0,0,0,12" />

            <!-- Navigation Items List -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="4">
                    <!-- Tab 1: Dashboard -->
                    <Button x:Name="SidebarItem1" Click="SidebarItem_Click" Tag="1"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="SidebarIcon1" Grid.Column="0" Glyph="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#FF00E5FF" Margin="0,0,12,0"/>
                            <TextBlock x:Name="SidebarText1" Grid.Column="1" Text="Dashboard" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Ctrl+1" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center" Opacity="0.7"/>
                        </Grid>
                    </Button>

                    <!-- Tab 2: Finances -->
                    <Button x:Name="SidebarItem2" Click="SidebarItem_Click" Tag="2"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="SidebarIcon2" Grid.Column="0" Glyph="&#xE8C7;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource AppFgMutedColorBrush}" Margin="0,0,12,0"/>
                            <TextBlock x:Name="SidebarText2" Grid.Column="1" Text="Finances" FontSize="13" FontWeight="Normal" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Ctrl+2" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center" Opacity="0.7"/>
                        </Grid>
                    </Button>

                    <!-- Tab 3: TagDoS -->
                    <Button x:Name="SidebarItem3" Click="SidebarItem_Click" Tag="3"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="SidebarIcon3" Grid.Column="0" Glyph="&#xE70B;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource AppFgMutedColorBrush}" Margin="0,0,12,0"/>
                            <TextBlock x:Name="SidebarText3" Grid.Column="1" Text="TagDoS" FontSize="13" FontWeight="Normal" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Ctrl+3" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center" Opacity="0.7"/>
                        </Grid>
                    </Button>

                    <!-- Tab 4: Health -->
                    <Button x:Name="SidebarItem4" Click="SidebarItem_Click" Tag="4"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="SidebarIcon4" Grid.Column="0" Glyph="&#xEB51;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource AppFgMutedColorBrush}" Margin="0,0,12,0"/>
                            <TextBlock x:Name="SidebarText4" Grid.Column="1" Text="Health" FontSize="13" FontWeight="Normal" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Ctrl+4" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center" Opacity="0.7"/>
                        </Grid>
                    </Button>

                    <!-- Tab 5: Habits -->
                    <Button x:Name="SidebarItem5" Click="SidebarItem_Click" Tag="5"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="SidebarIcon5" Grid.Column="0" Glyph="&#xEA3B;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource AppFgMutedColorBrush}" Margin="0,0,12,0"/>
                            <TextBlock x:Name="SidebarText5" Grid.Column="1" Text="Habits" FontSize="13" FontWeight="Normal" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Ctrl+5" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center" Opacity="0.7"/>
                        </Grid>
                    </Button>

                    <!-- Tab 6: Weather -->
                    <Button x:Name="SidebarItem6" Click="SidebarItem_Click" Tag="6"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="SidebarIcon6" Grid.Column="0" Glyph="&#xE9CA;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource AppFgMutedColorBrush}" Margin="0,0,12,0"/>
                            <TextBlock x:Name="SidebarText6" Grid.Column="1" Text="Weather" FontSize="13" FontWeight="Normal" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Ctrl+6" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center" Opacity="0.7"/>
                        </Grid>
                    </Button>

                    <!-- Tab 7: News -->
                    <Button x:Name="SidebarItem7" Click="SidebarItem_Click" Tag="7"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="SidebarIcon7" Grid.Column="0" Glyph="&#xE958;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource AppFgMutedColorBrush}" Margin="0,0,12,0"/>
                            <TextBlock x:Name="SidebarText7" Grid.Column="1" Text="News" FontSize="13" FontWeight="Normal" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Ctrl+7" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center" Opacity="0.7"/>
                        </Grid>
                    </Button>

                    <!-- Tab 8: Calendar -->
                    <Button x:Name="SidebarItem8" Click="SidebarItem_Click" Tag="8"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="SidebarIcon8" Grid.Column="0" Glyph="&#xE787;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource AppFgMutedColorBrush}" Margin="0,0,12,0"/>
                            <TextBlock x:Name="SidebarText8" Grid.Column="1" Text="Calendar" FontSize="13" FontWeight="Normal" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Ctrl+8" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center" Opacity="0.7"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Divider -->
            <Rectangle Grid.Row="3" Height="1" Fill="{ThemeResource SidebarBorderBrush}" Margin="0,12,0,12" />

            <!-- Footer: Sync & Settings -->
            <StackPanel Grid.Row="4" Spacing="4">
                <Button x:Name="SidebarSyncButton" Click="SidebarSyncButton_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{ThemeResource AppFgMutedColorBrush}" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="Force Sync" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Ctrl+R" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center" Opacity="0.6"/>
                    </Grid>
                </Button>

                <Button x:Name="SidebarSettingsButton" Click="SidebarSettingsButton_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{ThemeResource AppFgMutedColorBrush}" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="Settings" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Ctrl+," FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center" Opacity="0.6"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
