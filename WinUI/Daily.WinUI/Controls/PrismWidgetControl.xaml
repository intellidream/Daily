<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Daily_WinUI.Controls.PrismWidgetControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Daily.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="200" d:DesignWidth="420"
    Background="Transparent"
    AutomationProperties.Name="Prism Assisted Web Studio Dashboard Card"
    AutomationProperties.AutomationId="PrismWidgetControlRoot">

    <Grid Padding="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header & Vault Count Badge -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="12" Background="#2600E5FF" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#FF00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Prism • Web Studio" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <Border Grid.Column="1" Background="#2600E5FF" BorderBrush="#4D00E5FF" BorderThickness="1" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                <TextBlock x:Name="VaultCountBadgeText" Text="0 Saved" FontSize="10.5" FontWeight="Bold" Foreground="#FF00E5FF" />
            </Border>
        </Grid>

        <!-- Speed Dial Quick Launch Strip -->
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
            <ItemsControl x:Name="SpeedDialItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:PrismPinnedSite">
                        <Button Click="SpeedDialButton_Click"
                                Tag="{x:Bind Url}"
                                AutomationProperties.Name="{x:Bind Title}"
                                Background="#15FFFFFF"
                                BorderBrush="#28FFFFFF"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="10,5">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#FF00E5FF" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind Title}" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Latest Clip Preview -->
        <Border Grid.Row="2" Margin="0,10,0,0" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="12" Padding="10,8" VerticalAlignment="Center">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="LatestClipIcon" Grid.Column="0" Glyph="&#xF4A5;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#FF00E5FF" VerticalAlignment="Center" />
                <TextBlock x:Name="LatestClipTitleText" Grid.Column="1" Text="Browse with shared logins, clip quotes &amp; images, and synthesize pages with Co-Pilot." FontSize="11.5" Foreground="{ThemeResource AppFgColorBrush}" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock x:Name="LatestClipDomainText" Grid.Column="2" Text="" FontSize="10.5" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Bottom Action Row -->
        <Grid Grid.Row="3" Margin="0,8,0,0" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xEA18;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#FF10B981" VerticalAlignment="Center" />
                <TextBlock Text="Prism Shield • Co-Pilot NPU Ready" FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="1"
                    x:Name="OpenPrismStudioButton"
                    AutomationProperties.Name="Open Prism Studio"
                    AutomationProperties.AutomationId="PrismWidgetOpenStudioBtn"
                    Click="OpenPrismStudioButton_Click"
                    Background="Transparent" BorderThickness="0" Padding="4,2" CornerRadius="6"
                    ToolTipService.ToolTip="Open Prism Studio (Ctrl+0)">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Open Studio" FontSize="11" FontWeight="SemiBold" Foreground="#FF00E5FF" VerticalAlignment="Center"/>
                    <FontIcon Glyph="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#FF00E5FF" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
