<UserControl
    x:Class="Daily_WinUI.Controls.FloatingGlassCapsule"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Gradient Brush for Active Tab Indicator -->
        <LinearGradientBrush x:Key="ActiveTabGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E60078D4" Offset="0.0" />
            <GradientStop Color="#E600C7D4" Offset="1.0" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Border x:Name="CapsuleBorder"
            Background="#660C1017"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="25"
            Padding="5,4"
            Translation="0,0,16"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom">
        
        <StackPanel x:Name="TabsStackPanel" Orientation="Horizontal" Spacing="3">
            <!-- Tab 1: Dashboard -->
            <Button x:Name="TabButton1" Click="TabButton_Click" Tag="1"
                    Style="{ThemeResource DefaultButtonStyle}"
                    Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                    CornerRadius="20" Height="38" Padding="10,0"
                    ToolTipService.ToolTip="Dashboard (Ctrl+1)">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon x:Name="TabIcon1" Glyph="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#FFFFFF" />
                    <TextBlock x:Name="TabText1" Text="Dashboard" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Tab 2: Finances -->
            <Button x:Name="TabButton2" Click="TabButton_Click" Tag="2"
                    Style="{ThemeResource DefaultButtonStyle}"
                    Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                    CornerRadius="20" Height="38" Padding="10,0"
                    ToolTipService.ToolTip="Finances (Ctrl+2)">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon x:Name="TabIcon2" Glyph="&#xE8C7;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#B3FFFFFF" />
                    <TextBlock x:Name="TabText2" Text="Finances" FontSize="12" FontWeight="SemiBold" Foreground="#B3FFFFFF" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </Button>

            <!-- Tab 3: TagDoS -->
            <Button x:Name="TabButton3" Click="TabButton_Click" Tag="3"
                    Style="{ThemeResource DefaultButtonStyle}"
                    Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                    CornerRadius="20" Height="38" Padding="10,0"
                    ToolTipService.ToolTip="TagDoS (Ctrl+3)">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon x:Name="TabIcon3" Glyph="&#xE70B;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#B3FFFFFF" />
                    <TextBlock x:Name="TabText3" Text="TagDoS" FontSize="12" FontWeight="SemiBold" Foreground="#B3FFFFFF" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </Button>

            <!-- Tab 4: Health -->
            <Button x:Name="TabButton4" Click="TabButton_Click" Tag="4"
                    Style="{ThemeResource DefaultButtonStyle}"
                    Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                    CornerRadius="20" Height="38" Padding="10,0"
                    ToolTipService.ToolTip="Health (Ctrl+4)">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon x:Name="TabIcon4" Glyph="&#xEB51;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#B3FFFFFF" />
                    <TextBlock x:Name="TabText4" Text="Health" FontSize="12" FontWeight="SemiBold" Foreground="#B3FFFFFF" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </Button>

            <!-- Tab 5: Habits -->
            <Button x:Name="TabButton5" Click="TabButton_Click" Tag="5"
                    Style="{ThemeResource DefaultButtonStyle}"
                    Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                    CornerRadius="20" Height="38" Padding="10,0"
                    ToolTipService.ToolTip="Habits (Ctrl+5)">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon x:Name="TabIcon5" Glyph="&#xEA3B;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#B3FFFFFF" />
                    <TextBlock x:Name="TabText5" Text="Habits" FontSize="12" FontWeight="SemiBold" Foreground="#B3FFFFFF" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </Button>

            <!-- Tab 6: Weather -->
            <Button x:Name="TabButton6" Click="TabButton_Click" Tag="6"
                    Style="{ThemeResource DefaultButtonStyle}"
                    Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                    CornerRadius="20" Height="38" Padding="10,0"
                    ToolTipService.ToolTip="Weather (Ctrl+6)">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon x:Name="TabIcon6" Glyph="&#xE9CA;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#B3FFFFFF" />
                    <TextBlock x:Name="TabText6" Text="Weather" FontSize="12" FontWeight="SemiBold" Foreground="#B3FFFFFF" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </Button>

            <!-- Tab 7: News -->
            <Button x:Name="TabButton7" Click="TabButton_Click" Tag="7"
                    Style="{ThemeResource DefaultButtonStyle}"
                    Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                    CornerRadius="20" Height="38" Padding="10,0"
                    ToolTipService.ToolTip="News (Ctrl+7)">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon x:Name="TabIcon7" Glyph="&#xE958;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#B3FFFFFF" />
                    <TextBlock x:Name="TabText7" Text="News" FontSize="12" FontWeight="SemiBold" Foreground="#B3FFFFFF" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </Button>

            <!-- Tab 8: Calendar -->
            <Button x:Name="TabButton8" Click="TabButton_Click" Tag="8"
                    Style="{ThemeResource DefaultButtonStyle}"
                    Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                    CornerRadius="20" Height="38" Padding="10,0"
                    ToolTipService.ToolTip="Calendar (Ctrl+8)">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon x:Name="TabIcon8" Glyph="&#xE787;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#B3FFFFFF" />
                    <TextBlock x:Name="TabText8" Text="Calendar" FontSize="12" FontWeight="SemiBold" Foreground="#B3FFFFFF" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
