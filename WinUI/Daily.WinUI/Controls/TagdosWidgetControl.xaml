<UserControl
    x:Class="Daily_WinUI.Controls.TagdosWidgetControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Daily.Models"
    mc:Ignorable="d"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded">

    <Grid Padding="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: TagDoS & Notes + Status Badge + "Open Hub >" -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title & Icon -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Tapped="Header_Tapped">
                <Border Width="28" Height="28" CornerRadius="14" Background="#1FAF52DE">
                    <FontIcon Glyph="&#xE73A;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#FFAF52DE" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="TagDoS &amp; Notes" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource AppFgColorBrush}" />
            </StackPanel>

            <!-- Active Pills Counter Badge -->
            <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Background="#14FFFFFF" CornerRadius="10" Padding="8,3">
                <TextBlock x:Name="ActivePillsCountText" Text="Loading..." FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AppFgMutedColorBrush}" />
            </Border>

            <!-- Open Hub Button -->
            <Border Grid.Column="2" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="8,4" Tapped="Header_Tapped">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Open Hub" FontSize="11" FontWeight="SemiBold" Foreground="#FFAF52DE" VerticalAlignment="Center" />
                    <FontIcon Glyph="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#FFAF52DE" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10">
                <!-- Stream 1 (Primary Pipeline) Card -->
                <Border Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="14" Padding="12,10" Tapped="Header_Tapped">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Stream Title & Reminder -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="Stream1TitleText" Text="Morning Prime" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}" />
                                <TextBlock x:Name="Stream1ReminderText" Text="• 08:30" FontSize="11" Foreground="#FF00E5FF" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Stream 1" FontSize="10" Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                        </Grid>

                        <!-- Pills Canvas / Flow -->
                        <VariableSizedWrapGrid Grid.Row="1" x:Name="Stream1PillsPanel" Orientation="Horizontal" MaximumRowsOrColumns="6" ItemHeight="32">
                            <!-- Populated dynamically with glowing pills -->
                        </VariableSizedWrapGrid>
                    </Grid>
                </Border>

                <!-- Stream 2 (Secondary Pipeline) Card -->
                <Border Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="14" Padding="12,10" Tapped="Header_Tapped">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Stream Title & Reminder -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="Stream2TitleText" Text="Work Execution" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}" />
                                <TextBlock x:Name="Stream2ReminderText" Text="• 10:00" FontSize="11" Foreground="#FF00E5FF" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Stream 2" FontSize="10" Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                        </Grid>

                        <!-- Pills Canvas / Flow -->
                        <VariableSizedWrapGrid Grid.Row="1" x:Name="Stream2PillsPanel" Orientation="Horizontal" MaximumRowsOrColumns="6" ItemHeight="32">
                            <!-- Populated dynamically with glowing pills -->
                        </VariableSizedWrapGrid>
                    </Grid>
                </Border>

                <!-- Pinned Quick Note Preview Card -->
                <Border x:Name="PinnedNoteCard" Background="{ThemeResource AppGlassColorBrush}" BorderBrush="{ThemeResource AppGlassBorderColorBrush}" BorderThickness="1" CornerRadius="14" Padding="12,10" Tapped="Header_Tapped">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                            <FontIcon Glyph="&#xE718;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#FFFFB300" VerticalAlignment="Center" />
                            <TextBlock x:Name="PinnedNoteTitleText" Text="Executive Focus" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" x:Name="PinnedNoteContentText" Text="1. Deep work block before 11:00&#x0a;2. Review roadmap" FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}" TextTrimming="CharacterEllipsis" MaxLines="2" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
