<UserControl
    x:Class="Daily_WinUI.Controls.TaskbarGlanceFlyoutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Width="340" MaxHeight="520"
            Background="{ThemeResource CapsuleBackgroundBrush}"
            BorderBrush="{ThemeResource CapsuleBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="16"
            Translation="0,0,24">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="*" />    <!-- Content Scroll -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Image.Source>
                        <BitmapImage UriSource="ms-appx:///Assets/OrbitIcon-Unplated-32.png" DecodePixelWidth="32" DecodePixelHeight="32"/>
                    </Image.Source>
                </Image>

                <TextBlock Grid.Column="1" Text="DayOne Glance" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource AppFgColorBrush}" VerticalAlignment="Center"/>

                <Button Grid.Column="2" x:Name="OpenFullAppButton" Click="OpenFullAppButton_Click"
                        Background="#2600E5FF" BorderBrush="#4D00E5FF" BorderThickness="1"
                        CornerRadius="12" Padding="8,4" ToolTipService.ToolTip="Open DayOne Window">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Full App" FontSize="11" FontWeight="SemiBold" Foreground="#FF00E5FF" VerticalAlignment="Center"/>
                        <FontIcon Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#FF00E5FF" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">
                    
                    <!-- 1. Weather & Vitals Quick Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Weather Quick Glance -->
                        <Border Grid.Column="0" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,4,0">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE9CA;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#FF00D09C" />
                                    <TextBlock x:Name="WeatherTempText" Text="--°C" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource AppFgColorBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="WeatherLocationText" Text="Local Weather" FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- Health Steps Glance -->
                        <Border Grid.Column="1" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10" Margin="4,0,0,0">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEB51;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#FFFF2D55" />
                                    <TextBlock x:Name="VitalsStepsText" Text="Vitals" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource AppFgColorBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="VitalsSubText" Text="Synced Today" FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 2. One-Click Hydration Logging -->
                    <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12">
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xEA3B;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#FF00A4EF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1" Text="Quick Hydration" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" x:Name="WaterStatusText" Text="" FontSize="11" Foreground="#FF00E5FF" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="LogWater250Btn" Click="LogWater250Btn_Click"
                                        Background="#2600A4EF" BorderBrush="#4D00A4EF" BorderThickness="1"
                                        CornerRadius="8" Padding="10,6" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#FF00A4EF" />
                                        <TextBlock Text="250 ml" FontSize="11" FontWeight="SemiBold" Foreground="#FF00A4EF"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="LogWater500Btn" Click="LogWater500Btn_Click"
                                        Background="#2600A4EF" BorderBrush="#4D00A4EF" BorderThickness="1"
                                        CornerRadius="8" Padding="10,6" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#FF00A4EF" />
                                        <TextBlock Text="500 ml" FontSize="11" FontWeight="SemiBold" Foreground="#FF00A4EF"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="LogSmokeBtn" Click="LogSmokeBtn_Click"
                                        Background="#26FF9500" BorderBrush="#4DFF9500" BorderThickness="1"
                                        CornerRadius="8" Padding="10,6" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#FFFF9500" />
                                        <TextBlock Text="1 Smoke" FontSize="11" FontWeight="SemiBold" Foreground="#FFFF9500"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 3. TagDoS Instant Scratchpad -->
                    <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE70B;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#FF00E5FF" VerticalAlignment="Center"/>
                                <TextBlock Text="Quick Note / TagDoS Scratchpad" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBox x:Name="QuickNoteInputBox" PlaceholderText="Write note or task: Cluster &amp; Item1/Item2..."
                                     FontSize="12" CornerRadius="6" AcceptsReturn="False" KeyDown="QuickNoteInputBox_KeyDown" />

                            <Grid>
                                <TextBlock x:Name="NoteSavedFeedbackText" Text="" FontSize="11" Foreground="#FF00D09C" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                <Button x:Name="SaveQuickNoteBtn" Click="SaveQuickNoteBtn_Click"
                                        Background="#3300E5FF" BorderBrush="#6600E5FF" BorderThickness="1"
                                        CornerRadius="6" Padding="10,4" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE74E;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#FF00E5FF"/>
                                        <TextBlock Text="Save" FontSize="11" FontWeight="SemiBold" Foreground="#FF00E5FF"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 4. Quick Hub Navigation Jumps -->
                    <Grid ColumnSpacing="6" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Click="NavJump_Click" Tag="1"
                                HorizontalAlignment="Stretch" Padding="4,8" CornerRadius="8" Background="#0FFFFFFF" BorderThickness="0" ToolTipService.ToolTip="Dashboard (Ctrl+1)">
                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                                <TextBlock Text="Dash" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="0" Grid.Column="1" Click="NavJump_Click" Tag="2"
                                HorizontalAlignment="Stretch" Padding="4,8" CornerRadius="8" Background="#0FFFFFFF" BorderThickness="0" ToolTipService.ToolTip="Finances (Ctrl+2)">
                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8C7;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                                <TextBlock Text="Money" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="0" Grid.Column="2" Click="NavJump_Click" Tag="3"
                                HorizontalAlignment="Stretch" Padding="4,8" CornerRadius="8" Background="#0FFFFFFF" BorderThickness="0" ToolTipService.ToolTip="TagDoS (Ctrl+3)">
                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE70B;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                                <TextBlock Text="TagDoS" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="0" Grid.Column="3" Click="NavJump_Click" Tag="8"
                                HorizontalAlignment="Stretch" Padding="4,8" CornerRadius="8" Background="#0FFFFFFF" BorderThickness="0" ToolTipService.ToolTip="Calendar (Ctrl+8)">
                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE787;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                                <TextBlock Text="Calendar" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="1" Grid.Column="0" Click="NavJump_Click" Tag="4"
                                HorizontalAlignment="Stretch" Padding="4,8" CornerRadius="8" Background="#0FFFFFFF" BorderThickness="0" ToolTipService.ToolTip="Health (Ctrl+4)">
                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xEB51;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                                <TextBlock Text="Health" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="1" Grid.Column="1" Click="NavJump_Click" Tag="5"
                                HorizontalAlignment="Stretch" Padding="4,8" CornerRadius="8" Background="#0FFFFFFF" BorderThickness="0" ToolTipService.ToolTip="Habits (Ctrl+5)">
                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xEA3B;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                                <TextBlock Text="Habits" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="1" Grid.Column="2" Click="NavJump_Click" Tag="6"
                                HorizontalAlignment="Stretch" Padding="4,8" CornerRadius="8" Background="#0FFFFFFF" BorderThickness="0" ToolTipService.ToolTip="Weather (Ctrl+6)">
                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE9CA;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                                <TextBlock Text="Weather" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="1" Grid.Column="3" Click="NavJump_Click" Tag="7"
                                HorizontalAlignment="Stretch" Padding="4,8" CornerRadius="8" Background="#0FFFFFFF" BorderThickness="0" ToolTipService.ToolTip="News (Ctrl+7)">
                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE958;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                                <TextBlock Text="News" FontSize="10" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Divider -->
                    <Rectangle Height="1" Fill="#1AFFFFFF" Margin="0,4" />

                    <!-- Exit App Button -->
                    <Button x:Name="ExitAppBtn" Click="ExitAppBtn_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                            <TextBlock Text="Exit DayOne" FontSize="11" Foreground="{ThemeResource AppFgMutedColorBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
