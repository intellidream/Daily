<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Daily_WinUI.Controls.CosmosWidgetControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="200" d:DesignWidth="400"
    Background="Transparent">

    <Grid Padding="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Section: Header & Location -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="12" Background="#2600E5FF" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE706;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#FF00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Cosmos • Cerul Nopții" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <Border Grid.Column="1" x:Name="QualityBadge" Background="#2600E5FF" BorderBrush="#4D00E5FF" BorderThickness="1" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                <TextBlock x:Name="QualityBadgeText" Text="Stargazing: --" FontSize="11" FontWeight="Bold" Foreground="#FF00E5FF" />
            </Border>
        </Grid>

        <!-- Middle Section: Stargazing Score & Moon Phase -->
        <Grid Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock x:Name="ScoreText" Text="--" FontSize="54" FontWeight="Bold" FontFamily="Segoe UI Variable Display" LineHeight="54" Foreground="{ThemeResource AppFgColorBrush}" />
                
                <Border BorderBrush="#22FFFFFF" BorderThickness="2,0,0,0" Padding="14,0,0,0" Margin="0,4,0,4">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="INDEX OBSERVATOR" FontSize="10" FontWeight="Bold" Opacity="0.6" CharacterSpacing="50" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                        <TextBlock x:Name="ConditionSummaryText" Text="Calculare efemeride..." FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AppFgColorBrush}" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Moon Phase Disc Glance -->
            <Border Grid.Column="1" Background="#15FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="16" Padding="12,8" VerticalAlignment="Center">
                <StackPanel Spacing="3" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE708;" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="#FFFFD166" HorizontalAlignment="Center" />
                    <TextBlock x:Name="MoonPhaseText" Text="Lună" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource AppFgColorBrush}" />
                    <TextBlock x:Name="MoonIllumText" Text="--%" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" Foreground="{ThemeResource AppFgMutedColorBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom Section: Visible Planets & Details -->
        <Grid Grid.Row="2" Margin="0,12,0,0" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE787;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#FF00E5FF" VerticalAlignment="Center" />
                <TextBlock x:Name="VisiblePlanetsText" Text="Planete vizibile: --" FontSize="12" Foreground="{ThemeResource AppFgMutedColorBrush}" TextTrimming="CharacterEllipsis" MaxWidth="260" VerticalAlignment="Center"/>
            </StackPanel>

            <Button Grid.Column="1" x:Name="OpenHubButton" Click="OpenHubButton_Click"
                    Background="Transparent" BorderThickness="0" Padding="4,2" CornerRadius="6"
                    ToolTipService.ToolTip="Deschide Observatorul Cosmos (Ctrl+9)">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Observator" FontSize="11" FontWeight="SemiBold" Foreground="#FF00E5FF" VerticalAlignment="Center"/>
                    <FontIcon Glyph="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#FF00E5FF" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Loading overlay -->
        <Grid x:Name="LoadingOverlay" Background="#20000000" Grid.RowSpan="3" Visibility="Collapsed">
            <ProgressRing IsActive="True" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
